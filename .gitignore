# Aethyme broker runtime state (per-repo). The configs — .aethyme/gates.toml
# and .aethyme/config.toml — are tracked; everything the broker writes at
# runtime is not.
.aethyme/broker.db*
.aethyme/logs/
.aethyme/locks/
.aethyme/run/
.aethyme/worktrees/
.aethyme/broker-action-required.md

# Local strategy/progress boards (personal working views, kept out of git)
docs/strategy.html
docs/strategy-*.html
docs/legacy.html

node_modules/
dist/
build/
coverage/
test-results/
playwright-report/
.playwright-mcp/
.DS_Store
.chau7/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
# Also match a `.venv` SYMLINK. Linked worktrees have no venv of their
# own, so the documented workaround is to symlink the main checkout's —
# and `.venv/` (trailing slash) matches directories only, so an unslashed
# rule is what actually keeps that symlink out of a commit.
.venv
*.egg-info/
.env
.env.*
*.log
packages/aethyme/.eval-cache/
packages/aethyme/rust/target/

# Profiling artifacts (dhat / mediawiki build dumps)
packages/aethyme/.profiling/
packages/aethyme/dhat-heap.json

# Claude Code per-project runtime files (settings.local.json, scheduled_tasks.lock, etc.)
.claude/
