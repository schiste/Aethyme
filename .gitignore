# Broker-owned runtime state is listed once in the managed block below.
# .aethyme/gates.toml and .aethyme/config.toml remain tracked.

# Local strategy/progress boards (personal working views, kept out of git)
docs/strategy.html
docs/strategy-*.html
docs/legacy.html

node_modules/
dist/
build/
coverage/
test-results/
playwright-report/
.playwright-mcp/
.DS_Store
.chau7/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
# Also match a `.venv` SYMLINK. Linked worktrees have no venv of their
# own, so the documented workaround is to symlink the main checkout's —
# and `.venv/` (trailing slash) matches directories only, so an unslashed
# rule is what actually keeps that symlink out of a commit.
.venv
*.egg-info/
.env
.env.*
*.log
packages/aethyme/.eval-cache/
packages/aethyme/rust/target/
# Session worktrees build here (CARGO_TARGET_DIR=<worktree>/target).
/target/

# Profiling artifacts (dhat / mediawiki build dumps)
packages/aethyme/.profiling/
packages/aethyme/dhat-heap.json

# Claude Code per-project runtime files (settings.local.json, hooks, etc.).
# The generated skills surface is tracked, mirroring .codex/skills/, so the
# Claude-facing agent policy is reviewable rather than invisible.
.claude/*
!.claude/skills/

# The pattern above contains a slash, so git anchors it to the repository
# root and it does not reach nested checkouts. Workspaces that Claude Code
# is opened in directly grow their own runtime directory.
packages/aethyme/.claude/

# This checkout does not commit its generated graph fragments. Keep this
# repository-specific choice outside the broker-managed block: other repos
# may commit .aethyme/graph as authoritative source.
.aethyme/graph/

# aethyme-broker:begin (managed block — do not edit inside)
.aethyme/broker.db*
.aethyme/logs/
.aethyme/locks/
.aethyme/reports/
.aethyme/run/
.aethyme/worktrees/
.aethyme/broker-action-required.md
.aethyme/broker-advisory.md
.aethyme/graph_store.redb
.aethyme/graph_store.redb.indexing
.aethyme/generated/experience-status.json
.aethyme/generated/experience-status.md
.aethyme/generated/experience-telemetry.jsonl
.aethyme/reviews/
.aethyme/worktree-sizes.json
.aethyme/gc-journal.json
.aethyme/gc.lock
# aethyme-broker:end

# TypeScript incremental build output
*.tsbuildinfo
