# Aethyme broker runtime state (per-repo). The configs — .aethyme/gates.toml
# and .aethyme/config.toml — are tracked; everything the broker writes at
# runtime is not.
.aethyme/broker.db*
.aethyme/logs/
.aethyme/run/
.aethyme/worktrees/
.aethyme/broker-action-required.md

node_modules/
dist/
build/
coverage/
test-results/
playwright-report/
.playwright-mcp/
.DS_Store
.chau7/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
*.egg-info/
.env
.env.*
*.log
packages/aethyme-eval-ui/server/evals.db
packages/aethyme-eval-ui/server/evals.db-shm
packages/aethyme-eval-ui/server/evals.db-wal
packages/aethyme-eval-ui/evals.db
packages/aethyme-eval-ui/evals.db-shm
packages/aethyme-eval-ui/evals.db-wal
packages/aethyme/.eval-cache/
packages/aethyme/rust/target/

# Profiling artifacts (dhat / mediawiki build dumps)
packages/aethyme/.profiling/
packages/aethyme/dhat-heap.json

# Claude Code per-project runtime files (settings.local.json, scheduled_tasks.lock, etc.)
.claude/
