{
  "name": "@aeptus/repograph",
  "version": "0.1.0",
  "private": true,
  "description": "Graph-based code indexing for Python and TypeScript",
  "scripts": {
    "dev:api": "bash scripts/start-api.sh",
    "dev:worker": "bash scripts/start-worker.sh",
    "index": "python -m src.indexer.cli",
    "test": "pytest tests/ -v",
    "test:coverage": "pytest tests/ --cov=src --cov-report=html",
    "lint": "ruff check src/",
    "type-check": "pyright src/",
    "db:migrate": "bash scripts/migrate.sh",
    "db:reset": "bash scripts/reset-db.sh",
    "docker:build": "docker-compose -f ops/docker-compose.yml build",
    "docker:up": "docker-compose -f ops/docker-compose.yml up",
    "docker:down": "docker-compose -f ops/docker-compose.yml down"
  },
  "dependencies": {
    "react": "^19.2.0",
    "cytoscape": "^3.28.0",
    "cytoscape-cose-bilkent": "^4.1.0",
    "@types/cytoscape": "^3.19.0"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "typescript": "^5.3.0",
    "vite": "^7.1.9"
  }
}