{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -c 'cat inputs.json'","aggregated_output":"{\n  \"accumulator\": \"sha256:7f42edab9824c92824c81d053a9db352499cbe22b751ccdde365247cbb27b7fe\",\n  \"baseline\": \"sha256:d77bc79be411944893cf4353639f95d6e6eb8dedd9c7139f80a99112385070d2\",\n  \"files\": [\n    {\n      \"path\": \"page.html\",\n      \"snapshot\": \"sha256:5aa96cfbce53b7bd8b22cfcbe6bc8b0d761f68875f25ba04f031f8ab52f50e23\",\n      \"utf8\": \"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head><meta charset=\\\"utf-8\\\"><title>Public directory</title></head>\\n<body>\\n<nav><a id=\\\"navigation\\\" href=\\\"#results\\\">Results</a></nav>\\n<aside id=\\\"sidebar\\\"><h2>Quick tools</h2></aside>\\n<main id=\\\"main\\\">\\n  <section id=\\\"search-panel\\\">\\n    <h1 id=\\\"heading\\\">Directory</h1>\\n    <form id=\\\"search\\\">\\n      <label for=\\\"query\\\">Find a place</label>\\n      <input id=\\\"query\\\" aria-label=\\\"Search places\\\" autocomplete=\\\"off\\\">\\n      <button id=\\\"search-button\\\" type=\\\"submit\\\">Search</button>\\n    </form>\\n  </section>\\n  <section id=\\\"results\\\" tabindex=\\\"-1\\\" aria-live=\\\"polite\\\"></section>\\n  <p id=\\\"message\\\"></p>\\n</main>\\n<script>\\nconst timeoutMs = 1500;\\nconst entries = [\\\"Lake\\\", \\\"Forest\\\", \\\"Museum\\\"];\\nfunction hasConsent() { return false; }\\nfunction telemetry(query) { if (hasConsent()) fetch(\\\"https://telemetry.invalid/event\\\", {method:\\\"POST\\\",body:JSON.stringify({event:\\\"search\\\",query})}); }\\nfunction resultLabel(value) { return value; }\\nfunction runSearch() {\\n  const query = document.getElementById(\\\"query\\\").value;\\n  const found = entries.filter(value => value.toLowerCase().includes(query.toLowerCase()));\\n  document.getElementById(\\\"results\\\").textContent = found.map(resultLabel).join(\\\", \\\");\\n  document.getElementById(\\\"message\\\").textContent = \\\"Search complete\\\";\\n  telemetry(query);\\n}\\ndocument.getElementById(\\\"search\\\").addEventListener(\\\"submit\\\", event => {\\n  event.preventDefault();\\n  runSearch();\\n});\\n</script>\\n</body>\\n</html>\\n\"\n    },\n    {\n      \"path\": \"page.html\",\n      \"snapshot\": \"sha256:7b956f060f165a7afd363f54410ac92b5d83ef2b91f2900f75cedbf9bfbb93c3\",\n      \"utf8\": \"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head><meta charset=\\\"utf-8\\\"><title>Public directory</title></head>\\n<body>\\n<nav><a id=\\\"navigation\\\" href=\\\"#results\\\">Results</a></nav>\\n<aside id=\\\"sidebar\\\"><h2>Quick tools</h2></aside>\\n<main id=\\\"main\\\">\\n  <section id=\\\"search-panel\\\">\\n    <h1 id=\\\"heading\\\">Directory</h1>\\n    <form id=\\\"search\\\">\\n      <label for=\\\"query\\\">Find a place</label>\\n      <input id=\\\"query\\\" aria-label=\\\"Search places\\\" autocomplete=\\\"off\\\">\\n      <button id=\\\"search-button\\\" type=\\\"submit\\\">Search</button>\\n    </form>\\n  </section>\\n  <section id=\\\"results\\\" tabindex=\\\"-1\\\" aria-live=\\\"polite\\\"></section>\\n  <label><input id=\\\"consent\\\" type=\\\"checkbox\\\">Allow anonymous search events</label>\\n  <p id=\\\"message\\\"></p>\\n</main>\\n<script>\\nconst timeoutMs = 1500;\\nconst entries = [\\\"Lake\\\", \\\"Forest\\\", \\\"Museum\\\"];\\nfunction hasConsent() { return document.getElementById(\\\"consent\\\").checked; }\\nfunction telemetry(query) { }\\nfunction resultLabel(value) { return value; }\\nfunction runSearch() {\\n  const query = document.getElementById(\\\"query\\\").value;\\n  const found = entries.filter(value => value.toLowerCase().includes(query.toLowerCase()));\\n  document.getElementById(\\\"results\\\").textContent = found.map(resultLabel).join(\\\", \\\");\\n  document.getElementById(\\\"message\\\").textContent = \\\"Search complete\\\";\\n  telemetry(query);\\n}\\ndocument.getElementById(\\\"search\\\").addEventListener(\\\"submit\\\", event => {\\n  event.preventDefault();\\n  runSearch();\\n});\\n</script>\\n</body>\\n</html>\\n\"\n    },\n    {\n      \"path\": \"page.html\",\n      \"snapshot\": \"sha256:7f42edab9824c92824c81d053a9db352499cbe22b751ccdde365247cbb27b7fe\",\n      \"utf8\": \"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head><meta charset=\\\"utf-8\\\"><title>Public directory</title></head>\\n<body>\\n<nav><a id=\\\"navigation\\\" href=\\\"#results\\\">Results</a></nav>\\n<aside id=\\\"sidebar\\\"><h2>Quick tools</h2></aside>\\n<main id=\\\"main\\\">\\n  <section id=\\\"search-panel\\\">\\n    <h1 id=\\\"heading\\\">Directory</h1>\\n    <form id=\\\"search\\\">\\n      <label for=\\\"query\\\">Find a place</label>\\n      <input id=\\\"query\\\" aria-label=\\\"Search places\\\" autocomplete=\\\"off\\\">\\n      <button id=\\\"search-button\\\" type=\\\"submit\\\">Search</button>\\n    </form>\\n  </section>\\n  <section id=\\\"results\\\" tabindex=\\\"-1\\\" aria-live=\\\"polite\\\"></section>\\n  <label><input id=\\\"consent\\\" type=\\\"checkbox\\\">Allow anonymous search events</label>\\n  <p id=\\\"message\\\"></p>\\n</main>\\n<script>\\nconst timeoutMs = 1500;\\nconst entries = [\\\"Lake\\\", \\\"Forest\\\", \\\"Museum\\\"];\\nfunction hasConsent() { return document.getElementById(\\\"consent\\\").checked; }\\nfunction telemetry(query) { if (hasConsent()) fetch(\\\"https://telemetry.invalid/event\\\", {method:\\\"POST\\\",body:JSON.stringify({event:\\\"search\\\",query})}); }\\nfunction resultLabel(value) { return value; }\\nfunction runSearch() {\\n  const query = document.getElementById(\\\"query\\\").value;\\n  const found = entries.filter(value => value.toLowerCase().includes(query.toLowerCase()));\\n  document.getElementById(\\\"results\\\").textContent = found.map(resultLabel).join(\\\", \\\");\\n  document.getElementById(\\\"message\\\").textContent = \\\"Search complete\\\";\\n  telemetry(query);\\n}\\ndocument.getElementById(\\\"search\\\").addEventListener(\\\"submit\\\", event => {\\n  event.preventDefault();\\n  runSearch();\\n});\\n</script>\\n</body>\\n</html>\\n\"\n    },\n    {\n      \"path\": \"page.html\",\n      \"snapshot\": \"sha256:d77bc79be411944893cf4353639f95d6e6eb8dedd9c7139f80a99112385070d2\",\n      \"utf8\": \"<!doctype html>\\n<html lang=\\\"en\\\">\\n<head><meta charset=\\\"utf-8\\\"><title>Public directory</title></head>\\n<body>\\n<nav><a id=\\\"navigation\\\" href=\\\"#results\\\">Results</a></nav>\\n<aside id=\\\"sidebar\\\"><h2>Quick tools</h2></aside>\\n<main id=\\\"main\\\">\\n  <section id=\\\"search-panel\\\">\\n    <h1 id=\\\"heading\\\">Directory</h1>\\n    <form id=\\\"search\\\">\\n      <label for=\\\"query\\\">Find a place</label>\\n      <input id=\\\"query\\\" aria-label=\\\"Search places\\\" autocomplete=\\\"off\\\">\\n      <button id=\\\"search-button\\\" type=\\\"submit\\\">Search</button>\\n    </form>\\n  </section>\\n  <section id=\\\"results\\\" tabindex=\\\"-1\\\" aria-live=\\\"polite\\\"></section>\\n  <p id=\\\"message\\\"></p>\\n</main>\\n<script>\\nconst timeoutMs = 1500;\\nconst entries = [\\\"Lake\\\", \\\"Forest\\\", \\\"Museum\\\"];\\nfunction hasConsent() { return false; }\\nfunction telemetry(query) { }\\nfunction resultLabel(value) { return value; }\\nfunction runSearch() {\\n  const query = document.getElementById(\\\"query\\\").value;\\n  const found = entries.filter(value => value.toLowerCase().includes(query.toLowerCase()));\\n  document.getElementById(\\\"results\\\").textContent = found.map(resultLabel).join(\\\", \\\");\\n  document.getElementById(\\\"message\\\").textContent = \\\"Search complete\\\";\\n  telemetry(query);\\n}\\ndocument.getElementById(\\\"search\\\").addEventListener(\\\"submit\\\", event => {\\n  event.preventDefault();\\n  runSearch();\\n});\\n</script>\\n</body>\\n</html>\\n\"\n    }\n  ],\n  \"members\": [\n    {\n      \"base\": \"sha256:d77bc79be411944893cf4353639f95d6e6eb8dedd9c7139f80a99112385070d2\",\n      \"id\": \"c1\",\n      \"result\": \"sha256:5aa96cfbce53b7bd8b22cfcbe6bc8b0d761f68875f25ba04f031f8ab52f50e23\"\n    },\n    {\n      \"base\": \"sha256:d77bc79be411944893cf4353639f95d6e6eb8dedd9c7139f80a99112385070d2\",\n      \"id\": \"c2\",\n      \"result\": \"sha256:7b956f060f165a7afd363f54410ac92b5d83ef2b91f2900f75cedbf9bfbb93c3\"\n    },\n    {\n      \"base\": \"sha256:d77bc79be411944893cf4353639f95d6e6eb8dedd9c7139f80a99112385070d2\",\n      \"id\": \"c1\",\n      \"result\": \"sha256:5aa96cfbce53b7bd8b22cfcbe6bc8b0d761f68875f25ba04f031f8ab52f50e23\"\n    },\n    {\n      \"base\": \"sha256:d77bc79be411944893cf4353639f95d6e6eb8dedd9c7139f80a99112385070d2\",\n      \"id\": \"c2\",\n      \"result\": \"sha256:7b956f060f165a7afd363f54410ac92b5d83ef2b91f2900f75cedbf9bfbb93c3\"\n    }\n  ],\n  \"scope\": [\n    \"page.html\"\n  ]\n}","exit_code":0,"status":"completed"}}
