{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FX17 once-final model attempt record",
  "type": "object",
  "required": ["row_id", "group", "task", "arm", "attempt", "status",
    "model", "reasoning_effort", "configured_max_wall_seconds",
    "configured_max_tool_calls", "effective_tools_available",
    "configured_max_tokens", "automatic_retries",
    "provider_request_count_observed", "provider_retry_count_observed",
    "tool_calls_observed", "provider_usage", "provider_total_tokens",
    "invoiced_cost_usd", "refusal", "candidate_sha256"],
  "properties": {
    "row_id": {"type": "string"},
    "group": {"enum": ["original-core", "supplemental-misleading"]},
    "task": {"enum": ["SX01-alias", "SX02-limit"]},
    "arm": {"enum": ["correct", "absent", "misleading"]},
    "attempt": {"const": 1},
    "status": {"enum": ["not_started", "running", "response_received",
      "refusal", "invalid_response", "tool_access_violation",
      "cli_or_provider_error", "timed_out", "missing_response", "runner_error"]},
    "model": {"const": "gpt-6-luna"},
    "reasoning_effort": {"const": "medium"},
    "configured_max_wall_seconds": {"const": 180},
    "configured_max_tool_calls": {"const": 2},
    "effective_tools_available": {"const": 0},
    "configured_max_tokens": {"const": 32768},
    "automatic_retries": {"const": 0},
    "provider_request_count_observed": {"type": ["integer", "null"], "minimum": 0},
    "provider_retry_count_observed": {"type": ["integer", "null"], "minimum": 0},
    "tool_calls_observed": {"type": ["integer", "null"], "minimum": 0},
    "provider_usage": {"type": ["object", "null"]},
    "provider_total_tokens": {"type": ["integer", "null"], "minimum": 0},
    "usage_exceeded_token_limit": {"type": ["boolean", "null"]},
    "invoiced_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "refusal": {"type": ["string", "null"]},
    "candidate_sha256": {"type": ["string", "null"]},
    "candidate_utf8_bytes": {"type": ["integer", "null"], "minimum": 0},
    "wall_seconds": {"type": ["number", "null"], "minimum": 0},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"}
  },
  "additionalProperties": true
}
