{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FX17 once-final model attempt record",
  "type": "object",
  "required": [
    "row_id", "group", "task", "arm", "attempt", "status", "model",
    "reasoning_effort", "configured_max_wall_seconds",
    "configured_max_tool_calls", "effective_tools_available",
    "nominal_output_token_threshold", "output_token_limit_enforcement",
    "provider_retry_behavior", "automatic_retries", "codex_version",
    "codex_binary_sha256", "provider_request_count_observed",
    "provider_retry_count_observed", "tool_calls_observed", "provider_usage",
    "provider_output_tokens", "provider_total_tokens",
    "output_tokens_exceeded_nominal_threshold", "invoiced_cost_usd",
    "refusal", "candidate_sha256", "started_at", "finished_at"
  ],
  "properties": {
    "row_id": {"type": "string"},
    "group": {"enum": ["original-core", "supplemental-misleading"]},
    "task": {"enum": ["SX01-alias", "SX02-limit"]},
    "arm": {"enum": ["correct", "absent", "misleading"]},
    "attempt": {"const": 1},
    "status": {"enum": [
      "not_started", "running", "response_received", "refusal",
      "invalid_response", "tool_access_violation", "cli_or_provider_error",
      "timed_out", "output_limit_exceeded", "stream_drain_timeout",
      "missing_response", "runner_error"
    ]},
    "model": {"const": "gpt-6-luna"},
    "reasoning_effort": {"const": "medium"},
    "configured_max_wall_seconds": {"const": 180},
    "configured_max_tool_calls": {"const": 2},
    "effective_tools_available": {"const": 0},
    "nominal_output_token_threshold": {"const": 32768},
    "output_token_limit_enforcement": {"const": "unverified"},
    "provider_retry_behavior": {"const": "unknown"},
    "automatic_retries": {"const": 0},
    "codex_version": {"const": "0.162.1"},
    "codex_binary_sha256": {
      "const": "74c6a6d263f40d65f99c27a815275f5b4ed0bcc2baecc396b4cf3255498bdfc0"
    },
    "provider_request_count_observed": {"type": ["integer", "null"], "minimum": 0},
    "provider_retry_count_observed": {"type": ["integer", "null"], "minimum": 0},
    "tool_calls_observed": {"type": ["integer", "null"], "minimum": 0},
    "provider_usage": {"type": ["object", "null"]},
    "provider_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "provider_output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "provider_total_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens_exceeded_nominal_threshold": {"type": ["boolean", "null"]},
    "stdout_capture_limit_bytes": {"const": 8388608},
    "stderr_capture_limit_bytes": {"const": 2097152},
    "response_file_limit_bytes": {"const": 4194304},
    "stdout_bytes_captured": {"type": ["integer", "null"], "minimum": 0},
    "stdout_sha256": {"type": ["string", "null"]},
    "stderr_bytes_captured": {"type": ["integer", "null"], "minimum": 0},
    "stderr_sha256": {"type": ["string", "null"]},
    "response_file_size_bytes_observed": {"type": ["integer", "null"], "minimum": 0},
    "response_file_sha256": {"type": ["string", "null"]},
    "overflow_streams": {
      "type": "array",
      "items": {"enum": ["stdout", "stderr", "response_file"]},
      "uniqueItems": true
    },
    "process_group_killed": {"type": ["boolean", "null"]},
    "process_reaped": {"type": ["boolean", "null"]},
    "invoiced_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "refusal": {"type": ["string", "null"]},
    "candidate_sha256": {"type": ["string", "null"]},
    "candidate_utf8_bytes": {"type": ["integer", "null"], "minimum": 0},
    "wall_seconds": {"type": ["number", "null"], "minimum": 0},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"}
  },
  "additionalProperties": true
}
