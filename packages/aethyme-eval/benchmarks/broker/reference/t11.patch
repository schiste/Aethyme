+import unittest
+from shoplib.models import LineItem, Order
+from shoplib.reports import top_skus
+
+
+class TopSkusTest(unittest.TestCase):
+    def test_top(self):
+        orders = [Order("O1", "C1", [LineItem("MUG-001", 3, 1), LineItem("TEA-010", 4, 1),
+                                     LineItem("BAG-100", 3, 1)], status="placed")]
+        self.assertEqual(top_skus(orders, 2), [("TEA-010", 4), ("BAG-100", 3)])
