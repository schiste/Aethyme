@@ -3,12 +3,20 @@
 from shoplib.errors import ValidationError
 
 
-def format_price(cents, currency="USD"):
-    """Format an integer amount of cents, e.g. 123456 -> '1234.56 USD'."""
+SYMBOLS = {"USD": "$", "EUR": "\u20ac", "GBP": "\u00a3"}
+
+
+def format_price(cents, currency="USD", symbol=False):
+    """Format an integer amount of cents, e.g. 123456 -> '1234.56 USD'.
+
+    With symbol=True a known currency is shown as a prefix symbol: '$1234.56'.
+    """
     if not isinstance(cents, int) or isinstance(cents, bool):
         raise TypeError("cents must be an int")
     sign = "-" if cents < 0 else ""
     whole, frac = divmod(abs(cents), 100)
+    if symbol and currency in SYMBOLS:
+        return f"{sign}{SYMBOLS[currency]}{whole}.{frac:02d}"
     return f"{sign}{whole}.{frac:02d} {currency}"
 
 
diff --git a/tests/test_money_symbol.py b/tests/test_money_symbol.py
