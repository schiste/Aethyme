+import unittest
+from shoplib.text import slugify
+
+
+class SlugifyUnicodeTest(unittest.TestCase):
+    def test_fold(self):
+        self.assertEqual(slugify("Cr\u00e8me Br\u00fbl\u00e9e"), "creme-brulee")
+        self.assertEqual(slugify("\u00c7a va? 100%"), "ca-va-100")
