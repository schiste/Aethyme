diff --git a/shoplib/exporters/tsv_export.py b/shoplib/exporters/tsv_export.py
new file mode 100644
index 0000000..9d53065
--- /dev/null
+++ b/shoplib/exporters/tsv_export.py
@@ -0,0 +1,7 @@
+def export_orders_tsv(orders):
+    lines = ["\t".join(["order_id", "customer_id", "sku", "qty", "unit_price_cents"])]
+    for order in orders:
+        for item in order.items:
+            lines.append("\t".join(str(v) for v in (order.id, order.customer_id, item.sku, item.qty,
+                                                     item.unit_price_cents)))
+    return "\n".join(lines) + "\n"
