+import unittest
+from shoplib import registry
+from shoplib.models import LineItem, Order
+
+
+class TsvTest(unittest.TestCase):
+    def test_tsv(self):
+        text = registry.exporter("tsv")([Order("O1", "C1", [LineItem("MUG-001", 2, 1299)])])
+        self.assertEqual(text, "order_id\tcustomer_id\tsku\tqty\tunit_price_cents\nO1\tC1\tMUG-001\t2\t1299\n")
