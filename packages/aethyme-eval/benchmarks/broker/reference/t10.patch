+import unittest
+from shoplib.customers import loyalty_tier
+from shoplib.models import LineItem, Order
+
+
+class LoyaltyTest(unittest.TestCase):
+    def test_tiers(self):
+        order = Order("O1", "C1", [LineItem("MUG-001", 1, 20000)], region="XX", status="placed")
+        self.assertEqual(loyalty_tier("C1", []), "bronze")
+        self.assertEqual(loyalty_tier("C1", [order]), "silver")
