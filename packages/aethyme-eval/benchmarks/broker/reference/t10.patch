+def loyalty_tier(customer_id, orders):
+    spend = sum(pricing.total(o) for o in orders if o.customer_id == customer_id and o.status == "placed")
+    if spend >= 50000:
+        return "gold"
+    if spend >= 20000:
+        return "silver"
+    return "bronze"
