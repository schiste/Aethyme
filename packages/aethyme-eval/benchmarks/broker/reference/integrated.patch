--- /dev/null
+++ b/shoplib/subscriptions.py
@@ -0,0 +1,25 @@
+"""Recurring orders."""
+
+from dataclasses import dataclass
+
+from shoplib.models import LineItem
+
+
+@dataclass
+class Subscription:
+    customer_id: str
+    sku: str
+    qty: int
+    interval_days: int
+
+
+class SubscriptionService:
+    def __init__(self, catalog, inventory):
+        self.catalog = catalog
+        self.inventory = inventory
+
+    def renew(self, subscription):
+        """Hold stock for one delivery and return its line item."""
+        product = self.catalog.get(subscription.sku)
+        self.inventory.reserve_stock(subscription.sku, subscription.qty)
+        return LineItem(subscription.sku, subscription.qty, product.price_cents)
