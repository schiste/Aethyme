{
  "name": "@aeptus/aethyme",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic repository indexing and code intelligence tooling",
  "scripts": {
    "dev:api": "bash scripts/start-api.sh",
    "index": "python -m src.indexer.cli",
    "test": "pytest tests/ -v",
    "test:coverage": "pytest tests/ --cov=src --cov-report=html",
    "lint": "ruff check src/",
    "type-check": "pyright src/",
    "db:migrate": "bash scripts/migrate.sh",
    "docker:build": "docker-compose -f ops/docker-compose.yml build",
    "docker:up": "docker-compose -f ops/docker-compose.yml up",
    "docker:down": "docker-compose -f ops/docker-compose.yml down"
  }
}
