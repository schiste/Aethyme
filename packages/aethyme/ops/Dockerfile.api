# syntax=docker/dockerfile:1.19

# Builder stage: Install dependencies with build tools
FROM python:3.11-slim AS builder

WORKDIR /app

# Install system dependencies needed for building Python packages
RUN <<EOF
apt-get update
apt-get install -y \
  gcc \
  g++ \
  git
rm -rf /var/lib/apt/lists/*
EOF

# Copy only dependency files first for better layer caching
COPY --link pyproject.toml .

# Install dependencies with cache mount for pip
# Install to /opt/venv to copy to runtime stage
RUN --mount=type=cache,target=/root/.cache/pip <<EOF
python -m venv /opt/venv
/opt/venv/bin/pip install --upgrade pip setuptools wheel
/opt/venv/bin/pip install gunicorn
EOF

# Copy source code now (required for editable install)
COPY --link src/ src/

# Now install the package in editable mode with all dependencies
RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/venv/bin/pip install -e .

# Runtime stage: Minimal image for production
FROM python:3.11-slim AS runtime

# Build metadata arguments
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
ARG CI_COMMIT_SHA
ARG CI_PIPELINE_ID

# OCI Image Labels
LABEL org.opencontainers.image.title="Aethyme API" \
      org.opencontainers.image.description="Python API service for Aethyme - Production-optimized with Gunicorn" \
      org.opencontainers.image.vendor="Aeptus" \
      org.opencontainers.image.source="https://github.com/Aeptus/mockup" \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.revision=$VCS_REF \
      org.opencontainers.image.version=$VERSION \
      build.ci.commit=$CI_COMMIT_SHA \
      build.ci.pipeline=$CI_PIPELINE_ID

WORKDIR /app

# Install only runtime system dependencies
RUN <<EOF
apt-get update
apt-get install -y \
  postgresql-client \
  curl
rm -rf /var/lib/apt/lists/*
EOF

# Create non-root system user early
RUN useradd -r -u 1000 -s /usr/sbin/nologin aethyme

# Copy virtual environment from builder
COPY --link --from=builder /opt/venv /opt/venv

# Copy application code with correct ownership to avoid recursive chown
COPY --link --chown=1000:1000 src/ src/
COPY --link --chown=1000:1000 pyproject.toml .
COPY --link --chown=1000:1000 migrations/ migrations/
COPY --link --chown=1000:1000 scripts/ scripts/

# Make scripts executable
RUN chmod +x scripts/*.sh

# Ensure venv binaries are in PATH
ENV PATH="/opt/venv/bin:$PATH"

USER aethyme

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8001/health || exit 1

# Expose API port
EXPOSE 8001

# Default command
CMD ["bash", "scripts/start-api.sh"]
