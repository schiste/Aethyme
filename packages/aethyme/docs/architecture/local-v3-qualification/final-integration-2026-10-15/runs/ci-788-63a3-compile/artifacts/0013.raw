{"sha":"63a3aa3e533ba466f02f1deabd36b9d3feb88985","node_id":"C_kwDOQ07FcNoAKDYzYTNhYTNlNTMzYmE0NjZmMDJmMWRlYWJkMzZiOWQzZmViODg5ODU","commit":{"author":{"name":"Christophe Henner","email":"christophehenner@gmail.com","date":"2026-10-16T00:34:27Z"},"committer":{"name":"Christophe Henner","email":"christophehenner@gmail.com","date":"2026-10-16T00:34:27Z"},"message":"feat(contracts): add experimental local identity revisions\n\nProblem\nLocal project mappings and contribution rationale changes need immutable, bounded records without granting workflow authority.\n\nDecision\nAdd experimental project descriptors, stable FileIds with explicit lineage operations, and content-addressed contribution revisions that bind exact source snapshots and optional brief objects.\n\nRationale\nThe contracts keep local ProjectKey storage separate from logical project identity, preserve uncertainty for inferred renames, and make brief-only changes produce a new revision.\n\nValidation\nRan rustfmt and git diff --check. Cargo and native tests were not run under the active runtime gate.","tree":{"sha":"e593dc9bfe6ac2113d3fb23d21744fa670199774","url":"https://api.github.com/repos/schiste/Aethyme/git/trees/e593dc9bfe6ac2113d3fb23d21744fa670199774"},"url":"https://api.github.com/repos/schiste/Aethyme/git/commits/63a3aa3e533ba466f02f1deabd36b9d3feb88985","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/schiste/Aethyme/commits/63a3aa3e533ba466f02f1deabd36b9d3feb88985","html_url":"https://github.com/schiste/Aethyme/commit/63a3aa3e533ba466f02f1deabd36b9d3feb88985","comments_url":"https://api.github.com/repos/schiste/Aethyme/commits/63a3aa3e533ba466f02f1deabd36b9d3feb88985/comments","author":{"login":"schiste","id":15890754,"node_id":"MDQ6VXNlcjE1ODkwNzU0","avatar_url":"https://avatars.githubusercontent.com/u/15890754?v=4","gravatar_id":"","url":"https://api.github.com/users/schiste","html_url":"https://github.com/schiste","followers_url":"https://api.github.com/users/schiste/followers","following_url":"https://api.github.com/users/schiste/following{/other_user}","gists_url":"https://api.github.com/users/schiste/gists{/gist_id}","starred_url":"https://api.github.com/users/schiste/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/schiste/subscriptions","organizations_url":"https://api.github.com/users/schiste/orgs","repos_url":"https://api.github.com/users/schiste/repos","events_url":"https://api.github.com/users/schiste/events{/privacy}","received_events_url":"https://api.github.com/users/schiste/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"schiste","id":15890754,"node_id":"MDQ6VXNlcjE1ODkwNzU0","avatar_url":"https://avatars.githubusercontent.com/u/15890754?v=4","gravatar_id":"","url":"https://api.github.com/users/schiste","html_url":"https://github.com/schiste","followers_url":"https://api.github.com/users/schiste/followers","following_url":"https://api.github.com/users/schiste/following{/other_user}","gists_url":"https://api.github.com/users/schiste/gists{/gist_id}","starred_url":"https://api.github.com/users/schiste/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/schiste/subscriptions","organizations_url":"https://api.github.com/users/schiste/orgs","repos_url":"https://api.github.com/users/schiste/repos","events_url":"https://api.github.com/users/schiste/events{/privacy}","received_events_url":"https://api.github.com/users/schiste/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"025103777c16607639073cbf9024d2ad0c39f72d","url":"https://api.github.com/repos/schiste/Aethyme/commits/025103777c16607639073cbf9024d2ad0c39f72d","html_url":"https://github.com/schiste/Aethyme/commit/025103777c16607639073cbf9024d2ad0c39f72d"}],"stats":{"total":1870,"additions":1870,"deletions":0},"files":[{"sha":"10d71b082103855e24371452f6702de12235d07e","filename":"packages/aethyme/rust/crates/aethyme-contracts/fixtures/experimental-v0/project_identity.json","status":"added","additions":23,"deletions":0,"changes":23,"blob_url":"https://github.com/schiste/Aethyme/blob/63a3aa3e533ba466f02f1deabd36b9d3feb88985/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ffixtures%2Fexperimental-v0%2Fproject_identity.json","raw_url":"https://github.com/schiste/Aethyme/raw/63a3aa3e533ba466f02f1deabd36b9d3feb88985/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ffixtures%2Fexperimental-v0%2Fproject_identity.json","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ffixtures%2Fexperimental-v0%2Fproject_identity.json?ref=63a3aa3e533ba466f02f1deabd36b9d3feb88985","patch":"@@ -0,0 +1,23 @@\n+{\n+  \"reference\": \"Independent Python standard-library oracle; raw-byte SHA-256 and canonical ASCII-key JSON.\",\n+  \"descriptor\": {\n+    \"anchor_commit\": \"1111111111111111111111111111111111111111\",\n+    \"anchor_snapshot\": \"sha256:2939b109e979106efe56e4132e534918d03524dd8391186d54e237cd871a43e3\",\n+    \"acceptance_target\": \"unbound\",\n+    \"files\": [\n+      {\n+        \"content_sha256\": \"536e506bb90914c243a12b397b9a998f85ae2cbd9ba02dfd03a9e155ca5ca0f4\",\n+        \"file_id\": \"file:sha256:fd0ee6dc0f6b45715b845b427f345007bd60c53f1b75196d94be53bec48ed33e\",\n+        \"mode\": \"100644\",\n+        \"path_hex\": \"7372632f6c69622e7273\"\n+      }\n+    ],\n+    \"policy_location\": \".aethyme/config.toml\",\n+    \"project_id\": \"proj:aaaaaaaaaaaaaaaaaaaaaaaaaa\",\n+    \"schema\": \"aethyme.project-descriptor/experimental-v0\",\n+    \"source_binding\": \"git-commit:1111111111111111111111111111111111111111\",\n+    \"visibility_boundary\": \"local\"\n+  },\n+  \"content_hex\": \"666e206d61696e2829207b7d0a\",\n+  \"descriptor_record_id\": \"sha256:fd653fa8879751de70df354eae024d77e9e0179e70adb59567eade4d6c6bbbb7\"\n+}"},{"sha":"ceaf91e9e484774abb317d4c29f77901930e1921","filename":"packages/aethyme/rust/crates/aethyme-contracts/src/experimental_v0/contribution_revision.rs","status":"added","additions":457,"deletions":0,"changes":457,"blob_url":"https://github.com/schiste/Aethyme/blob/63a3aa3e533ba466f02f1deabd36b9d3feb88985/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fcontribution_revision.rs","raw_url":"https://github.com/schiste/Aethyme/raw/63a3aa3e533ba466f02f1deabd36b9d3feb88985/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fcontribution_revision.rs","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fcontribution_revision.rs?ref=63a3aa3e533ba466f02f1deabd36b9d3feb88985","patch":"@@ -0,0 +1,457 @@\n+//! Immutable, experimental contribution revisions (plan §5.2–5.4, D10).\n+//!\n+//! A revision is a content-addressed value over one exact project binding,\n+//! contribution lineage, source transition, and optional decision brief.\n+//! Replacing only the brief therefore creates a different revision ID. The\n+//! record carries no authority claim; project/file mapping is advisory.\n+\n+use data_encoding::HEXLOWER;\n+\n+use super::canonical_json::{self, Object, Value};\n+use super::project_identity::{FileId, IdentityRelation, ProjectId};\n+use super::record::{FieldKind, FieldSpec, Record, RecordError, RecordId, RecordSchema};\n+use super::source_snapshot::{EntryKind, SourceEntry, SourceSnapshot, SourceSnapshotId};\n+\n+pub const CONTRIBUTION_REVISION_SCHEMA_NAME: &str = \"aethyme.contribution-revision/experimental-v0\";\n+pub const MAX_CONTRIBUTION_REVISION_BYTES: usize = 4 * 1024 * 1024;\n+pub const MAX_REVISION_CHANGES: usize = 200_000;\n+\n+const fn field(name: &'static str, required: bool, kind: FieldKind) -> FieldSpec {\n+    FieldSpec {\n+        name,\n+        required,\n+        kind,\n+        capability: None,\n+    }\n+}\n+\n+/// Exact immutable payload for one revision of a logical contribution.\n+pub static CONTRIBUTION_REVISION_SCHEMA: RecordSchema = RecordSchema {\n+    name: CONTRIBUTION_REVISION_SCHEMA_NAME,\n+    fields: &[\n+        field(\"project_id\", true, FieldKind::String),\n+        field(\"contribution_id\", true, FieldKind::String),\n+        field(\"base\", true, FieldKind::String),\n+        field(\"result\", true, FieldKind::String),\n+        field(\"source_changes\", true, FieldKind::Opaque),\n+        field(\"brief_record_id\", false, FieldKind::String),\n+        field(\"brief_object_sha256\", false, FieldKind::String),\n+        field(\"depends_on\", true, FieldKind::StringSet),\n+    ],\n+    capabilities: &[],\n+};\n+\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct BriefReference {\n+    pub record_id: RecordId,\n+    /// Lowercase SHA-256 of the exact archive object bytes, without a prefix.\n+    pub object_sha256: String,\n+}\n+\n+impl BriefReference {\n+    pub fn new(\n+        record_id: RecordId,\n+        object_sha256: impl Into<String>,\n+    ) -> Result<Self, ContributionRevisionError> {\n+        let object_sha256 = object_sha256.into();\n+        if object_sha256.len() != 64\n+            || !object_sha256\n+                .bytes()\n+                .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))\n+        {\n+            return Err(ContributionRevisionError::InvalidBriefDigest);\n+        }\n+        Ok(Self {\n+            record_id,\n+            object_sha256,\n+        })\n+    }\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct ContributionRevision {\n+    project_id: ProjectId,\n+    contribution_id: RecordId,\n+    base: SourceSnapshotId,\n+    result: SourceSnapshotId,\n+    source_changes: Vec<Value>,\n+    brief: Option<BriefReference>,\n+    depends_on: Vec<RecordId>,\n+}\n+\n+impl ContributionRevision {\n+    pub fn new(\n+        project_id: ProjectId,\n+        contribution_id: RecordId,\n+        base: SourceSnapshotId,\n+        result: SourceSnapshotId,\n+        source_changes: Vec<Value>,\n+        brief: Option<BriefReference>,\n+        depends_on: Vec<RecordId>,\n+    ) -> Result<Self, ContributionRevisionError> {\n+        if source_changes.len() > MAX_REVISION_CHANGES {\n+            return Err(ContributionRevisionError::TooManyChanges(\n+                source_changes.len(),\n+            ));\n+        }\n+        validate_changes(&source_changes)?;\n+        let mut dependency_ids: Vec<String> = depends_on\n+            .iter()\n+            .map(|id| id.as_str().to_string())\n+            .collect();\n+        dependency_ids.sort();\n+        if dependency_ids.windows(2).any(|pair| pair[0] == pair[1]) {\n+            return Err(ContributionRevisionError::DuplicateDependency);\n+        }\n+        let depends_on = dependency_ids\n+            .iter()\n+            .map(|id| RecordId::parse(id).expect(\"input dependency IDs were RecordIds\"))\n+            .collect();\n+        Ok(Self {\n+            project_id,\n+            contribution_id,\n+            base,\n+            result,\n+            source_changes,\n+            brief,\n+            depends_on,\n+        })\n+    }\n+\n+    pub fn project_id(&self) -> &ProjectId {\n+        &self.project_id\n+    }\n+\n+    pub fn contribution_id(&self) -> &RecordId {\n+        &self.contribution_id\n+    }\n+\n+    pub fn base(&self) -> &SourceSnapshotId {\n+        &self.base\n+    }\n+\n+    pub fn result(&self) -> &SourceSnapshotId {\n+        &self.result\n+    }\n+\n+    pub fn source_changes(&self) -> &[Value] {\n+        &self.source_changes\n+    }\n+\n+    pub fn brief(&self) -> Option<&BriefReference> {\n+        self.brief.as_ref()\n+    }\n+\n+    pub fn depends_on(&self) -> &[RecordId] {\n+        &self.depends_on\n+    }\n+\n+    /// Canonical record bytes and their immutable revision ID.\n+    pub fn to_record(&self) -> (Vec<u8>, RecordId) {\n+        let mut fields = vec![\n+            (\"schema\".into(), text(CONTRIBUTION_REVISION_SCHEMA_NAME)),\n+            (\"project_id\".into(), text(self.project_id.as_str())),\n+            (\n+                \"contribution_id\".into(),\n+                text(self.contribution_id.as_str()),\n+            ),\n+            (\"base\".into(), text(self.base.as_str())),\n+            (\"result\".into(), text(self.result.as_str())),\n+            (\n+                \"source_changes\".into(),\n+                Value::Array(self.source_changes.clone()),\n+            ),\n+            (\n+                \"depends_on\".into(),\n+                Value::Array(self.depends_on.iter().map(|id| text(id.as_str())).collect()),\n+            ),\n+        ];\n+        if let Some(brief) = &self.brief {\n+            fields.push((\"brief_record_id\".into(), text(brief.record_id.as_str())));\n+            fields.push((\"brief_object_sha256\".into(), text(&brief.object_sha256)));\n+        }\n+        let bytes =\n+            Value::Object(Object::new(fields).expect(\"distinct contribution revision fields\"))\n+                .to_canonical_bytes();\n+        let record = Record::decode(&bytes, &[&CONTRIBUTION_REVISION_SCHEMA])\n+            .expect(\"a contribution revision encodes to its schema\");\n+        (bytes, record.id())\n+    }\n+\n+    pub fn from_record(input: &[u8]) -> Result<(Self, RecordId), ContributionRevisionError> {\n+        if input.len() > MAX_CONTRIBUTION_REVISION_BYTES {\n+            return Err(ContributionRevisionError::TooLarge(input.len()));\n+        }\n+        let Value::Object(raw) = canonical_json::parse(input)? else {\n+            return Err(ContributionRevisionError::NotAnObject);\n+        };\n+        const ALLOWED: &[&str] = &[\n+            \"schema\",\n+            \"project_id\",\n+            \"contribution_id\",\n+            \"base\",\n+            \"result\",\n+            \"source_changes\",\n+            \"brief_record_id\",\n+            \"brief_object_sha256\",\n+            \"depends_on\",\n+        ];\n+        if let Some((name, _)) = raw\n+            .iter()\n+            .find(|(name, _)| !ALLOWED.contains(&name.as_str()))\n+        {\n+            return Err(ContributionRevisionError::UnknownField(name.to_string()));\n+        }\n+        let record = Record::decode(input, &[&CONTRIBUTION_REVISION_SCHEMA])?;\n+        let project_id = ProjectId::parse(&required_string(&record, \"project_id\")?)?;\n+        let contribution_id = RecordId::parse(&required_string(&record, \"contribution_id\")?)?;\n+        let base = SourceSnapshotId::parse(&required_string(&record, \"base\")?)?;\n+        let result = SourceSnapshotId::parse(&required_string(&record, \"result\")?)?;\n+        let Value::Array(source_changes) = record.get(\"source_changes\").expect(\"schema checked\")\n+        else {\n+            return Err(ContributionRevisionError::WrongFieldType(\"source_changes\"));\n+        };\n+        let Value::Array(dependencies) = record.get(\"depends_on\").expect(\"schema checked\") else {\n+            return Err(ContributionRevisionError::WrongFieldType(\"depends_on\"));\n+        };\n+        let depends_on = dependencies\n+            .iter()\n+            .map(|value| match value {\n+                Value::String(id) => RecordId::parse(id).map_err(ContributionRevisionError::Record),\n+                _ => Err(ContributionRevisionError::WrongFieldType(\"depends_on\")),\n+            })\n+            .collect::<Result<Vec<_>, _>>()?;\n+        let brief_record_id = optional_string(&record, \"brief_record_id\")?;\n+        let brief_object_sha256 = optional_string(&record, \"brief_object_sha256\")?;\n+        let brief = match (brief_record_id, brief_object_sha256) {\n+            (None, None) => None,\n+            (Some(id), Some(sha)) => Some(BriefReference::new(RecordId::parse(&id)?, sha)?),\n+            _ => return Err(ContributionRevisionError::IncompleteBriefReference),\n+        };\n+        let revision = Self::new(\n+            project_id,\n+            contribution_id,\n+            base,\n+            result,\n+            source_changes.clone(),\n+            brief,\n+            depends_on,\n+        )?;\n+        let (canonical, id) = revision.to_record();\n+        if canonical != input {\n+            return Err(ContributionRevisionError::NonCanonicalRecord);\n+        }\n+        Ok((revision, id))\n+    }\n+}\n+\n+fn validate_changes(changes: &[Value]) -> Result<(), ContributionRevisionError> {\n+    let mut previous: Option<Vec<u8>> = None;\n+    for value in changes {\n+        let Value::Object(object) = value else {\n+            return Err(ContributionRevisionError::InvalidSourceChange);\n+        };\n+        const CHANGE_FIELDS: &[&str] = &[\n+            \"before\",\n+            \"after\",\n+            \"relation\",\n+            \"derived_from\",\n+            \"possible_sources\",\n+        ];\n+        if object\n+            .iter()\n+            .any(|(name, _)| !CHANGE_FIELDS.contains(&name.as_str()))\n+        {\n+            return Err(ContributionRevisionError::InvalidSourceChange);\n+        }\n+        let relation_text = object_string(object, \"relation\")?;\n+        let relation = match relation_text.as_str() {\n+            \"same_path\" => IdentityRelation::SamePath,\n+            \"explicit_rename\" => IdentityRelation::ExplicitRename,\n+            \"explicit_copy\" => IdentityRelation::ExplicitCopy,\n+            \"explicit_split\" => IdentityRelation::ExplicitSplit,\n+            \"new\" => IdentityRelation::New,\n+            \"removed\" => IdentityRelation::Removed,\n+            \"uncertain_rename\" => IdentityRelation::UncertainRename,\n+            _ => return Err(ContributionRevisionError::InvalidSourceChange),\n+        };\n+        let before = object_state(object, \"before\")?;\n+        let after = object_state(object, \"after\")?;\n+        let sources = object_ids(object, \"derived_from\")?;\n+        let possible = object_ids(object, \"possible_sources\")?;\n+        let shape_ok = match relation {\n+            IdentityRelation::SamePath => {\n+                matches!((&before, &after), (Some((before_path, _, before_id)), Some((after_path, _, after_id))) if before_path == after_path && before_id == after_id)\n+                    && sources.is_empty()\n+                    && possible.is_empty()\n+            }\n+            IdentityRelation::ExplicitRename => {\n+                matches!((&before, &after), (Some((before_path, _, before_id)), Some((after_path, _, after_id))) if before_path != after_path && before_id == after_id)\n+                    && sources.is_empty()\n+                    && possible.is_empty()\n+            }\n+            IdentityRelation::ExplicitCopy | IdentityRelation::ExplicitSplit => {\n+                before.is_none()\n+                    && after\n+                        .as_ref()\n+                        .is_some_and(|(_, _, after_id)| !sources.contains(after_id))\n+                    && !sources.is_empty()\n+                    && (relation != IdentityRelation::ExplicitCopy || sources.len() == 1)\n+                    && possible.is_empty()\n+            }\n+            IdentityRelation::New => {\n+                before.is_none() && after.is_some() && sources.is_empty() && possible.is_empty()\n+            }\n+            IdentityRelation::Removed => {\n+                before.is_some() && after.is_none() && sources.is_empty() && possible.is_empty()\n+            }\n+            IdentityRelation::UncertainRename => {\n+                before.is_none() && after.is_some() && sources.is_empty() && !possible.is_empty()\n+            }\n+        };\n+        if !shape_ok {\n+            return Err(ContributionRevisionError::InvalidSourceChange);\n+        }\n+        let path = after\n+            .as_ref()\n+            .or(before.as_ref())\n+            .expect(\"valid relations always contain a side\")\n+            .0\n+            .clone();\n+        if previous.as_ref().is_some_and(|last| last >= &path) {\n+            return Err(ContributionRevisionError::NonCanonicalChangeOrder);\n+        }\n+        previous = Some(path);\n+    }\n+    Ok(())\n+}\n+\n+/// Parsed source file state: canonical raw path bytes.\n+fn object_state(\n+    object: &Object,\n+    field: &'static str,\n+) -> Result<Option<(Vec<u8>, EntryKind, FileId)>, ContributionRevisionError> {\n+    match object.get(field) {\n+        Some(Value::Null) => Ok(None),\n+        Some(Value::Object(state)) => {\n+            const FIELDS: &[&str] = &[\"path_hex\", \"mode\", \"content_sha256\", \"file_id\"];\n+            if state\n+                .iter()\n+                .any(|(name, _)| !FIELDS.contains(&name.as_str()))\n+            {\n+                return Err(ContributionRevisionError::InvalidSourceChange);\n+            }\n+            let path = decode_hex(object_string(state, \"path_hex\")?, \"path_hex\")?;\n+            let mode = object_string(state, \"mode\")?;\n+            let kind = EntryKind::from_git_mode(&mode)\n+                .map_err(|_| ContributionRevisionError::InvalidSourceChange)?;\n+            let content = decode_hex(object_string(state, \"content_sha256\")?, \"content_sha256\")?;\n+            let content: [u8; 32] = content\n+                .try_into()\n+                .map_err(|_| ContributionRevisionError::InvalidSourceChange)?;\n+            let file_id = FileId::parse(&object_string(state, \"file_id\")?)?;\n+            SourceSnapshot::new([SourceEntry::from_content_digest(\n+                path.clone(),\n+                kind,\n+                content,\n+            )])?;\n+            Ok(Some((path, kind, file_id)))\n+        }\n+        _ => Err(ContributionRevisionError::InvalidSourceChange),\n+    }\n+}\n+\n+fn object_ids(\n+    object: &Object,\n+    field: &'static str,\n+) -> Result<Vec<FileId>, ContributionRevisionError> {\n+    match object.get(field) {\n+        Some(Value::Array(values)) => values\n+            .iter()\n+            .map(|value| match value {\n+                Value::String(id) => FileId::parse(id).map_err(ContributionRevisionError::Project),\n+                _ => Err(ContributionRevisionError::InvalidSourceChange),\n+            })\n+            .collect(),\n+        _ => Err(ContributionRevisionError::InvalidSourceChange),\n+    }\n+}\n+\n+fn object_string(\n+    object: &Object,\n+    field: &'static str,\n+) -> Result<String, ContributionRevisionError> {\n+    match object.get(field) {\n+        Some(Value::String(value)) => Ok(value.clone()),\n+        _ => Err(ContributionRevisionError::InvalidSourceChange),\n+    }\n+}\n+\n+fn required_string(\n+    record: &Record,\n+    field: &'static str,\n+) -> Result<String, ContributionRevisionError> {\n+    match record.get(field) {\n+        Some(Value::String(value)) => Ok(value.clone()),\n+        _ => Err(ContributionRevisionError::WrongFieldType(field)),\n+    }\n+}\n+\n+fn optional_string(\n+    record: &Record,\n+    field: &'static str,\n+) -> Result<Option<String>, ContributionRevisionError> {\n+    match record.get(field) {\n+        None => Ok(None),\n+        Some(Value::String(value)) => Ok(Some(value.clone())),\n+        _ => Err(ContributionRevisionError::WrongFieldType(field)),\n+    }\n+}\n+\n+fn text(value: &str) -> Value {\n+    Value::String(value.to_string())\n+}\n+\n+fn decode_hex(value: String, field: &'static str) -> Result<Vec<u8>, ContributionRevisionError> {\n+    let bytes = HEXLOWER\n+        .decode(value.as_bytes())\n+        .map_err(|_| ContributionRevisionError::InvalidSourceChange)?;\n+    if field == \"content_sha256\" && bytes.len() != 32 {\n+        return Err(ContributionRevisionError::InvalidSourceChange);\n+    }\n+    Ok(bytes)\n+}\n+\n+#[derive(Debug, thiserror::Error)]\n+pub enum ContributionRevisionError {\n+    #[error(\"contribution revision exceeds the {MAX_CONTRIBUTION_REVISION_BYTES}-byte limit ({0})\")]\n+    TooLarge(usize),\n+    #[error(\"contribution revision has more than {MAX_REVISION_CHANGES} source changes ({0})\")]\n+    TooManyChanges(usize),\n+    #[error(\"contribution revision must be a JSON object\")]\n+    NotAnObject,\n+    #[error(\"contribution revision contains unknown field {0:?}\")]\n+    UnknownField(String),\n+    #[error(\"contribution revision field {0} has the wrong type\")]\n+    WrongFieldType(&'static str),\n+    #[error(\"contribution revision has an invalid or incomplete brief reference\")]\n+    IncompleteBriefReference,\n+    #[error(\"brief object digest must be 64 lowercase hex characters\")]\n+    InvalidBriefDigest,\n+    #[error(\"contribution revision has duplicate dependency IDs\")]\n+    DuplicateDependency,\n+    #[error(\"contribution revision has an invalid source change\")]\n+    InvalidSourceChange,\n+    #[error(\"contribution revision changes must be in strict raw-byte path order\")]\n+    NonCanonicalChangeOrder,\n+    #[error(\"contribution revision bytes are not canonical for this profile\")]\n+    NonCanonicalRecord,\n+    #[error(\"record error: {0}\")]\n+    Record(#[from] RecordError),\n+    #[error(\"project/file identity error: {0}\")]\n+    Project(#[from] super::project_identity::ProjectIdentityError),\n+    #[error(\"source snapshot error: {0}\")]\n+    Snapshot(#[from] super::source_snapshot::SourceSnapshotError),\n+    #[error(\"canonical JSON error: {0}\")]\n+    Canonical(#[from] canonical_json::CanonicalJsonError),\n+}"},{"sha":"a53ca754696d4aed22e00e875c7abb608814e0d2","filename":"packages/aethyme/rust/crates/aethyme-contracts/src/experimental_v0/mod.rs","status":"modified","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/schiste/Aethyme/blob/63a3aa3e533ba466f02f1deabd36b9d3feb88985/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fmod.rs","raw_url":"https://github.com/schiste/Aethyme/raw/63a3aa3e533ba466f02f1deabd36b9d3feb88985/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fmod.rs","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fmod.rs?ref=63a3aa3e533ba466f02f1deabd36b9d3feb88985","patch":"@@ -3,12 +3,20 @@\n pub mod analysis;\n pub mod brief;\n pub mod canonical_json;\n+pub mod contribution_revision;\n mod digest;\n+pub mod project_identity;\n pub mod record;\n pub mod source_snapshot;\n pub mod symbol_identity;\n \n+pub use contribution_revision::{BriefReference, ContributionRevision, ContributionRevisionError};\n pub use digest::ID_PREFIX;\n+pub use project_identity::{\n+    EnrolledFile, FileChange, FileId, FileIdentityTransition, FileNamespaceConflict,\n+    FileNamespaceConflictKind, FileOperation, FileState, IdentityRelation, ProjectDescriptor,\n+    ProjectId, ProjectIdentityError, advance_file_identities, validate_file_proposals,\n+};\n pub use record::{FieldKind, FieldSpec, Record, RecordError, RecordId, RecordSchema, StateReading};\n pub use source_snapshot::{\n     EntryKind, SourceEntry, SourceSnapshot, SourceSnapshotError, SourceSnapshotId,"},{"sha":"caf6db09450234eb7991a09643bfe65b929e99a3","filename":"packages/aethyme/rust/crates/aethyme-contracts/src/experimental_v0/project_identity.rs","status":"added","additions":1030,"deletions":0,"changes":1030,"blob_url":"https://github.com/schiste/Aethyme/blob/63a3aa3e533ba466f02f1deabd36b9d3feb88985/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fproject_identity.rs","raw_url":"https://github.com/schiste/Aethyme/raw/63a3aa3e533ba466f02f1deabd36b9d3feb88985/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fproject_identity.rs","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fproject_identity.rs?ref=63a3aa3e533ba466f02f1deabd36b9d3feb88985","patch":"@@ -0,0 +1,1030 @@\n+//! Experimental local project and file identity records (plan §5.2–5.4, D10).\n+//!\n+//! A descriptor is a proposal until a broker validates its committed config\n+//! pointer and a local operator confirms its digest. These portable values do\n+//! not grant capture, budget, execution, review, or acceptance authority.\n+\n+use std::collections::{BTreeMap, BTreeSet};\n+\n+use data_encoding::HEXLOWER;\n+use thiserror::Error;\n+\n+use super::canonical_json::{self, Object, Value};\n+use super::digest;\n+use super::record::{FieldKind, FieldSpec, Record, RecordError, RecordId, RecordSchema};\n+use super::source_snapshot::{\n+    EntryKind, SourceEntry, SourceSnapshot, SourceSnapshotError, SourceSnapshotId,\n+};\n+\n+pub const PROJECT_DESCRIPTOR_SCHEMA_NAME: &str = \"aethyme.project-descriptor/experimental-v0\";\n+pub const PROJECT_DESCRIPTOR_PATH: &str = \".aethyme/project-descriptor.json\";\n+pub const PROJECT_POLICY_PATH: &str = \".aethyme/config.toml\";\n+pub const MAX_DESCRIPTOR_BYTES: usize = 16 * 1024 * 1024;\n+pub const MAX_DESCRIPTOR_FILES: usize = 200_000;\n+const FILE_ID_DOMAIN: &[u8] = b\"aethyme file identity v0\\0\";\n+const PROPOSAL_FILE_ID_DOMAIN: &[u8] = b\"aethyme proposed file identity v0\\0\";\n+\n+const fn field(name: &'static str, kind: FieldKind) -> FieldSpec {\n+    FieldSpec {\n+        name,\n+        required: true,\n+        kind,\n+        capability: None,\n+    }\n+}\n+\n+pub static PROJECT_DESCRIPTOR_SCHEMA: RecordSchema = RecordSchema {\n+    name: PROJECT_DESCRIPTOR_SCHEMA_NAME,\n+    fields: &[\n+        field(\"project_id\", FieldKind::String),\n+        field(\"anchor_commit\", FieldKind::String),\n+        field(\"anchor_snapshot\", FieldKind::String),\n+        field(\"source_binding\", FieldKind::String),\n+        field(\"policy_location\", FieldKind::String),\n+        field(\"acceptance_target\", FieldKind::String),\n+        field(\"visibility_boundary\", FieldKind::String),\n+        field(\"files\", FieldKind::Opaque),\n+    ],\n+    capabilities: &[],\n+};\n+\n+/// Logical identity for a project. It is distinct from the local ProjectKey\n+/// used to name a host-side collaboration store.\n+#[derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]\n+pub struct ProjectId(String);\n+\n+impl ProjectId {\n+    pub fn parse(value: &str) -> Result<Self, ProjectIdentityError> {\n+        let encoded = value.strip_prefix(\"proj:\").unwrap_or_default();\n+        let valid = encoded.len() == 26\n+            && encoded.bytes().all(|byte| base32_value(byte).is_some())\n+            // 128 bits occupy 26 unpadded base32 symbols; the final symbol\n+            // carries only two payload bits and must have three zero bits.\n+            && encoded.as_bytes().last().is_some_and(|last| {\n+                base32_value(*last).is_some_and(|value| value % 4 == 0)\n+            });\n+        if valid {\n+            Ok(Self(value.to_string()))\n+        } else {\n+            Err(ProjectIdentityError::InvalidProjectId(value.to_string()))\n+        }\n+    }\n+\n+    pub fn as_str(&self) -> &str {\n+        &self.0\n+    }\n+}\n+\n+impl std::fmt::Display for ProjectId {\n+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n+        formatter.write_str(&self.0)\n+    }\n+}\n+\n+/// Stable identity for one file lineage. File identity says nothing about\n+/// semantic compatibility or whether two changes can be composed.\n+#[derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]\n+pub struct FileId(String);\n+\n+impl FileId {\n+    pub fn parse(value: &str) -> Result<Self, ProjectIdentityError> {\n+        let digest = value.strip_prefix(\"file:\").unwrap_or_default();\n+        if super::digest::is_canonical(digest) {\n+            Ok(Self(value.to_string()))\n+        } else {\n+            Err(ProjectIdentityError::InvalidFileId(value.to_string()))\n+        }\n+    }\n+\n+    pub fn as_str(&self) -> &str {\n+        &self.0\n+    }\n+\n+    fn enrolled(project: &ProjectId, snapshot: &SourceSnapshotId, path: &[u8]) -> Self {\n+        let mut input = FILE_ID_DOMAIN.to_vec();\n+        input.extend_from_slice(project.as_str().as_bytes());\n+        input.push(0);\n+        input.extend_from_slice(snapshot.as_str().as_bytes());\n+        input.push(0);\n+        input.extend_from_slice(&(path.len() as u64).to_be_bytes());\n+        input.extend_from_slice(path);\n+        Self(format!(\"file:{}\", digest::encode(&input)))\n+    }\n+\n+    fn proposed(\n+        project: &ProjectId,\n+        proposal: &str,\n+        result: &SourceSnapshotId,\n+        ordinal: u64,\n+        path: &[u8],\n+    ) -> Self {\n+        let mut input = PROPOSAL_FILE_ID_DOMAIN.to_vec();\n+        input.extend_from_slice(project.as_str().as_bytes());\n+        input.push(0);\n+        input.extend_from_slice(proposal.as_bytes());\n+        input.push(0);\n+        input.extend_from_slice(result.as_str().as_bytes());\n+        input.push(0);\n+        input.extend_from_slice(&ordinal.to_be_bytes());\n+        input.extend_from_slice(&(path.len() as u64).to_be_bytes());\n+        input.extend_from_slice(path);\n+        Self(format!(\"file:{}\", digest::encode(&input)))\n+    }\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct EnrolledFile {\n+    pub path: Vec<u8>,\n+    pub kind: EntryKind,\n+    pub content_sha256: [u8; 32],\n+    pub file_id: FileId,\n+}\n+\n+/// An experimental, local-only project descriptor anchored to an explicit\n+/// committed source snapshot. It deliberately names no acceptance authority.\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct ProjectDescriptor {\n+    project_id: ProjectId,\n+    anchor_commit: String,\n+    anchor_snapshot: SourceSnapshotId,\n+    files: Vec<EnrolledFile>,\n+}\n+\n+impl ProjectDescriptor {\n+    pub fn from_snapshot(\n+        project_id: ProjectId,\n+        anchor_commit: impl Into<String>,\n+        snapshot: &SourceSnapshot,\n+    ) -> Result<Self, ProjectIdentityError> {\n+        let anchor_commit = anchor_commit.into();\n+        validate_commit(&anchor_commit)?;\n+        if snapshot.entries().len() > MAX_DESCRIPTOR_FILES {\n+            return Err(ProjectIdentityError::TooManyFiles {\n+                count: snapshot.entries().len(),\n+            });\n+        }\n+        let anchor_snapshot = snapshot.id();\n+        let files = snapshot\n+            .entries()\n+            .iter()\n+            .map(|entry| EnrolledFile {\n+                path: entry.path().to_vec(),\n+                kind: entry.kind(),\n+                content_sha256: *entry.content_sha256(),\n+                file_id: FileId::enrolled(&project_id, &anchor_snapshot, entry.path()),\n+            })\n+            .collect();\n+        Ok(Self {\n+            project_id,\n+            anchor_commit,\n+            anchor_snapshot,\n+            files,\n+        })\n+    }\n+\n+    pub fn project_id(&self) -> &ProjectId {\n+        &self.project_id\n+    }\n+\n+    pub fn anchor_commit(&self) -> &str {\n+        &self.anchor_commit\n+    }\n+\n+    pub fn anchor_snapshot(&self) -> &SourceSnapshotId {\n+        &self.anchor_snapshot\n+    }\n+\n+    pub fn files(&self) -> &[EnrolledFile] {\n+        &self.files\n+    }\n+\n+    pub fn file_map(&self) -> BTreeMap<Vec<u8>, FileId> {\n+        self.files\n+            .iter()\n+            .map(|file| (file.path.clone(), file.file_id.clone()))\n+            .collect()\n+    }\n+\n+    pub fn anchor_source(&self) -> Result<SourceSnapshot, ProjectIdentityError> {\n+        SourceSnapshot::new(self.files.iter().map(|file| {\n+            SourceEntry::from_content_digest(file.path.clone(), file.kind, file.content_sha256)\n+        }))\n+        .map_err(ProjectIdentityError::Snapshot)\n+    }\n+\n+    /// Canonical descriptor bytes and their immutable RecordId.\n+    pub fn to_record(&self) -> (Vec<u8>, RecordId) {\n+        let files = self\n+            .files\n+            .iter()\n+            .map(|file| {\n+                Value::Object(\n+                    Object::new(vec![\n+                        (\"path_hex\".into(), text(&HEXLOWER.encode(&file.path))),\n+                        (\"mode\".into(), text(file.kind.git_mode())),\n+                        (\n+                            \"content_sha256\".into(),\n+                            text(&HEXLOWER.encode(&file.content_sha256)),\n+                        ),\n+                        (\"file_id\".into(), text(file.file_id.as_str())),\n+                    ])\n+                    .expect(\"distinct file fields\"),\n+                )\n+            })\n+            .collect();\n+        let fields = vec![\n+            (\"schema\".into(), text(PROJECT_DESCRIPTOR_SCHEMA_NAME)),\n+            (\"project_id\".into(), text(self.project_id.as_str())),\n+            (\"anchor_commit\".into(), text(&self.anchor_commit)),\n+            (\n+                \"anchor_snapshot\".into(),\n+                text(self.anchor_snapshot.as_str()),\n+            ),\n+            (\n+                \"source_binding\".into(),\n+                text(&format!(\"git-commit:{}\", self.anchor_commit)),\n+            ),\n+            (\"policy_location\".into(), text(PROJECT_POLICY_PATH)),\n+            (\"acceptance_target\".into(), text(\"unbound\")),\n+            (\"visibility_boundary\".into(), text(\"local\")),\n+            (\"files\".into(), Value::Array(files)),\n+        ];\n+        let bytes = Value::Object(Object::new(fields).expect(\"distinct descriptor fields\"))\n+            .to_canonical_bytes();\n+        let record = Record::decode(&bytes, &[&PROJECT_DESCRIPTOR_SCHEMA])\n+            .expect(\"a project descriptor encodes to its schema\");\n+        (bytes, record.id())\n+    }\n+\n+    pub fn from_record(input: &[u8]) -> Result<(Self, RecordId), ProjectIdentityError> {\n+        if input.len() > MAX_DESCRIPTOR_BYTES {\n+            return Err(ProjectIdentityError::DescriptorTooLarge { bytes: input.len() });\n+        }\n+        let Value::Object(raw) = canonical_json::parse(input)? else {\n+            return Err(ProjectIdentityError::NotAnObject);\n+        };\n+        let allowed = [\n+            \"schema\",\n+            \"requires\",\n+            \"extensions\",\n+            \"project_id\",\n+            \"anchor_commit\",\n+            \"anchor_snapshot\",\n+            \"source_binding\",\n+            \"policy_location\",\n+            \"acceptance_target\",\n+            \"visibility_boundary\",\n+            \"files\",\n+        ];\n+        if let Some((name, _)) = raw\n+            .iter()\n+            .find(|(name, _)| !allowed.contains(&name.as_str()))\n+        {\n+            return Err(ProjectIdentityError::UnknownField(name.to_string()));\n+        }\n+        let record = Record::decode(input, &[&PROJECT_DESCRIPTOR_SCHEMA])?;\n+        let project_id = ProjectId::parse(required_string(&record, \"project_id\")?)?;\n+        let anchor_commit = required_string(&record, \"anchor_commit\")?;\n+        validate_commit(&anchor_commit)?;\n+        let anchor_snapshot =\n+            SourceSnapshotId::parse(&required_string(&record, \"anchor_snapshot\")?)\n+                .map_err(|error| ProjectIdentityError::InvalidAnchor(error.to_string()))?;\n+        if required_string(&record, \"source_binding\")? != format!(\"git-commit:{anchor_commit}\")\n+            || required_string(&record, \"policy_location\")? != PROJECT_POLICY_PATH\n+            || required_string(&record, \"acceptance_target\")? != \"unbound\"\n+            || required_string(&record, \"visibility_boundary\")? != \"local\"\n+        {\n+            return Err(ProjectIdentityError::InvalidDescriptorBoundary);\n+        }\n+        let Value::Array(values) = record.get(\"files\").expect(\"schema checked\") else {\n+            return Err(ProjectIdentityError::WrongFieldType(\"files\"));\n+        };\n+        if values.len() > MAX_DESCRIPTOR_FILES {\n+            return Err(ProjectIdentityError::TooManyFiles {\n+                count: values.len(),\n+            });\n+        }\n+        let mut files = Vec::with_capacity(values.len());\n+        let mut previous_path: Option<Vec<u8>> = None;\n+        for value in values {\n+            let Value::Object(entry) = value else {\n+                return Err(ProjectIdentityError::WrongFileEntry);\n+            };\n+            const FILE_FIELDS: &[&str] = &[\"path_hex\", \"mode\", \"content_sha256\", \"file_id\"];\n+            if let Some((name, _)) = entry\n+                .iter()\n+                .find(|(name, _)| !FILE_FIELDS.contains(&name.as_str()))\n+            {\n+                return Err(ProjectIdentityError::UnknownFileField(name.to_string()));\n+            }\n+            let path = decode_hex(required_object_string(entry, \"path_hex\")?, \"path_hex\")?;\n+            let mode = required_object_string(entry, \"mode\")?;\n+            let kind = EntryKind::from_git_mode(&mode)\n+                .map_err(|error| ProjectIdentityError::InvalidFileEntry(error.to_string()))?;\n+            let digest_bytes = decode_hex(\n+                required_object_string(entry, \"content_sha256\")?,\n+                \"content_sha256\",\n+            )?;\n+            let content_sha256: [u8; 32] = digest_bytes.try_into().map_err(|_| {\n+                ProjectIdentityError::InvalidFileEntry(\"content digest must be 32 bytes\".into())\n+            })?;\n+            if previous_path\n+                .as_ref()\n+                .is_some_and(|previous| previous >= &path)\n+            {\n+                return Err(ProjectIdentityError::NonCanonicalFileOrder);\n+            }\n+            previous_path = Some(path.clone());\n+            let file_id = FileId::parse(&required_object_string(entry, \"file_id\")?)?;\n+            files.push(EnrolledFile {\n+                path,\n+                kind,\n+                content_sha256,\n+                file_id,\n+            });\n+        }\n+        let descriptor = Self {\n+            project_id,\n+            anchor_commit,\n+            anchor_snapshot,\n+            files,\n+        };\n+        descriptor.validate()?;\n+        Ok((descriptor, record.id()))\n+    }\n+\n+    pub fn validate(&self) -> Result<(), ProjectIdentityError> {\n+        validate_commit(&self.anchor_commit)?;\n+        if self.files.len() > MAX_DESCRIPTOR_FILES {\n+            return Err(ProjectIdentityError::TooManyFiles {\n+                count: self.files.len(),\n+            });\n+        }\n+        let source = self.anchor_source()?;\n+        if source.id() != self.anchor_snapshot {\n+            return Err(ProjectIdentityError::AnchorSnapshotMismatch {\n+                expected: self.anchor_snapshot.to_string(),\n+                actual: source.id().to_string(),\n+            });\n+        }\n+        let mut ids = BTreeSet::new();\n+        for file in &self.files {\n+            if file.file_id != FileId::enrolled(&self.project_id, &self.anchor_snapshot, &file.path)\n+            {\n+                return Err(ProjectIdentityError::InvalidFileEntry(\n+                    \"enrollment FileId does not match project, snapshot, and raw path bytes\".into(),\n+                ));\n+            }\n+            if !ids.insert(file.file_id.clone()) {\n+                return Err(ProjectIdentityError::DuplicateFileId(\n+                    file.file_id.to_string(),\n+                ));\n+            }\n+        }\n+        Ok(())\n+    }\n+\n+    pub fn validate_anchor(\n+        &self,\n+        commit: &str,\n+        snapshot: &SourceSnapshot,\n+    ) -> Result<(), ProjectIdentityError> {\n+        if self.anchor_commit != commit {\n+            return Err(ProjectIdentityError::AnchorCommitMismatch {\n+                expected: self.anchor_commit.clone(),\n+                actual: commit.to_string(),\n+            });\n+        }\n+        if self.anchor_snapshot != snapshot.id() || self.anchor_source()? != *snapshot {\n+            return Err(ProjectIdentityError::AnchorSnapshotMismatch {\n+                expected: self.anchor_snapshot.to_string(),\n+                actual: snapshot.id().to_string(),\n+            });\n+        }\n+        Ok(())\n+    }\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct FileState {\n+    pub path: Vec<u8>,\n+    pub kind: EntryKind,\n+    pub content_sha256: [u8; 32],\n+    pub file_id: FileId,\n+}\n+\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum IdentityRelation {\n+    SamePath,\n+    ExplicitRename,\n+    ExplicitCopy,\n+    ExplicitSplit,\n+    New,\n+    Removed,\n+    UncertainRename,\n+}\n+\n+impl IdentityRelation {\n+    pub fn as_str(self) -> &'static str {\n+        match self {\n+            Self::SamePath => \"same_path\",\n+            Self::ExplicitRename => \"explicit_rename\",\n+            Self::ExplicitCopy => \"explicit_copy\",\n+            Self::ExplicitSplit => \"explicit_split\",\n+            Self::New => \"new\",\n+            Self::Removed => \"removed\",\n+            Self::UncertainRename => \"uncertain_rename\",\n+        }\n+    }\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct FileChange {\n+    pub before: Option<FileState>,\n+    pub after: Option<FileState>,\n+    pub relation: IdentityRelation,\n+    pub derived_from: Vec<FileId>,\n+    pub possible_sources: Vec<FileId>,\n+}\n+\n+impl FileChange {\n+    pub fn to_value(&self) -> Value {\n+        let state_value = |state: &FileState| {\n+            Value::Object(\n+                Object::new(vec![\n+                    (\"path_hex\".into(), text(&HEXLOWER.encode(&state.path))),\n+                    (\"mode\".into(), text(state.kind.git_mode())),\n+                    (\n+                        \"content_sha256\".into(),\n+                        text(&HEXLOWER.encode(&state.content_sha256)),\n+                    ),\n+                    (\"file_id\".into(), text(state.file_id.as_str())),\n+                ])\n+                .expect(\"distinct file state fields\"),\n+            )\n+        };\n+        let derived = self\n+            .derived_from\n+            .iter()\n+            .map(|id| text(id.as_str()))\n+            .collect();\n+        let possible = self\n+            .possible_sources\n+            .iter()\n+            .map(|id| text(id.as_str()))\n+            .collect();\n+        Value::Object(\n+            Object::new(vec![\n+                (\n+                    \"before\".into(),\n+                    self.before.as_ref().map(state_value).unwrap_or(Value::Null),\n+                ),\n+                (\n+                    \"after\".into(),\n+                    self.after.as_ref().map(state_value).unwrap_or(Value::Null),\n+                ),\n+                (\"relation\".into(), text(self.relation.as_str())),\n+                (\"derived_from\".into(), Value::Array(derived)),\n+                (\"possible_sources\".into(), Value::Array(possible)),\n+            ])\n+            .expect(\"distinct file change fields\"),\n+        )\n+    }\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub enum FileOperation {\n+    Rename { from: Vec<u8>, to: Vec<u8> },\n+    Copy { from: Vec<u8>, to: Vec<u8> },\n+    Split { from: Vec<u8>, to: Vec<Vec<u8>> },\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct FileIdentityTransition {\n+    pub project_id: ProjectId,\n+    pub proposal_id: String,\n+    pub base: SourceSnapshotId,\n+    pub result: SourceSnapshotId,\n+    pub result_files: Vec<FileState>,\n+    pub changes: Vec<FileChange>,\n+}\n+\n+/// Advance file identities from an exact, previously known base. Unspecified\n+/// delete/add pairs are never treated as renames; exact-content matches are\n+/// surfaced as uncertain candidates until an explicit operation is supplied.\n+pub fn advance_file_identities(\n+    project_id: &ProjectId,\n+    proposal_id: &str,\n+    base: &SourceSnapshot,\n+    result: &SourceSnapshot,\n+    base_ids: &BTreeMap<Vec<u8>, FileId>,\n+    operations: &[FileOperation],\n+) -> Result<FileIdentityTransition, ProjectIdentityError> {\n+    validate_proposal_id(proposal_id)?;\n+    let base_entries: BTreeMap<Vec<u8>, &SourceEntry> = base\n+        .entries()\n+        .iter()\n+        .map(|entry| (entry.path().to_vec(), entry))\n+        .collect();\n+    let result_entries: BTreeMap<Vec<u8>, &SourceEntry> = result\n+        .entries()\n+        .iter()\n+        .map(|entry| (entry.path().to_vec(), entry))\n+        .collect();\n+    if base_entries.keys().any(|path| !base_ids.contains_key(path)) {\n+        let path = base_entries\n+            .keys()\n+            .find(|path| !base_ids.contains_key(*path))\n+            .unwrap();\n+        return Err(ProjectIdentityError::UnknownBasePath(HEXLOWER.encode(path)));\n+    }\n+    if base_ids.len() != base_entries.len()\n+        || base_ids.keys().any(|path| !base_entries.contains_key(path))\n+    {\n+        return Err(ProjectIdentityError::BaseIdentitySetMismatch);\n+    }\n+    let unique_base_ids: BTreeSet<FileId> = base_ids.values().cloned().collect();\n+    if unique_base_ids.len() != base_ids.len() {\n+        return Err(ProjectIdentityError::DuplicateBaseFileId);\n+    }\n+\n+    let mut operation_by_destination: BTreeMap<Vec<u8>, (IdentityRelation, FileId, Vec<FileId>)> =\n+        BTreeMap::new();\n+    let mut operation_by_source: BTreeMap<Vec<u8>, (IdentityRelation, Vec<Vec<u8>>)> =\n+        BTreeMap::new();\n+    let mut used_paths = BTreeSet::new();\n+    for operation in operations {\n+        match operation {\n+            FileOperation::Rename { from, to } => {\n+                let before = base_entries.get(from).ok_or_else(|| {\n+                    ProjectIdentityError::InvalidOperation(\n+                        \"rename source is absent from the exact base snapshot\".into(),\n+                    )\n+                })?;\n+                let after = result_entries.get(to).ok_or_else(|| {\n+                    ProjectIdentityError::InvalidOperation(\n+                        \"rename destination is absent from the exact result snapshot\".into(),\n+                    )\n+                })?;\n+                if base_entries.contains_key(to)\n+                    || result_entries.contains_key(from)\n+                    || !same_content(before, after)\n+                    || !used_paths.insert(from.clone())\n+                    || !used_paths.insert(to.clone())\n+                {\n+                    return Err(ProjectIdentityError::InvalidOperation(\n+                        \"rename needs one removed source and one new destination with identical mode and content\".into(),\n+                    ));\n+                }\n+                operation_by_destination.insert(\n+                    to.clone(),\n+                    (\n+                        IdentityRelation::ExplicitRename,\n+                        base_ids[from].clone(),\n+                        Vec::new(),\n+                    ),\n+                );\n+                operation_by_source.insert(\n+                    from.clone(),\n+                    (IdentityRelation::ExplicitRename, vec![to.clone()]),\n+                );\n+            }\n+            FileOperation::Copy { from, to } => {\n+                let before = base_entries.get(from).ok_or_else(|| {\n+                    ProjectIdentityError::InvalidOperation(\n+                        \"copy source is absent from the exact base snapshot\".into(),\n+                    )\n+                })?;\n+                let source_after = result_entries.get(from).ok_or_else(|| {\n+                    ProjectIdentityError::InvalidOperation(\n+                        \"copy source is absent from the result snapshot\".into(),\n+                    )\n+                })?;\n+                let copied = result_entries.get(to).ok_or_else(|| {\n+                    ProjectIdentityError::InvalidOperation(\n+                        \"copy destination is absent from the exact result snapshot\".into(),\n+                    )\n+                })?;\n+                if base_entries.contains_key(to)\n+                    || !same_content(before, source_after)\n+                    || !same_content(before, copied)\n+                    || !used_paths.insert(to.clone())\n+                {\n+                    return Err(ProjectIdentityError::InvalidOperation(\n+                        \"copy needs an unchanged source and a new destination with identical mode and content\".into(),\n+                    ));\n+                }\n+                operation_by_destination.insert(\n+                    to.clone(),\n+                    (\n+                        IdentityRelation::ExplicitCopy,\n+                        FileId::proposed(project_id, proposal_id, &result.id(), 0, to),\n+                        vec![base_ids[from].clone()],\n+                    ),\n+                );\n+            }\n+            FileOperation::Split { from, to } => {\n+                let _before = base_entries.get(from).ok_or_else(|| {\n+                    ProjectIdentityError::InvalidOperation(\n+                        \"split source is absent from the exact base snapshot\".into(),\n+                    )\n+                })?;\n+                if result_entries.contains_key(from)\n+                    || to.len() < 2\n+                    || !used_paths.insert(from.clone())\n+                {\n+                    return Err(ProjectIdentityError::InvalidOperation(\n+                        \"split needs a removed source and at least two new result paths\".into(),\n+                    ));\n+                }\n+                let mut destinations = to.clone();\n+                destinations.sort();\n+                destinations.dedup();\n+                if destinations.len() != to.len() {\n+                    return Err(ProjectIdentityError::InvalidOperation(\n+                        \"split destinations repeat\".into(),\n+                    ));\n+                }\n+                for (ordinal, path) in destinations.iter().enumerate() {\n+                    if base_entries.contains_key(path)\n+                        || !result_entries.contains_key(path)\n+                        || !used_paths.insert(path.clone())\n+                    {\n+                        return Err(ProjectIdentityError::InvalidOperation(\n+                            \"split destinations must be new, unique paths in the result snapshot\"\n+                                .into(),\n+                        ));\n+                    }\n+                    operation_by_destination.insert(\n+                        path.clone(),\n+                        (\n+                            IdentityRelation::ExplicitSplit,\n+                            FileId::proposed(\n+                                project_id,\n+                                proposal_id,\n+                                &result.id(),\n+                                ordinal as u64,\n+                                path,\n+                            ),\n+                            vec![base_ids[from].clone()],\n+                        ),\n+                    );\n+                }\n+                operation_by_source.insert(\n+                    from.clone(),\n+                    (IdentityRelation::ExplicitSplit, destinations),\n+                );\n+            }\n+        }\n+    }\n+\n+    let mut ordinals = BTreeMap::new();\n+    let mut ordinal = 0_u64;\n+    for path in result_entries\n+        .keys()\n+        .filter(|path| !base_entries.contains_key(*path))\n+    {\n+        ordinals.insert(path.clone(), ordinal);\n+        ordinal += 1;\n+    }\n+    let mut result_files = Vec::with_capacity(result_entries.len());\n+    for (path, entry) in &result_entries {\n+        let identity = if let Some(existing) = base_ids.get(path) {\n+            existing.clone()\n+        } else if let Some((_, id, _)) = operation_by_destination.get(path) {\n+            id.clone()\n+        } else {\n+            FileId::proposed(project_id, proposal_id, &result.id(), ordinals[path], path)\n+        };\n+        result_files.push(FileState {\n+            path: path.clone(),\n+            kind: entry.kind(),\n+            content_sha256: *entry.content_sha256(),\n+            file_id: identity,\n+        });\n+    }\n+    let result_by_path: BTreeMap<Vec<u8>, FileState> = result_files\n+        .iter()\n+        .cloned()\n+        .map(|state| (state.path.clone(), state))\n+        .collect();\n+\n+    let mut changes = Vec::new();\n+    let mut explicitly_renamed_sources = BTreeSet::new();\n+    for (path, before_entry) in &base_entries {\n+        let before_state = FileState {\n+            path: path.clone(),\n+            kind: before_entry.kind(),\n+            content_sha256: *before_entry.content_sha256(),\n+            file_id: base_ids[path].clone(),\n+        };\n+        if let Some((relation, destinations)) = operation_by_source.get(path) {\n+            explicitly_renamed_sources.insert(path.clone());\n+            if *relation == IdentityRelation::ExplicitRename {\n+                let after = result_by_path[&destinations[0]].clone();\n+                changes.push(FileChange {\n+                    before: Some(before_state),\n+                    after: Some(after),\n+                    relation: *relation,\n+                    derived_from: Vec::new(),\n+                    possible_sources: Vec::new(),\n+                });\n+            } else {\n+                changes.push(FileChange {\n+                    before: Some(before_state),\n+                    after: None,\n+                    relation: IdentityRelation::Removed,\n+                    derived_from: Vec::new(),\n+                    possible_sources: Vec::new(),\n+                });\n+            }\n+            continue;\n+        }\n+        match result_by_path.get(path) {\n+            Some(after)\n+                if before_state.kind == after.kind\n+                    && before_state.content_sha256 == after.content_sha256 => {}\n+            Some(after) => changes.push(FileChange {\n+                before: Some(before_state),\n+                after: Some(after.clone()),\n+                relation: IdentityRelation::SamePath,\n+                derived_from: Vec::new(),\n+                possible_sources: Vec::new(),\n+            }),\n+            None => changes.push(FileChange {\n+                before: Some(before_state),\n+                after: None,\n+                relation: IdentityRelation::Removed,\n+                derived_from: Vec::new(),\n+                possible_sources: Vec::new(),\n+            }),\n+        }\n+    }\n+    for (path, after) in &result_by_path {\n+        if base_entries.contains_key(path) {\n+            continue;\n+        }\n+        if let Some((relation, _, derived_from)) = operation_by_destination.get(path) {\n+            let before = if *relation == IdentityRelation::ExplicitRename {\n+                let source = operation_by_source.iter().find_map(\n+                    |(source, (source_relation, destinations))| {\n+                        (*source_relation == IdentityRelation::ExplicitRename\n+                            && destinations.first() == Some(path))\n+                        .then(|| {\n+                            let entry = base_entries[source];\n+                            FileState {\n+                                path: source.clone(),\n+                                kind: entry.kind(),\n+                                content_sha256: *entry.content_sha256(),\n+                                file_id: base_ids[source].clone(),\n+                            }\n+                        })\n+                    },\n+                );\n+            } else {\n+                None\n+            };\n+            if *relation == IdentityRelation::ExplicitRename {\n+                // The paired move was emitted from its source path.\n+                continue;\n+            }\n+            changes.push(FileChange {\n+                before,\n+                after: Some(after.clone()),\n+                relation: *relation,\n+                derived_from: derived_from.clone(),\n+                possible_sources: Vec::new(),\n+            });\n+        } else {\n+            let possible_sources: Vec<FileId> = base_entries\n+                .iter()\n+                .filter(|(source, entry)| {\n+                    !result_entries.contains_key(*source)\n+                        && same_content(entry, result_entries[path])\n+                })\n+                .map(|(source, _)| base_ids[source].clone())\n+                .collect();\n+            changes.push(FileChange {\n+                before: None,\n+                after: Some(after.clone()),\n+                relation: if possible_sources.is_empty() {\n+                    IdentityRelation::New\n+                } else {\n+                    IdentityRelation::UncertainRename\n+                },\n+                derived_from: Vec::new(),\n+                possible_sources,\n+            });\n+        }\n+    }\n+    changes.sort_by(|left, right| {\n+        change_sort_path(left)\n+            .cmp(change_sort_path(right))\n+            .then_with(|| left.relation.as_str().cmp(right.relation.as_str()))\n+    });\n+    Ok(FileIdentityTransition {\n+        project_id: project_id.clone(),\n+        proposal_id: proposal_id.to_string(),\n+        base: base.id(),\n+        result: result.id(),\n+        result_files,\n+        changes,\n+    })\n+}\n+\n+/// Refuse two independent proposals that create the same path, even when the\n+/// bytes match. Existing base paths remain for the composer to reconcile.\n+pub fn validate_file_proposals(\n+    proposals: &[FileIdentityTransition],\n+) -> Result<(), FileNamespaceConflict> {\n+    let Some(first) = proposals.first() else {\n+        return Ok(());\n+    };\n+    let mut proposal_ids = BTreeSet::new();\n+    let mut by_path: BTreeMap<Vec<u8>, BTreeSet<String>> = BTreeMap::new();\n+    for proposal in proposals {\n+        if proposal.project_id != first.project_id || proposal.base != first.base {\n+            return Err(FileNamespaceConflict {\n+                path: Vec::new(),\n+                proposal_ids: vec![first.proposal_id.clone(), proposal.proposal_id.clone()],\n+                kind: FileNamespaceConflictKind::IncompatibleNamespace,\n+            });\n+        }\n+        if !proposal_ids.insert(proposal.proposal_id.clone()) {\n+            return Err(FileNamespaceConflict {\n+                path: Vec::new(),\n+                proposal_ids: vec![proposal.proposal_id.clone()],\n+                kind: FileNamespaceConflictKind::DuplicateProposal,\n+            });\n+        }\n+        for change in &proposal.changes {\n+            if change.before.is_none()\n+                && change.after.is_some()\n+                && matches!(\n+                    change.relation,\n+                    IdentityRelation::New\n+                        | IdentityRelation::UncertainRename\n+                        | IdentityRelation::ExplicitCopy\n+                        | IdentityRelation::ExplicitSplit\n+                )\n+            {\n+                by_path\n+                    .entry(change.after.as_ref().unwrap().path.clone())\n+                    .or_default()\n+                    .insert(proposal.proposal_id.clone());\n+            }\n+        }\n+    }\n+    if let Some((path, proposal_ids)) = by_path.into_iter().find(|(_, ids)| ids.len() > 1) {\n+        return Err(FileNamespaceConflict {\n+            path,\n+            proposal_ids: proposal_ids.into_iter().collect(),\n+            kind: FileNamespaceConflictKind::CompetingPath,\n+        });\n+    }\n+    Ok(())\n+}\n+\n+#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n+pub enum FileNamespaceConflictKind {\n+    CompetingPath,\n+    IncompatibleNamespace,\n+    DuplicateProposal,\n+}\n+\n+#[derive(Debug, Clone, PartialEq, Eq, Error)]\n+#[error(\"file identity proposals are incompatible ({kind:?}) at path {}: {}\", HEXLOWER.encode(path), proposal_ids.join(\", \"))]\n+pub struct FileNamespaceConflict {\n+    pub path: Vec<u8>,\n+    pub proposal_ids: Vec<String>,\n+    pub kind: FileNamespaceConflictKind,\n+}\n+\n+#[derive(Debug, Error)]\n+pub enum ProjectIdentityError {\n+    #[error(\"invalid logical project ID {0:?}\")]\n+    InvalidProjectId(String),\n+    #[error(\"invalid FileId {0:?}\")]\n+    InvalidFileId(String),\n+    #[error(\"invalid anchor commit {0:?}; expected a full lowercase Git object ID\")]\n+    InvalidCommit(String),\n+    #[error(\"descriptor is {bytes} bytes; the profile limit is {MAX_DESCRIPTOR_BYTES}\")]\n+    DescriptorTooLarge { bytes: usize },\n+    #[error(\"descriptor contains {count} files; the profile limit is {MAX_DESCRIPTOR_FILES}\")]\n+    TooManyFiles { count: usize },\n+    #[error(\"descriptor must be a JSON object\")]\n+    NotAnObject,\n+    #[error(\"descriptor contains unknown field {0:?}\")]\n+    UnknownField(String),\n+    #[error(\"descriptor field {0} has the wrong type\")]\n+    WrongFieldType(&'static str),\n+    #[error(\"descriptor file entry is not an object\")]\n+    WrongFileEntry,\n+    #[error(\"descriptor file entry contains unknown field {0:?}\")]\n+    UnknownFileField(String),\n+    #[error(\"descriptor files must be in strict raw-byte path order\")]\n+    NonCanonicalFileOrder,\n+    #[error(\"base FileId map does not exactly cover the base source snapshot\")]\n+    BaseIdentitySetMismatch,\n+    #[error(\"base source snapshot assigns one FileId to more than one path\")]\n+    DuplicateBaseFileId,\n+    #[error(\"invalid descriptor file entry: {0}\")]\n+    InvalidFileEntry(String),\n+    #[error(\"descriptor has duplicate FileId {0}\")]\n+    DuplicateFileId(String),\n+    #[error(\"descriptor has an invalid source, policy, target, or visibility boundary\")]\n+    InvalidDescriptorBoundary,\n+    #[error(\"anchor snapshot mismatch: expected {expected}, found {actual}\")]\n+    AnchorSnapshotMismatch { expected: String, actual: String },\n+    #[error(\"anchor commit mismatch: expected {expected}, found {actual}\")]\n+    AnchorCommitMismatch { expected: String, actual: String },\n+    #[error(\"base snapshot has no FileId for path hex {0}\")]\n+    UnknownBasePath(String),\n+    #[error(\"invalid file operation: {0}\")]\n+    InvalidOperation(String),\n+    #[error(\"proposal ID must be 1–128 ASCII letters, digits, '.', '_', ':' or '-'\")]\n+    InvalidProposalId,\n+    #[error(\"record error: {0}\")]\n+    Record(#[from] RecordError),\n+    #[error(\"source snapshot error: {0}\")]\n+    Snapshot(#[from] SourceSnapshotError),\n+    #[error(\"canonical JSON error: {0}\")]\n+    Canonical(#[from] canonical_json::CanonicalJsonError),\n+    #[error(\"invalid anchor snapshot: {0}\")]\n+    InvalidAnchor(String),\n+}\n+\n+fn required_string(record: &Record, name: &'static str) -> Result<String, ProjectIdentityError> {\n+    match record.get(name) {\n+        Some(Value::String(value)) => Ok(value.clone()),\n+        _ => Err(ProjectIdentityError::WrongFieldType(name)),\n+    }\n+}\n+\n+fn required_object_string(\n+    object: &Object,\n+    name: &'static str,\n+) -> Result<String, ProjectIdentityError> {\n+    match object.get(name) {\n+        Some(Value::String(value)) => Ok(value.clone()),\n+        _ => Err(ProjectIdentityError::InvalidFileEntry(format!(\n+            \"field {name} must be a string\"\n+        ))),\n+    }\n+}\n+\n+fn text(value: &str) -> Value {\n+    Value::String(value.to_string())\n+}\n+\n+fn decode_hex(value: String, field: &'static str) -> Result<Vec<u8>, ProjectIdentityError> {\n+    HEXLOWER.decode(value.as_bytes()).map_err(|_| {\n+        ProjectIdentityError::InvalidFileEntry(format!(\"{field} must be lowercase hex\"))\n+    })\n+}\n+\n+fn validate_commit(value: &str) -> Result<(), ProjectIdentityError> {\n+    if (value.len() == 40 || value.len() == 64)\n+        && value\n+            .bytes()\n+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))\n+    {\n+        Ok(())\n+    } else {\n+        Err(ProjectIdentityError::InvalidCommit(value.to_string()))\n+    }\n+}\n+\n+fn validate_proposal_id(value: &str) -> Result<(), ProjectIdentityError> {\n+    let valid = !value.is_empty()\n+        && value.len() <= 128\n+        && value\n+            .bytes()\n+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'_' | b':' | b'-'));\n+    if valid {\n+        Ok(())\n+    } else {\n+        Err(ProjectIdentityError::InvalidProposalId)\n+    }\n+}\n+\n+fn same_content(left: &SourceEntry, right: &SourceEntry) -> bool {\n+    left.kind() == right.kind() && left.content_sha256() == right.content_sha256()\n+}\n+\n+fn change_sort_path(change: &FileChange) -> &[u8] {\n+    change\n+        .after\n+        .as_ref()\n+        .or(change.before.as_ref())\n+        .map(|state| state.path.as_slice())\n+        .unwrap_or_default()\n+}\n+\n+fn base32_value(byte: u8) -> Option<u8> {\n+    match byte {\n+        b'a'..=b'z' => Some(byte - b'a'),\n+        b'2'..=b'7' => Some(byte - b'2' + 26),\n+        _ => None,\n+    }\n+}"},{"sha":"02b2fdc0a50fad074b9ff0eac6152e45d7512bc4","filename":"packages/aethyme/rust/crates/aethyme-contracts/tests/contribution_revision.rs","status":"added","additions":54,"deletions":0,"changes":54,"blob_url":"https://github.com/schiste/Aethyme/blob/63a3aa3e533ba466f02f1deabd36b9d3feb88985/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ftests%2Fcontribution_revision.rs","raw_url":"https://github.com/schiste/Aethyme/raw/63a3aa3e533ba466f02f1deabd36b9d3feb88985/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ftests%2Fcontribution_revision.rs","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ftests%2Fcontribution_revision.rs?ref=63a3aa3e533ba466f02f1deabd36b9d3feb88985","patch":"@@ -0,0 +1,54 @@\n+//! Contribution revision qualification vectors for the bounded Local profile.\n+\n+use aethyme_contracts::experimental_v0::{\n+    BriefReference, ContributionRevision, EntryKind, ProjectId, RecordId, SourceEntry,\n+    SourceSnapshot,\n+};\n+\n+fn project() -> ProjectId {\n+    ProjectId::parse(\"proj:aaaaaaaaaaaaaaaaaaaaaaaaaa\").unwrap()\n+}\n+\n+#[test]\n+fn rationale_only_brief_change_creates_a_distinct_immutable_revision() {\n+    let snapshot = SourceSnapshot::new([SourceEntry::from_content(\n+        b\"src/lib.rs\".to_vec(),\n+        EntryKind::Regular,\n+        b\"fn main() {}\\n\",\n+    )])\n+    .unwrap();\n+    let contribution = RecordId::parse(&format!(\"sha256:{}\", \"1\".repeat(64))).unwrap();\n+    let original = ContributionRevision::new(\n+        project(),\n+        contribution.clone(),\n+        snapshot.id(),\n+        snapshot.id(),\n+        Vec::new(),\n+        None,\n+        Vec::new(),\n+    )\n+    .unwrap();\n+    let brief = BriefReference::new(\n+        RecordId::parse(&format!(\"sha256:{}\", \"2\".repeat(64))).unwrap(),\n+        \"3\".repeat(64),\n+    )\n+    .unwrap();\n+    let revised = ContributionRevision::new(\n+        project(),\n+        contribution,\n+        snapshot.id(),\n+        snapshot.id(),\n+        Vec::new(),\n+        Some(brief),\n+        Vec::new(),\n+    )\n+    .unwrap();\n+\n+    let (original_bytes, original_id) = original.to_record();\n+    let (revised_bytes, revised_id) = revised.to_record();\n+    assert_ne!(original_id, revised_id);\n+    assert_ne!(original_bytes, revised_bytes);\n+    let (decoded, decoded_id) = ContributionRevision::from_record(&revised_bytes).unwrap();\n+    assert_eq!(decoded, revised);\n+    assert_eq!(decoded_id, revised_id);\n+}"},{"sha":"bd9c13c87905d62bdbf9b438a3ac9a5eb79793dc","filename":"packages/aethyme/rust/crates/aethyme-contracts/tests/project_identity_vectors.rs","status":"added","additions":298,"deletions":0,"changes":298,"blob_url":"https://github.com/schiste/Aethyme/blob/63a3aa3e533ba466f02f1deabd36b9d3feb88985/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ftests%2Fproject_identity_vectors.rs","raw_url":"https://github.com/schiste/Aethyme/raw/63a3aa3e533ba466f02f1deabd36b9d3feb88985/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ftests%2Fproject_identity_vectors.rs","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ftests%2Fproject_identity_vectors.rs?ref=63a3aa3e533ba466f02f1deabd36b9d3feb88985","patch":"@@ -0,0 +1,298 @@\n+//! Project and FileId qualification vectors for the bounded Local profile.\n+\n+use std::collections::BTreeMap;\n+\n+use aethyme_contracts::experimental_v0::{\n+    EntryKind, FileId, FileOperation, IdentityRelation, ProjectDescriptor, ProjectId, SourceEntry,\n+    SourceSnapshot, advance_file_identities, validate_file_proposals,\n+};\n+use serde::Deserialize;\n+\n+#[derive(Deserialize)]\n+struct Fixture {\n+    descriptor: serde_json::Value,\n+    content_hex: String,\n+    descriptor_record_id: String,\n+}\n+\n+fn fixture() -> Fixture {\n+    serde_json::from_str(include_str!(\n+        \"../fixtures/experimental-v0/project_identity.json\"\n+    ))\n+    .expect(\"independent project identity fixture parses\")\n+}\n+\n+fn hex(bytes: &[u8]) -> Vec<u8> {\n+    data_encoding::HEXLOWER.decode(bytes).expect(\"fixture hex\")\n+}\n+\n+fn project() -> ProjectId {\n+    ProjectId::parse(\"proj:aaaaaaaaaaaaaaaaaaaaaaaaaa\").unwrap()\n+}\n+\n+fn snapshot(files: &[(&[u8], &[u8])]) -> SourceSnapshot {\n+    SourceSnapshot::new(files.iter().map(|(path, content)| {\n+        SourceEntry::from_content(path.to_vec(), EntryKind::Regular, content)\n+    }))\n+    .unwrap()\n+}\n+\n+#[test]\n+fn independent_descriptor_vector_round_trips_exactly() {\n+    let fixture = fixture();\n+    let content = hex(fixture.content_hex.as_bytes());\n+    let source = SourceSnapshot::new([SourceEntry::from_content(\n+        b\"src/lib.rs\".to_vec(),\n+        EntryKind::Regular,\n+        &content,\n+    )])\n+    .unwrap();\n+    let descriptor = ProjectDescriptor::from_snapshot(\n+        project(),\n+        \"1111111111111111111111111111111111111111\",\n+        &source,\n+    )\n+    .unwrap();\n+    let (bytes, id) = descriptor.to_record();\n+    assert_eq!(id.as_str(), fixture.descriptor_record_id);\n+    assert_eq!(\n+        serde_json::from_slice::<serde_json::Value>(&bytes).unwrap(),\n+        fixture.descriptor\n+    );\n+    let (decoded, decoded_id) = ProjectDescriptor::from_record(&bytes).unwrap();\n+    assert_eq!(decoded, descriptor);\n+    assert_eq!(decoded_id, id);\n+}\n+\n+#[test]\n+fn file_ids_align_only_under_the_same_explicit_project_mapping() {\n+    let source = snapshot(&[(b\"src/a.rs\", b\"same\")]);\n+    let project_a = project();\n+    let project_b = ProjectId::parse(&format!(\"proj:{}a\", \"b\".repeat(25))).unwrap();\n+    let a = ProjectDescriptor::from_snapshot(\n+        project_a,\n+        \"1111111111111111111111111111111111111111\",\n+        &source,\n+    )\n+    .unwrap();\n+    let b = ProjectDescriptor::from_snapshot(\n+        project_b,\n+        \"1111111111111111111111111111111111111111\",\n+        &source,\n+    )\n+    .unwrap();\n+    assert_ne!(a.files()[0].file_id, b.files()[0].file_id);\n+\n+    let mapped_clone = ProjectDescriptor::from_snapshot(\n+        project(),\n+        \"1111111111111111111111111111111111111111\",\n+        &source,\n+    )\n+    .unwrap();\n+    assert_eq!(a.files()[0].file_id, mapped_clone.files()[0].file_id);\n+}\n+\n+#[test]\n+fn exact_rename_preserves_id_but_unannotated_rename_stays_uncertain() {\n+    let base = snapshot(&[(b\"old.rs\", b\"same bytes\"), (b\"keep.rs\", b\"keep\")]);\n+    let descriptor = ProjectDescriptor::from_snapshot(\n+        project(),\n+        \"1111111111111111111111111111111111111111\",\n+        &base,\n+    )\n+    .unwrap();\n+    let base_ids = descriptor.file_map();\n+    let renamed = snapshot(&[(b\"new.rs\", b\"same bytes\"), (b\"keep.rs\", b\"keep\")]);\n+\n+    let explicit = advance_file_identities(\n+        &project(),\n+        \"proposal-rename\",\n+        &base,\n+        &renamed,\n+        &base_ids,\n+        &[FileOperation::Rename {\n+            from: b\"old.rs\".to_vec(),\n+            to: b\"new.rs\".to_vec(),\n+        }],\n+    )\n+    .unwrap();\n+    assert_eq!(\n+        explicit\n+            .result_files\n+            .iter()\n+            .find(|file| file.path == b\"new.rs\")\n+            .unwrap()\n+            .file_id,\n+        base_ids[b\"old.rs\"]\n+    );\n+    assert!(\n+        explicit\n+            .changes\n+            .iter()\n+            .any(|change| change.relation == IdentityRelation::ExplicitRename)\n+    );\n+\n+    let inferred = advance_file_identities(\n+        &project(),\n+        \"proposal-inferred\",\n+        &base,\n+        &renamed,\n+        &base_ids,\n+        &[],\n+    )\n+    .unwrap();\n+    let old_id = &base_ids[b\"old.rs\"];\n+    let new_id = &inferred\n+        .result_files\n+        .iter()\n+        .find(|file| file.path == b\"new.rs\")\n+        .unwrap()\n+        .file_id;\n+    assert_ne!(old_id, new_id);\n+    assert!(inferred.changes.iter().any(|change| {\n+        change.relation == IdentityRelation::UncertainRename\n+            && change.possible_sources == vec![old_id.clone()]\n+    }));\n+}\n+\n+#[test]\n+fn edited_rename_is_not_claimed_as_a_validated_rename() {\n+    let base = snapshot(&[(b\"old.rs\", b\"before\")]);\n+    let descriptor = ProjectDescriptor::from_snapshot(\n+        project(),\n+        \"1111111111111111111111111111111111111111\",\n+        &base,\n+    )\n+    .unwrap();\n+    let result = snapshot(&[(b\"new.rs\", b\"after\")]);\n+    assert!(\n+        advance_file_identities(\n+            &project(),\n+            \"proposal-edited-rename\",\n+            &base,\n+            &result,\n+            &descriptor.file_map(),\n+            &[FileOperation::Rename {\n+                from: b\"old.rs\".to_vec(),\n+                to: b\"new.rs\".to_vec(),\n+            }],\n+        )\n+        .is_err()\n+    );\n+    let unknown = advance_file_identities(\n+        &project(),\n+        \"proposal-unknown-edit\",\n+        &base,\n+        &result,\n+        &descriptor.file_map(),\n+        &[],\n+    )\n+    .unwrap();\n+    assert!(\n+        unknown\n+            .changes\n+            .iter()\n+            .any(|change| change.relation == IdentityRelation::New)\n+    );\n+}\n+\n+#[test]\n+fn copy_and_split_create_new_ids_with_explicit_derivation() {\n+    let base = snapshot(&[(b\"source.rs\", b\"original\")]);\n+    let descriptor = ProjectDescriptor::from_snapshot(\n+        project(),\n+        \"1111111111111111111111111111111111111111\",\n+        &base,\n+    )\n+    .unwrap();\n+    let base_ids = descriptor.file_map();\n+    let copy_result = snapshot(&[(b\"copy.rs\", b\"original\"), (b\"source.rs\", b\"original\")]);\n+    let copy = advance_file_identities(\n+        &project(),\n+        \"proposal-copy\",\n+        &base,\n+        &copy_result,\n+        &base_ids,\n+        &[FileOperation::Copy {\n+            from: b\"source.rs\".to_vec(),\n+            to: b\"copy.rs\".to_vec(),\n+        }],\n+    )\n+    .unwrap();\n+    let copied = copy\n+        .result_files\n+        .iter()\n+        .find(|file| file.path == b\"copy.rs\")\n+        .unwrap();\n+    assert_ne!(copied.file_id, base_ids[b\"source.rs\"]);\n+    assert!(copy.changes.iter().any(|change| {\n+        change.relation == IdentityRelation::ExplicitCopy\n+            && change.derived_from == vec![base_ids[b\"source.rs\"].clone()]\n+    }));\n+\n+    let split_result = snapshot(&[(b\"part-a.rs\", b\"first\"), (b\"part-b.rs\", b\"second\")]);\n+    let split = advance_file_identities(\n+        &project(),\n+        \"proposal-split\",\n+        &base,\n+        &split_result,\n+        &base_ids,\n+        &[FileOperation::Split {\n+            from: b\"source.rs\".to_vec(),\n+            to: vec![b\"part-a.rs\".to_vec(), b\"part-b.rs\".to_vec()],\n+        }],\n+    )\n+    .unwrap();\n+    let ids: Vec<&FileId> = split\n+        .result_files\n+        .iter()\n+        .map(|file| &file.file_id)\n+        .collect();\n+    assert_eq!(ids.len(), 2);\n+    assert_ne!(ids[0], ids[1]);\n+    assert!(\n+        split\n+            .changes\n+            .iter()\n+            .filter(|change| { change.relation == IdentityRelation::ExplicitSplit })\n+            .all(|change| change.derived_from == vec![base_ids[b\"source.rs\"].clone()])\n+    );\n+}\n+\n+#[test]\n+fn competing_new_files_at_the_same_path_conflict_even_with_equal_bytes() {\n+    let base = snapshot(&[(b\"base.rs\", b\"base\")]);\n+    let descriptor = ProjectDescriptor::from_snapshot(\n+        project(),\n+        \"1111111111111111111111111111111111111111\",\n+        &base,\n+    )\n+    .unwrap();\n+    let base_ids = descriptor.file_map();\n+    let result = snapshot(&[(b\"base.rs\", b\"base\"), (b\"new.rs\", b\"same\")]);\n+    let left = advance_file_identities(&project(), \"proposal-left\", &base, &result, &base_ids, &[])\n+        .unwrap();\n+    let right =\n+        advance_file_identities(&project(), \"proposal-right\", &base, &result, &base_ids, &[])\n+            .unwrap();\n+    let conflict = validate_file_proposals(&[left, right]).unwrap_err();\n+    assert_eq!(conflict.path, b\"new.rs\");\n+    assert_eq!(conflict.proposal_ids, [\"proposal-left\", \"proposal-right\"]);\n+}\n+\n+#[test]\n+fn unrelated_file_id_map_members_are_refused() {\n+    let base = snapshot(&[(b\"a.rs\", b\"a\")]);\n+    let result = snapshot(&[(b\"a.rs\", b\"a\")]);\n+    let mut ids = BTreeMap::from([(\n+        b\"a.rs\".to_vec(),\n+        FileId::parse(\n+            \"file:sha256:fd0ee6dc0f6b45715b845b427f345007bd60c53f1b75196d94be53bec48ed33e\",\n+        )\n+        .unwrap(),\n+    )]);\n+    ids.insert(b\"extra.rs\".to_vec(), ids[b\"a.rs\"].clone());\n+    assert!(\n+        advance_file_identities(&project(), \"proposal-extra\", &base, &result, &ids, &[]).is_err()\n+    );\n+}"}]}