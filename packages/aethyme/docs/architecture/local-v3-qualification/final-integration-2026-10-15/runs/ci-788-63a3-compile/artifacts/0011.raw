{"sha":"5ebe8d315062c7db0855bfa760a0379012a51743","node_id":"C_kwDOQ07FcNoAKDVlYmU4ZDMxNTA2MmM3ZGIwODU1YmZhNzYwYTAzNzkwMTJhNTE3NDM","commit":{"author":{"name":"Christophe Henner","email":"christophehenner@gmail.com","date":"2026-10-16T00:44:17Z"},"committer":{"name":"Christophe Henner","email":"christophehenner@gmail.com","date":"2026-10-16T00:44:17Z"},"message":"fix(contracts): bind local file identity state\n\nProblem\nRaw FileId maps could be paired with a different project, extensions could change descriptor IDs on re-encoding, and callers could forge transition change lists. ContributionRevision also used a digest RecordId as the logical ContributionId.\n\nDecision\nCarry FileId maps in opaque project and snapshot-bound state, expose transition fields read-only, reject unsupported descriptor extensions, and give logical contributions a separate contrib: identifier plus an explicit legacy capture-record link.\n\nRationale\nThe Local experimental profile must preserve identity ownership and immutable revision relationships without accepting caller-asserted mappings or silently changing record digests.\n\nValidation\nrustfmt --edition 2024 on the changed contract files; git diff --check. Cargo/build/runtime tests were not run under the current lease.","tree":{"sha":"0ae19379893f10b6e3499c60a29f2252129019de","url":"https://api.github.com/repos/schiste/Aethyme/git/trees/0ae19379893f10b6e3499c60a29f2252129019de"},"url":"https://api.github.com/repos/schiste/Aethyme/git/commits/5ebe8d315062c7db0855bfa760a0379012a51743","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/schiste/Aethyme/commits/5ebe8d315062c7db0855bfa760a0379012a51743","html_url":"https://github.com/schiste/Aethyme/commit/5ebe8d315062c7db0855bfa760a0379012a51743","comments_url":"https://api.github.com/repos/schiste/Aethyme/commits/5ebe8d315062c7db0855bfa760a0379012a51743/comments","author":{"login":"schiste","id":15890754,"node_id":"MDQ6VXNlcjE1ODkwNzU0","avatar_url":"https://avatars.githubusercontent.com/u/15890754?v=4","gravatar_id":"","url":"https://api.github.com/users/schiste","html_url":"https://github.com/schiste","followers_url":"https://api.github.com/users/schiste/followers","following_url":"https://api.github.com/users/schiste/following{/other_user}","gists_url":"https://api.github.com/users/schiste/gists{/gist_id}","starred_url":"https://api.github.com/users/schiste/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/schiste/subscriptions","organizations_url":"https://api.github.com/users/schiste/orgs","repos_url":"https://api.github.com/users/schiste/repos","events_url":"https://api.github.com/users/schiste/events{/privacy}","received_events_url":"https://api.github.com/users/schiste/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"schiste","id":15890754,"node_id":"MDQ6VXNlcjE1ODkwNzU0","avatar_url":"https://avatars.githubusercontent.com/u/15890754?v=4","gravatar_id":"","url":"https://api.github.com/users/schiste","html_url":"https://github.com/schiste","followers_url":"https://api.github.com/users/schiste/followers","following_url":"https://api.github.com/users/schiste/following{/other_user}","gists_url":"https://api.github.com/users/schiste/gists{/gist_id}","starred_url":"https://api.github.com/users/schiste/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/schiste/subscriptions","organizations_url":"https://api.github.com/users/schiste/orgs","repos_url":"https://api.github.com/users/schiste/repos","events_url":"https://api.github.com/users/schiste/events{/privacy}","received_events_url":"https://api.github.com/users/schiste/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"63a3aa3e533ba466f02f1deabd36b9d3feb88985","url":"https://api.github.com/repos/schiste/Aethyme/commits/63a3aa3e533ba466f02f1deabd36b9d3feb88985","html_url":"https://github.com/schiste/Aethyme/commit/63a3aa3e533ba466f02f1deabd36b9d3feb88985"}],"stats":{"total":359,"additions":299,"deletions":60},"files":[{"sha":"ef73e953a4af43ba8846f499abb5d7a1ab80194a","filename":"packages/aethyme/rust/crates/aethyme-contracts/src/experimental_v0/contribution_revision.rs","status":"modified","additions":68,"deletions":4,"changes":72,"blob_url":"https://github.com/schiste/Aethyme/blob/5ebe8d315062c7db0855bfa760a0379012a51743/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fcontribution_revision.rs","raw_url":"https://github.com/schiste/Aethyme/raw/5ebe8d315062c7db0855bfa760a0379012a51743/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fcontribution_revision.rs","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fcontribution_revision.rs?ref=5ebe8d315062c7db0855bfa760a0379012a51743","patch":"@@ -25,12 +25,48 @@ const fn field(name: &'static str, required: bool, kind: FieldKind) -> FieldSpec\n     }\n }\n \n+/// Random identity for one logical submitted intent. This is deliberately\n+/// distinct from the digest RecordId of any immutable revision.\n+#[derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]\n+pub struct ContributionId(String);\n+\n+impl ContributionId {\n+    pub fn parse(value: &str) -> Result<Self, ContributionRevisionError> {\n+        let encoded = value.strip_prefix(\"contrib:\").unwrap_or_default();\n+        let valid = encoded.len() == 26\n+            && encoded\n+                .bytes()\n+                .all(|byte| contribution_base32_value(byte).is_some())\n+            && encoded.as_bytes().last().is_some_and(|last| {\n+                contribution_base32_value(*last).is_some_and(|value| value % 4 == 0)\n+            });\n+        if valid {\n+            Ok(Self(value.to_string()))\n+        } else {\n+            Err(ContributionRevisionError::InvalidContributionId(\n+                value.to_string(),\n+            ))\n+        }\n+    }\n+\n+    pub fn as_str(&self) -> &str {\n+        &self.0\n+    }\n+}\n+\n+impl std::fmt::Display for ContributionId {\n+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n+        formatter.write_str(&self.0)\n+    }\n+}\n+\n /// Exact immutable payload for one revision of a logical contribution.\n pub static CONTRIBUTION_REVISION_SCHEMA: RecordSchema = RecordSchema {\n     name: CONTRIBUTION_REVISION_SCHEMA_NAME,\n     fields: &[\n         field(\"project_id\", true, FieldKind::String),\n         field(\"contribution_id\", true, FieldKind::String),\n+        field(\"capture_record_id\", true, FieldKind::String),\n         field(\"base\", true, FieldKind::String),\n         field(\"result\", true, FieldKind::String),\n         field(\"source_changes\", true, FieldKind::Opaque),\n@@ -71,7 +107,8 @@ impl BriefReference {\n #[derive(Debug, Clone, PartialEq, Eq)]\n pub struct ContributionRevision {\n     project_id: ProjectId,\n-    contribution_id: RecordId,\n+    contribution_id: ContributionId,\n+    capture_record_id: RecordId,\n     base: SourceSnapshotId,\n     result: SourceSnapshotId,\n     source_changes: Vec<Value>,\n@@ -82,7 +119,8 @@ pub struct ContributionRevision {\n impl ContributionRevision {\n     pub fn new(\n         project_id: ProjectId,\n-        contribution_id: RecordId,\n+        contribution_id: ContributionId,\n+        capture_record_id: RecordId,\n         base: SourceSnapshotId,\n         result: SourceSnapshotId,\n         source_changes: Vec<Value>,\n@@ -110,6 +148,7 @@ impl ContributionRevision {\n         Ok(Self {\n             project_id,\n             contribution_id,\n+            capture_record_id,\n             base,\n             result,\n             source_changes,\n@@ -122,10 +161,18 @@ impl ContributionRevision {\n         &self.project_id\n     }\n \n-    pub fn contribution_id(&self) -> &RecordId {\n+    pub fn contribution_id(&self) -> &ContributionId {\n         &self.contribution_id\n     }\n \n+    /// Exact legacy capture lineage this revision extends. This remains a\n+    /// separate identity from both the logical ContributionId and revision\n+    /// digest, allowing the adapter to join history without rewriting old\n+    /// capture records.\n+    pub fn capture_record_id(&self) -> &RecordId {\n+        &self.capture_record_id\n+    }\n+\n     pub fn base(&self) -> &SourceSnapshotId {\n         &self.base\n     }\n@@ -155,6 +202,10 @@ impl ContributionRevision {\n                 \"contribution_id\".into(),\n                 text(self.contribution_id.as_str()),\n             ),\n+            (\n+                \"capture_record_id\".into(),\n+                text(self.capture_record_id.as_str()),\n+            ),\n             (\"base\".into(), text(self.base.as_str())),\n             (\"result\".into(), text(self.result.as_str())),\n             (\n@@ -189,6 +240,7 @@ impl ContributionRevision {\n             \"schema\",\n             \"project_id\",\n             \"contribution_id\",\n+            \"capture_record_id\",\n             \"base\",\n             \"result\",\n             \"source_changes\",\n@@ -204,7 +256,8 @@ impl ContributionRevision {\n         }\n         let record = Record::decode(input, &[&CONTRIBUTION_REVISION_SCHEMA])?;\n         let project_id = ProjectId::parse(&required_string(&record, \"project_id\")?)?;\n-        let contribution_id = RecordId::parse(&required_string(&record, \"contribution_id\")?)?;\n+        let contribution_id = ContributionId::parse(&required_string(&record, \"contribution_id\")?)?;\n+        let capture_record_id = RecordId::parse(&required_string(&record, \"capture_record_id\")?)?;\n         let base = SourceSnapshotId::parse(&required_string(&record, \"base\")?)?;\n         let result = SourceSnapshotId::parse(&required_string(&record, \"result\")?)?;\n         let Value::Array(source_changes) = record.get(\"source_changes\").expect(\"schema checked\")\n@@ -231,6 +284,7 @@ impl ContributionRevision {\n         let revision = Self::new(\n             project_id,\n             contribution_id,\n+            capture_record_id,\n             base,\n             result,\n             source_changes.clone(),\n@@ -422,6 +476,14 @@ fn decode_hex(value: String, field: &'static str) -> Result<Vec<u8>, Contributio\n     Ok(bytes)\n }\n \n+fn contribution_base32_value(byte: u8) -> Option<u8> {\n+    match byte {\n+        b'a'..=b'z' => Some(byte - b'a'),\n+        b'2'..=b'7' => Some(byte - b'2' + 26),\n+        _ => None,\n+    }\n+}\n+\n #[derive(Debug, thiserror::Error)]\n pub enum ContributionRevisionError {\n     #[error(\"contribution revision exceeds the {MAX_CONTRIBUTION_REVISION_BYTES}-byte limit ({0})\")]\n@@ -440,6 +502,8 @@ pub enum ContributionRevisionError {\n     InvalidBriefDigest,\n     #[error(\"contribution revision has duplicate dependency IDs\")]\n     DuplicateDependency,\n+    #[error(\"invalid logical contribution ID {0:?}; expected contrib:<random 128-bit base32>\")]\n+    InvalidContributionId(String),\n     #[error(\"contribution revision has an invalid source change\")]\n     InvalidSourceChange,\n     #[error(\"contribution revision changes must be in strict raw-byte path order\")]"},{"sha":"3ac90e90be1c452f43d5e7de4459fe3ba2fd5511","filename":"packages/aethyme/rust/crates/aethyme-contracts/src/experimental_v0/mod.rs","status":"modified","additions":5,"deletions":2,"changes":7,"blob_url":"https://github.com/schiste/Aethyme/blob/5ebe8d315062c7db0855bfa760a0379012a51743/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fmod.rs","raw_url":"https://github.com/schiste/Aethyme/raw/5ebe8d315062c7db0855bfa760a0379012a51743/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fmod.rs","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fmod.rs?ref=5ebe8d315062c7db0855bfa760a0379012a51743","patch":"@@ -10,12 +10,15 @@ pub mod record;\n pub mod source_snapshot;\n pub mod symbol_identity;\n \n-pub use contribution_revision::{BriefReference, ContributionRevision, ContributionRevisionError};\n+pub use contribution_revision::{\n+    BriefReference, ContributionId, ContributionRevision, ContributionRevisionError,\n+};\n pub use digest::ID_PREFIX;\n pub use project_identity::{\n     EnrolledFile, FileChange, FileId, FileIdentityTransition, FileNamespaceConflict,\n     FileNamespaceConflictKind, FileOperation, FileState, IdentityRelation, ProjectDescriptor,\n-    ProjectId, ProjectIdentityError, advance_file_identities, validate_file_proposals,\n+    ProjectFileIdentityState, ProjectId, ProjectIdentityError, advance_file_identities,\n+    validate_file_proposals,\n };\n pub use record::{FieldKind, FieldSpec, Record, RecordError, RecordId, RecordSchema, StateReading};\n pub use source_snapshot::{"},{"sha":"27e5ad0984b88c51d19fca0f28d1d77d534acfd4","filename":"packages/aethyme/rust/crates/aethyme-contracts/src/experimental_v0/project_identity.rs","status":"modified","additions":139,"deletions":19,"changes":158,"blob_url":"https://github.com/schiste/Aethyme/blob/5ebe8d315062c7db0855bfa760a0379012a51743/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fproject_identity.rs","raw_url":"https://github.com/schiste/Aethyme/raw/5ebe8d315062c7db0855bfa760a0379012a51743/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fproject_identity.rs","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Fsrc%2Fexperimental_v0%2Fproject_identity.rs?ref=5ebe8d315062c7db0855bfa760a0379012a51743","patch":"@@ -205,6 +205,36 @@ impl ProjectDescriptor {\n             .collect()\n     }\n \n+    /// Build the opaque initial identity state for this exact enrollment.\n+    /// This mapping value is not proof that the descriptor was approved or\n+    /// associated with another clone; the broker must validate the committed\n+    /// binding before using it as established local history.\n+    pub fn initial_file_identity_state(\n+        &self,\n+    ) -> Result<ProjectFileIdentityState, ProjectIdentityError> {\n+        self.validate()?;\n+        let files = self\n+            .files\n+            .iter()\n+            .map(|file| {\n+                (\n+                    file.path.clone(),\n+                    FileState {\n+                        path: file.path.clone(),\n+                        kind: file.kind,\n+                        content_sha256: file.content_sha256,\n+                        file_id: file.file_id.clone(),\n+                    },\n+                )\n+            })\n+            .collect();\n+        Ok(ProjectFileIdentityState {\n+            project_id: self.project_id.clone(),\n+            snapshot: self.anchor_snapshot.clone(),\n+            files,\n+        })\n+    }\n+\n     pub fn anchor_source(&self) -> Result<SourceSnapshot, ProjectIdentityError> {\n         SourceSnapshot::new(self.files.iter().map(|file| {\n             SourceEntry::from_content_digest(file.path.clone(), file.kind, file.content_sha256)\n@@ -282,6 +312,13 @@ impl ProjectDescriptor {\n         {\n             return Err(ProjectIdentityError::UnknownField(name.to_string()));\n         }\n+        // This experimental descriptor is a closed profile. The generic\n+        // record envelope can carry extensions, but this typed value cannot\n+        // yet preserve them, so accepting one would change the RecordId on\n+        // re-encoding.\n+        if raw.get(\"extensions\").is_some() {\n+            return Err(ProjectIdentityError::ExtensionsUnsupported);\n+        }\n         let record = Record::decode(input, &[&PROJECT_DESCRIPTOR_SCHEMA])?;\n         let project_id = ProjectId::parse(required_string(&record, \"project_id\")?)?;\n         let anchor_commit = required_string(&record, \"anchor_commit\")?;\n@@ -413,6 +450,34 @@ pub struct FileState {\n     pub file_id: FileId,\n }\n \n+/// Opaque FileId map tied to one logical project and one exact snapshot.\n+/// Only a descriptor or a validated transition can create this value, so a\n+/// caller cannot attach an arbitrary map to a chosen ProjectId.\n+#[derive(Debug, Clone, PartialEq, Eq)]\n+pub struct ProjectFileIdentityState {\n+    project_id: ProjectId,\n+    snapshot: SourceSnapshotId,\n+    files: BTreeMap<Vec<u8>, FileState>,\n+}\n+\n+impl ProjectFileIdentityState {\n+    pub fn project_id(&self) -> &ProjectId {\n+        &self.project_id\n+    }\n+\n+    pub fn snapshot(&self) -> &SourceSnapshotId {\n+        &self.snapshot\n+    }\n+\n+    pub fn files(&self) -> impl Iterator<Item = &FileState> {\n+        self.files.values()\n+    }\n+\n+    pub fn file_id(&self, path: &[u8]) -> Option<&FileId> {\n+        self.files.get(path).map(|file| &file.file_id)\n+    }\n+}\n+\n #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n pub enum IdentityRelation {\n     SamePath,\n@@ -501,48 +566,97 @@ pub enum FileOperation {\n \n #[derive(Debug, Clone, PartialEq, Eq)]\n pub struct FileIdentityTransition {\n-    pub project_id: ProjectId,\n-    pub proposal_id: String,\n-    pub base: SourceSnapshotId,\n-    pub result: SourceSnapshotId,\n-    pub result_files: Vec<FileState>,\n-    pub changes: Vec<FileChange>,\n+    project_id: ProjectId,\n+    proposal_id: String,\n+    base: SourceSnapshotId,\n+    result: SourceSnapshotId,\n+    result_files: Vec<FileState>,\n+    changes: Vec<FileChange>,\n+}\n+\n+impl FileIdentityTransition {\n+    pub fn project_id(&self) -> &ProjectId {\n+        &self.project_id\n+    }\n+\n+    pub fn proposal_id(&self) -> &str {\n+        &self.proposal_id\n+    }\n+\n+    pub fn base(&self) -> &SourceSnapshotId {\n+        &self.base\n+    }\n+\n+    pub fn result(&self) -> &SourceSnapshotId {\n+        &self.result\n+    }\n+\n+    pub fn result_files(&self) -> &[FileState] {\n+        &self.result_files\n+    }\n+\n+    pub fn changes(&self) -> &[FileChange] {\n+        &self.changes\n+    }\n+\n+    pub fn result_identity_state(&self) -> ProjectFileIdentityState {\n+        ProjectFileIdentityState {\n+            project_id: self.project_id.clone(),\n+            snapshot: self.result.clone(),\n+            files: self\n+                .result_files\n+                .iter()\n+                .cloned()\n+                .map(|file| (file.path.clone(), file))\n+                .collect(),\n+        }\n+    }\n }\n \n /// Advance file identities from an exact, previously known base. Unspecified\n /// delete/add pairs are never treated as renames; exact-content matches are\n /// surfaced as uncertain candidates until an explicit operation is supplied.\n pub fn advance_file_identities(\n     project_id: &ProjectId,\n+    base_state: &ProjectFileIdentityState,\n     proposal_id: &str,\n     base: &SourceSnapshot,\n     result: &SourceSnapshot,\n-    base_ids: &BTreeMap<Vec<u8>, FileId>,\n     operations: &[FileOperation],\n ) -> Result<FileIdentityTransition, ProjectIdentityError> {\n     validate_proposal_id(proposal_id)?;\n+    if &base_state.project_id != project_id {\n+        return Err(ProjectIdentityError::ForeignProjectState);\n+    }\n+    if base_state.snapshot != base.id() {\n+        return Err(ProjectIdentityError::BaseIdentitySnapshotMismatch);\n+    }\n     let base_entries: BTreeMap<Vec<u8>, &SourceEntry> = base\n         .entries()\n         .iter()\n         .map(|entry| (entry.path().to_vec(), entry))\n         .collect();\n+    if base_state.files.len() != base_entries.len()\n+        || base_entries.iter().any(|(path, entry)| {\n+            base_state.files.get(path).map_or(true, |state| {\n+                state.path != *path\n+                    || state.kind != entry.kind()\n+                    || state.content_sha256 != *entry.content_sha256()\n+            })\n+        })\n+    {\n+        return Err(ProjectIdentityError::BaseIdentitySnapshotMismatch);\n+    }\n+    let base_ids: BTreeMap<Vec<u8>, FileId> = base_state\n+        .files\n+        .iter()\n+        .map(|(path, state)| (path.clone(), state.file_id.clone()))\n+        .collect();\n     let result_entries: BTreeMap<Vec<u8>, &SourceEntry> = result\n         .entries()\n         .iter()\n         .map(|entry| (entry.path().to_vec(), entry))\n         .collect();\n-    if base_entries.keys().any(|path| !base_ids.contains_key(path)) {\n-        let path = base_entries\n-            .keys()\n-            .find(|path| !base_ids.contains_key(*path))\n-            .unwrap();\n-        return Err(ProjectIdentityError::UnknownBasePath(HEXLOWER.encode(path)));\n-    }\n-    if base_ids.len() != base_entries.len()\n-        || base_ids.keys().any(|path| !base_entries.contains_key(path))\n-    {\n-        return Err(ProjectIdentityError::BaseIdentitySetMismatch);\n-    }\n     let unique_base_ids: BTreeSet<FileId> = base_ids.values().cloned().collect();\n     if unique_base_ids.len() != base_ids.len() {\n         return Err(ProjectIdentityError::DuplicateBaseFileId);\n@@ -916,6 +1030,8 @@ pub enum ProjectIdentityError {\n     NotAnObject,\n     #[error(\"descriptor contains unknown field {0:?}\")]\n     UnknownField(String),\n+    #[error(\"descriptor extensions are unsupported by this closed experimental profile\")]\n+    ExtensionsUnsupported,\n     #[error(\"descriptor field {0} has the wrong type\")]\n     WrongFieldType(&'static str),\n     #[error(\"descriptor file entry is not an object\")]\n@@ -926,6 +1042,10 @@ pub enum ProjectIdentityError {\n     NonCanonicalFileOrder,\n     #[error(\"base FileId map does not exactly cover the base source snapshot\")]\n     BaseIdentitySetMismatch,\n+    #[error(\"FileId state belongs to a different project than the requested transition\")]\n+    ForeignProjectState,\n+    #[error(\"FileId state does not describe the exact supplied base snapshot\")]\n+    BaseIdentitySnapshotMismatch,\n     #[error(\"base source snapshot assigns one FileId to more than one path\")]\n     DuplicateBaseFileId,\n     #[error(\"invalid descriptor file entry: {0}\")]"},{"sha":"aae6686bc5996dd50b3eabd824e660aa8e88ac6a","filename":"packages/aethyme/rust/crates/aethyme-contracts/tests/contribution_revision.rs","status":"modified","additions":6,"deletions":3,"changes":9,"blob_url":"https://github.com/schiste/Aethyme/blob/5ebe8d315062c7db0855bfa760a0379012a51743/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ftests%2Fcontribution_revision.rs","raw_url":"https://github.com/schiste/Aethyme/raw/5ebe8d315062c7db0855bfa760a0379012a51743/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ftests%2Fcontribution_revision.rs","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ftests%2Fcontribution_revision.rs?ref=5ebe8d315062c7db0855bfa760a0379012a51743","patch":"@@ -1,8 +1,8 @@\n //! Contribution revision qualification vectors for the bounded Local profile.\n \n use aethyme_contracts::experimental_v0::{\n-    BriefReference, ContributionRevision, EntryKind, ProjectId, RecordId, SourceEntry,\n-    SourceSnapshot,\n+    BriefReference, ContributionId, ContributionRevision, EntryKind, ProjectId, RecordId,\n+    SourceEntry, SourceSnapshot,\n };\n \n fn project() -> ProjectId {\n@@ -17,10 +17,12 @@ fn rationale_only_brief_change_creates_a_distinct_immutable_revision() {\n         b\"fn main() {}\\n\",\n     )])\n     .unwrap();\n-    let contribution = RecordId::parse(&format!(\"sha256:{}\", \"1\".repeat(64))).unwrap();\n+    let contribution = ContributionId::parse(&format!(\"contrib:{}\", \"b\".repeat(25) + \"e\")).unwrap();\n+    let capture_record_id = RecordId::parse(&format!(\"sha256:{}\", \"1\".repeat(64))).unwrap();\n     let original = ContributionRevision::new(\n         project(),\n         contribution.clone(),\n+        capture_record_id.clone(),\n         snapshot.id(),\n         snapshot.id(),\n         Vec::new(),\n@@ -36,6 +38,7 @@ fn rationale_only_brief_change_creates_a_distinct_immutable_revision() {\n     let revised = ContributionRevision::new(\n         project(),\n         contribution,\n+        capture_record_id,\n         snapshot.id(),\n         snapshot.id(),\n         Vec::new(),"},{"sha":"a72dcca844721cc7c7e361a8a4faf098314d132f","filename":"packages/aethyme/rust/crates/aethyme-contracts/tests/project_identity_vectors.rs","status":"modified","additions":81,"deletions":32,"changes":113,"blob_url":"https://github.com/schiste/Aethyme/blob/5ebe8d315062c7db0855bfa760a0379012a51743/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ftests%2Fproject_identity_vectors.rs","raw_url":"https://github.com/schiste/Aethyme/raw/5ebe8d315062c7db0855bfa760a0379012a51743/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ftests%2Fproject_identity_vectors.rs","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme%2Frust%2Fcrates%2Faethyme-contracts%2Ftests%2Fproject_identity_vectors.rs?ref=5ebe8d315062c7db0855bfa760a0379012a51743","patch":"@@ -1,7 +1,5 @@\n //! Project and FileId qualification vectors for the bounded Local profile.\n \n-use std::collections::BTreeMap;\n-\n use aethyme_contracts::experimental_v0::{\n     EntryKind, FileId, FileOperation, IdentityRelation, ProjectDescriptor, ProjectId, SourceEntry,\n     SourceSnapshot, advance_file_identities, validate_file_proposals,\n@@ -62,10 +60,15 @@ fn independent_descriptor_vector_round_trips_exactly() {\n     let (decoded, decoded_id) = ProjectDescriptor::from_record(&bytes).unwrap();\n     assert_eq!(decoded, descriptor);\n     assert_eq!(decoded_id, id);\n+\n+    let mut extended: serde_json::Value = serde_json::from_slice(&bytes).unwrap();\n+    extended[\"extensions\"] = serde_json::json!({\"future\": \"opaque\"});\n+    let extended = serde_json::to_vec(&extended).unwrap();\n+    assert!(ProjectDescriptor::from_record(&extended).is_err());\n }\n \n #[test]\n-fn file_ids_align_only_under_the_same_explicit_project_mapping() {\n+fn file_ids_are_project_scoped_and_repeatable_for_the_same_project_id() {\n     let source = snapshot(&[(b\"src/a.rs\", b\"same\")]);\n     let project_a = project();\n     let project_b = ProjectId::parse(&format!(\"proj:{}a\", \"b\".repeat(25))).unwrap();\n@@ -102,14 +105,15 @@ fn exact_rename_preserves_id_but_unannotated_rename_stays_uncertain() {\n     )\n     .unwrap();\n     let base_ids = descriptor.file_map();\n+    let base_state = descriptor.initial_file_identity_state().unwrap();\n     let renamed = snapshot(&[(b\"new.rs\", b\"same bytes\"), (b\"keep.rs\", b\"keep\")]);\n \n     let explicit = advance_file_identities(\n         &project(),\n+        &base_state,\n         \"proposal-rename\",\n         &base,\n         &renamed,\n-        &base_ids,\n         &[FileOperation::Rename {\n             from: b\"old.rs\".to_vec(),\n             to: b\"new.rs\".to_vec(),\n@@ -118,7 +122,7 @@ fn exact_rename_preserves_id_but_unannotated_rename_stays_uncertain() {\n     .unwrap();\n     assert_eq!(\n         explicit\n-            .result_files\n+            .result_files()\n             .iter()\n             .find(|file| file.path == b\"new.rs\")\n             .unwrap()\n@@ -127,29 +131,29 @@ fn exact_rename_preserves_id_but_unannotated_rename_stays_uncertain() {\n     );\n     assert!(\n         explicit\n-            .changes\n+            .changes()\n             .iter()\n             .any(|change| change.relation == IdentityRelation::ExplicitRename)\n     );\n \n     let inferred = advance_file_identities(\n         &project(),\n+        &base_state,\n         \"proposal-inferred\",\n         &base,\n         &renamed,\n-        &base_ids,\n         &[],\n     )\n     .unwrap();\n     let old_id = &base_ids[b\"old.rs\"];\n     let new_id = &inferred\n-        .result_files\n+        .result_files()\n         .iter()\n         .find(|file| file.path == b\"new.rs\")\n         .unwrap()\n         .file_id;\n     assert_ne!(old_id, new_id);\n-    assert!(inferred.changes.iter().any(|change| {\n+    assert!(inferred.changes().iter().any(|change| {\n         change.relation == IdentityRelation::UncertainRename\n             && change.possible_sources == vec![old_id.clone()]\n     }));\n@@ -164,14 +168,15 @@ fn edited_rename_is_not_claimed_as_a_validated_rename() {\n         &base,\n     )\n     .unwrap();\n+    let base_state = descriptor.initial_file_identity_state().unwrap();\n     let result = snapshot(&[(b\"new.rs\", b\"after\")]);\n     assert!(\n         advance_file_identities(\n             &project(),\n+            &base_state,\n             \"proposal-edited-rename\",\n             &base,\n             &result,\n-            &descriptor.file_map(),\n             &[FileOperation::Rename {\n                 from: b\"old.rs\".to_vec(),\n                 to: b\"new.rs\".to_vec(),\n@@ -181,16 +186,16 @@ fn edited_rename_is_not_claimed_as_a_validated_rename() {\n     );\n     let unknown = advance_file_identities(\n         &project(),\n+        &base_state,\n         \"proposal-unknown-edit\",\n         &base,\n         &result,\n-        &descriptor.file_map(),\n         &[],\n     )\n     .unwrap();\n     assert!(\n         unknown\n-            .changes\n+            .changes()\n             .iter()\n             .any(|change| change.relation == IdentityRelation::New)\n     );\n@@ -206,53 +211,54 @@ fn copy_and_split_create_new_ids_with_explicit_derivation() {\n     )\n     .unwrap();\n     let base_ids = descriptor.file_map();\n+    let base_state = descriptor.initial_file_identity_state().unwrap();\n     let copy_result = snapshot(&[(b\"copy.rs\", b\"original\"), (b\"source.rs\", b\"original\")]);\n     let copy = advance_file_identities(\n         &project(),\n+        &base_state,\n         \"proposal-copy\",\n         &base,\n         &copy_result,\n-        &base_ids,\n         &[FileOperation::Copy {\n             from: b\"source.rs\".to_vec(),\n             to: b\"copy.rs\".to_vec(),\n         }],\n     )\n     .unwrap();\n     let copied = copy\n-        .result_files\n+        .result_files()\n         .iter()\n         .find(|file| file.path == b\"copy.rs\")\n         .unwrap();\n     assert_ne!(copied.file_id, base_ids[b\"source.rs\"]);\n-    assert!(copy.changes.iter().any(|change| {\n+    assert!(copy.changes().iter().any(|change| {\n         change.relation == IdentityRelation::ExplicitCopy\n             && change.derived_from == vec![base_ids[b\"source.rs\"].clone()]\n     }));\n \n     let split_result = snapshot(&[(b\"part-a.rs\", b\"first\"), (b\"part-b.rs\", b\"second\")]);\n     let split = advance_file_identities(\n         &project(),\n+        &base_state,\n         \"proposal-split\",\n         &base,\n         &split_result,\n-        &base_ids,\n         &[FileOperation::Split {\n             from: b\"source.rs\".to_vec(),\n             to: vec![b\"part-a.rs\".to_vec(), b\"part-b.rs\".to_vec()],\n         }],\n     )\n     .unwrap();\n     let ids: Vec<&FileId> = split\n-        .result_files\n+        .result_files()\n         .iter()\n         .map(|file| &file.file_id)\n         .collect();\n     assert_eq!(ids.len(), 2);\n     assert_ne!(ids[0], ids[1]);\n     assert!(\n         split\n-            .changes\n+            .changes()\n             .iter()\n             .filter(|change| { change.relation == IdentityRelation::ExplicitSplit })\n             .all(|change| change.derived_from == vec![base_ids[b\"source.rs\"].clone()])\n@@ -269,30 +275,73 @@ fn competing_new_files_at_the_same_path_conflict_even_with_equal_bytes() {\n     )\n     .unwrap();\n     let base_ids = descriptor.file_map();\n+    let base_state = descriptor.initial_file_identity_state().unwrap();\n     let result = snapshot(&[(b\"base.rs\", b\"base\"), (b\"new.rs\", b\"same\")]);\n-    let left = advance_file_identities(&project(), \"proposal-left\", &base, &result, &base_ids, &[])\n-        .unwrap();\n-    let right =\n-        advance_file_identities(&project(), \"proposal-right\", &base, &result, &base_ids, &[])\n-            .unwrap();\n+    let left = advance_file_identities(\n+        &project(),\n+        &base_state,\n+        \"proposal-left\",\n+        &base,\n+        &result,\n+        &[],\n+    )\n+    .unwrap();\n+    let right = advance_file_identities(\n+        &project(),\n+        &base_state,\n+        \"proposal-right\",\n+        &base,\n+        &result,\n+        &[],\n+    )\n+    .unwrap();\n     let conflict = validate_file_proposals(&[left, right]).unwrap_err();\n     assert_eq!(conflict.path, b\"new.rs\");\n     assert_eq!(conflict.proposal_ids, [\"proposal-left\", \"proposal-right\"]);\n }\n \n #[test]\n-fn unrelated_file_id_map_members_are_refused() {\n+fn foreign_project_identity_state_and_wrong_base_snapshot_are_refused() {\n     let base = snapshot(&[(b\"a.rs\", b\"a\")]);\n     let result = snapshot(&[(b\"a.rs\", b\"a\")]);\n-    let mut ids = BTreeMap::from([(\n-        b\"a.rs\".to_vec(),\n-        FileId::parse(\n-            \"file:sha256:fd0ee6dc0f6b45715b845b427f345007bd60c53f1b75196d94be53bec48ed33e\",\n+    let foreign = ProjectDescriptor::from_snapshot(\n+        ProjectId::parse(&format!(\"proj:{}a\", \"b\".repeat(25))).unwrap(),\n+        \"1111111111111111111111111111111111111111\",\n+        &base,\n+    )\n+    .unwrap()\n+    .initial_file_identity_state()\n+    .unwrap();\n+    assert!(\n+        advance_file_identities(\n+            &project(),\n+            &foreign,\n+            \"proposal-foreign\",\n+            &base,\n+            &result,\n+            &[]\n         )\n-        .unwrap(),\n-    )]);\n-    ids.insert(b\"extra.rs\".to_vec(), ids[b\"a.rs\"].clone());\n+        .is_err()\n+    );\n+\n+    let local = ProjectDescriptor::from_snapshot(\n+        project(),\n+        \"1111111111111111111111111111111111111111\",\n+        &base,\n+    )\n+    .unwrap()\n+    .initial_file_identity_state()\n+    .unwrap();\n+    let wrong_base = snapshot(&[(b\"a.rs\", b\"changed\")]);\n     assert!(\n-        advance_file_identities(&project(), \"proposal-extra\", &base, &result, &ids, &[]).is_err()\n+        advance_file_identities(\n+            &project(),\n+            &local,\n+            \"proposal-stale-state\",\n+            &wrong_base,\n+            &result,\n+            &[]\n+        )\n+        .is_err()\n     );\n }"}]}