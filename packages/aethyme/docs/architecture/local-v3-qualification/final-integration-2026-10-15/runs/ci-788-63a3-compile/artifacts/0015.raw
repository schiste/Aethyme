{"sha":"898215cb89fcd1baccfc1af167a67c66f0488060","node_id":"C_kwDOQ07FcNoAKDg5ODIxNWNiODlmY2QxYmFjY2ZjMWFmMTY3YTY3YzY2ZjA0ODgwNjA","commit":{"author":{"name":"Christophe Henner","email":"christophehenner@gmail.com","date":"2026-10-16T00:34:56Z"},"committer":{"name":"Christophe Henner","email":"christophehenner@gmail.com","date":"2026-10-16T00:34:56Z"},"message":"perf(eval): count canonical string bytes incrementally\n\nProblem: Recomputing Buffer.byteLength over each accumulated decoded string made the capped 64 KiB path quadratic.\n\nDecision: Collect decoded scalars in chunks, count each scalar UTF-8 width incrementally, and join once when the closing quote is reached.\n\nRationale: This keeps bounded byte accounting while preserving the exact limit check point and scalar refusal behavior.\n\nValidation: Independent static review CLEAR; node --experimental-strip-types --check passed for the modified source; git diff --check passed. Full parity qualification follows after commit.","tree":{"sha":"090453919073b264f112e31ae4c6732a12b3c588","url":"https://api.github.com/repos/schiste/Aethyme/git/trees/090453919073b264f112e31ae4c6732a12b3c588"},"url":"https://api.github.com/repos/schiste/Aethyme/git/commits/898215cb89fcd1baccfc1af167a67c66f0488060","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/schiste/Aethyme/commits/898215cb89fcd1baccfc1af167a67c66f0488060","html_url":"https://github.com/schiste/Aethyme/commit/898215cb89fcd1baccfc1af167a67c66f0488060","comments_url":"https://api.github.com/repos/schiste/Aethyme/commits/898215cb89fcd1baccfc1af167a67c66f0488060/comments","author":{"login":"schiste","id":15890754,"node_id":"MDQ6VXNlcjE1ODkwNzU0","avatar_url":"https://avatars.githubusercontent.com/u/15890754?v=4","gravatar_id":"","url":"https://api.github.com/users/schiste","html_url":"https://github.com/schiste","followers_url":"https://api.github.com/users/schiste/followers","following_url":"https://api.github.com/users/schiste/following{/other_user}","gists_url":"https://api.github.com/users/schiste/gists{/gist_id}","starred_url":"https://api.github.com/users/schiste/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/schiste/subscriptions","organizations_url":"https://api.github.com/users/schiste/orgs","repos_url":"https://api.github.com/users/schiste/repos","events_url":"https://api.github.com/users/schiste/events{/privacy}","received_events_url":"https://api.github.com/users/schiste/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"schiste","id":15890754,"node_id":"MDQ6VXNlcjE1ODkwNzU0","avatar_url":"https://avatars.githubusercontent.com/u/15890754?v=4","gravatar_id":"","url":"https://api.github.com/users/schiste","html_url":"https://github.com/schiste","followers_url":"https://api.github.com/users/schiste/followers","following_url":"https://api.github.com/users/schiste/following{/other_user}","gists_url":"https://api.github.com/users/schiste/gists{/gist_id}","starred_url":"https://api.github.com/users/schiste/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/schiste/subscriptions","organizations_url":"https://api.github.com/users/schiste/orgs","repos_url":"https://api.github.com/users/schiste/repos","events_url":"https://api.github.com/users/schiste/events{/privacy}","received_events_url":"https://api.github.com/users/schiste/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7887369bfaab514fa498f76d9bf9c157377c802a","url":"https://api.github.com/repos/schiste/Aethyme/commits/7887369bfaab514fa498f76d9bf9c157377c802a","html_url":"https://github.com/schiste/Aethyme/commit/7887369bfaab514fa498f76d9bf9c157377c802a"}],"stats":{"total":39,"additions":23,"deletions":16},"files":[{"sha":"55a88879674e7957414b41e139fc26914cb5aba8","filename":"packages/aethyme-eval/local-v3/t01-canonical-parity/canonical-json.mts","status":"modified","additions":23,"deletions":16,"changes":39,"blob_url":"https://github.com/schiste/Aethyme/blob/898215cb89fcd1baccfc1af167a67c66f0488060/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Fcanonical-json.mts","raw_url":"https://github.com/schiste/Aethyme/raw/898215cb89fcd1baccfc1af167a67c66f0488060/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Fcanonical-json.mts","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Fcanonical-json.mts?ref=898215cb89fcd1baccfc1af167a67c66f0488060","patch":"@@ -209,14 +209,19 @@ class Parser {\n \n   private parseString(): string {\n     this.position += 1;\n-    let output = \"\";\n+    const output: string[] = [];\n+    let decodedBytes = 0;\n+\n+    const append = (codePoint: number): void => {\n+      decodedBytes += this.appendScalar(output, codePoint);\n+    };\n \n     while (true) {\n       const current = this.peek();\n       if (current === undefined) throw new CanonicalProfileError(\"syntax\");\n       if (current === '\"') {\n         this.position += 1;\n-        return output;\n+        return output.join(\"\");\n       }\n       if (current === \"\\\\\") {\n         this.position += 1;\n@@ -225,35 +230,33 @@ class Parser {\n           case '\"':\n           case \"\\\\\":\n           case \"/\":\n-            output += escape;\n+            append(escape.codePointAt(0)!);\n             this.position += 1;\n             break;\n           case \"b\":\n-            output += \"\\b\";\n+            append(0x08);\n             this.position += 1;\n             break;\n           case \"f\":\n-            output += \"\\f\";\n+            append(0x0c);\n             this.position += 1;\n             break;\n           case \"n\":\n-            output += \"\\n\";\n+            append(0x0a);\n             this.position += 1;\n             break;\n           case \"r\":\n-            output += \"\\r\";\n+            append(0x0d);\n             this.position += 1;\n             break;\n           case \"t\":\n-            output += \"\\t\";\n+            append(0x09);\n             this.position += 1;\n             break;\n-          case \"u\": {\n+          case \"u\":\n             this.position += 1;\n-            const codePoint = this.parseUnicodeEscape();\n-            output = this.appendScalar(output, codePoint);\n+            append(this.parseUnicodeEscape());\n             break;\n-          }\n           default:\n             throw new CanonicalProfileError(\"syntax\");\n         }\n@@ -262,11 +265,11 @@ class Parser {\n         if (codeUnit < 0x20) throw new CanonicalProfileError(\"syntax\");\n         const codePoint = this.text.codePointAt(this.position);\n         if (codePoint === undefined) throw new CanonicalProfileError(\"syntax\");\n-        output = this.appendScalar(output, codePoint);\n+        append(codePoint);\n         this.position += codePoint > 0xffff ? 2 : 1;\n       }\n \n-      if (Buffer.byteLength(output, \"utf8\") > PROFILE_LIMITS.max_string_bytes) {\n+      if (decodedBytes > PROFILE_LIMITS.max_string_bytes) {\n         throw new CanonicalProfileError(\"string_too_long\");\n       }\n     }\n@@ -300,14 +303,18 @@ class Parser {\n     return Number.parseInt(digits, 16);\n   }\n \n-  private appendScalar(output: string, codePoint: number): string {\n+  private appendScalar(output: string[], codePoint: number): number {\n     if (\n       (codePoint >= 0xfdd0 && codePoint <= 0xfdef) ||\n       (codePoint & 0xfffe) === 0xfffe\n     ) {\n       throw new CanonicalProfileError(\"noncharacter\");\n     }\n-    return output + String.fromCodePoint(codePoint);\n+    output.push(String.fromCodePoint(codePoint));\n+    if (codePoint <= 0x7f) return 1;\n+    if (codePoint <= 0x7ff) return 2;\n+    if (codePoint <= 0xffff) return 3;\n+    return 4;\n   }\n }\n "}]}