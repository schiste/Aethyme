s/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5f760b0e1d0b21faa3c26c3bf5c63205a487ca15","url":"https://api.github.com/repos/schiste/Aethyme/commits/5f760b0e1d0b21faa3c26c3bf5c63205a487ca15","html_url":"https://github.com/schiste/Aethyme/commit/5f760b0e1d0b21faa3c26c3bf5c63205a487ca15"},{"sha":"fc711d13172a61bc9188c59731579a4f5ac63ca0","url":"https://api.github.com/repos/schiste/Aethyme/commits/fc711d13172a61bc9188c59731579a4f5ac63ca0","html_url":"https://github.com/schiste/Aethyme/commit/fc711d13172a61bc9188c59731579a4f5ac63ca0"}],"stats":{"total":3312,"additions":3312,"deletions":0},"files":[{"sha":"6d6e0b35672f03308fc9810023b731566c085949","filename":"packages/aethyme-eval/docs/t01-t02-typescript-parity/.gitattributes","status":"added","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/schiste/Aethyme/blob/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2F.gitattributes","raw_url":"https://github.com/schiste/Aethyme/raw/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2F.gitattributes","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2F.gitattributes?ref=48ae7c6df372a7f71302c1febf6d8d87870c9fab","patch":"@@ -0,0 +1,3 @@\n+/qualification.tar.gz binary\n+/README.md text eol=lf\n+/ledger/** text eol=lf"},{"sha":"0d4103ad44de8f4c646da03048a404df4a402bb2","filename":"packages/aethyme-eval/docs/t01-t02-typescript-parity/README.md","status":"added","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/schiste/Aethyme/blob/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2FREADME.md","raw_url":"https://github.com/schiste/Aethyme/raw/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2FREADME.md","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2FREADME.md?ref=48ae7c6df372a7f71302c1febf6d8d87870c9fab","patch":"@@ -0,0 +1,20 @@\n+# T01/T02 Rust and TypeScript parity qualification\n+\n+Last Updated: 2026-10-16\n+\n+`qualification.tar.gz` is the frozen offline qualification evidence bundle. It contains exactly 346 plain regular-file members: the 345 files listed in the original package manifest and that manifest itself. The new archive has no directory records, PAX records, links, duplicate or traversal paths, AppleDouble sidecars, or unlisted members. The archived bytes were compared member-by-member against the frozen package; all 346 match. No Node executable is bundled.\n+\n+This is a finite contract-parity qualification against existing frozen vectors. It is not a production TypeScript consumer, production runtime path, or Aethyme evaluation target. No golden fixture or Rust contract oracle was modified to fit the TypeScript implementation. No external assets or dependencies were added.\n+\n+## Qualification result\n+\n+- Baseline commit: `a4b478126edc5f03b84dd8bebc3cedeab7c5947b` (tree `daacf68f45a6ab2bce5ece68542bc73ddadfec2c`).\n+- Restored positive: Node v26.8.2, 256 MiB heap limit, 60-second deadline; exit 0 with 880 assertions and empty stderr. All frozen source pins, HEAD/tree, and clean status matched before and after.\n+- Five reviewed mutant controls each failed at the exact intended first assertion, exited 1, and restored the pristine source hash with clean status and unchanged HEAD/tree.\n+- The complete original attempt ledger is retained, including the first uncredited Chinese token-vector behavioral failure before its generic fix and the two failed patch preflight attempts.\n+\n+## Packaging correction\n+\n+An earlier packaging proposal was rejected because its macOS tar output carried 377 AppleDouble sidecars, producing 723 regular archive entries. Its proposal-manifest SHA-256 was `e59e1bcae2036376aa3caf88082b267e1ed719600a240e07dd6e9618927a683f` and archive SHA-256 was `4764c824ae7f9e6817ab6a31d87d362890af64fa522bb40baab3202340b94592`. That rejected archive remains unchanged locally, with its full member inventory and review note in the new proposal ledger. The underlying frozen qualification package did not change. This accepted-candidate archive contains only the 346 original regular files and is independently verified against the frozen source bytes.\n+\n+See `ledger/portable-package-manifest.sha256` for the original package digest list, `ledger/frozen-inputs.sha256` for source and fixture pins, and `ledger/runtime-provenance.txt` for Node details. `ledger/qualification.sha256` records the archive hash; `ledger/proposal.sha256` hashes the proposal files other than itself."},{"sha":"a8533f2b376d222bab956adf0262c24e4266ee1e","filename":"packages/aethyme-eval/docs/t01-t02-typescript-parity/ledger/frozen-inputs.sha256","status":"added","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/schiste/Aethyme/blob/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2Fledger%2Ffrozen-inputs.sha256","raw_url":"https://github.com/schiste/Aethyme/raw/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2Fledger%2Ffrozen-inputs.sha256","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2Fledger%2Ffrozen-inputs.sha256?ref=48ae7c6df372a7f71302c1febf6d8d87870c9fab","patch":"@@ -0,0 +1,20 @@\n+02b411c3b66f1436318b98015c90061f70bd7637a34325abee09d4586b26e7a2  packages/aethyme-eval/local-v3/t01-canonical-parity/README.md\n+0b9f582e57d1472abd7e78cb2f2c1e8d9ef2b65ae9ece4d3a4bb0274cb1b2e7f  packages/aethyme-eval/loca