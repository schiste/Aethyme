atch\n+regular\t676\t./patches/raw-paths.patch\n+regular\t163\t./patches/._brief-budget.patch\n+regular\t626\t./patches/brief-budget.patch\n+regular\t163\t./patches/._duplicate-key.patch\n+regular\t651\t./patches/duplicate-key.patch\n+regular\t163\t./patches/._set-normalization.patch\n+regular\t670\t./patches/set-normalization.patch\n+regular\t163\t./preflight-patch-checks/._attempt2\n+directory\t0\t./preflight-patch-checks/attempt2\n+regular\t163\t./preflight-patch-checks/._attempt1\n+directory\t0\t./preflight-patch-checks/attempt1\n+regular\t163\t./preflight-patch-checks/._attempt3-summary.txt\n+regular\t625\t./preflight-patch-checks/attempt3-summary.txt\n+regular\t163\t./preflight-patch-checks/attempt1/._reconciliation.txt\n+regular\t456\t./preflight-patch-checks/attempt1/reconciliation.txt\n+regular\t163\t./preflight-patch-checks/attempt1/._patches\n+directory\t0\t./preflight-patch-checks/attempt1/patches\n+regular\t163\t./preflight-patch-checks/attempt1/._command-output-copy.txt\n+regular\t1121\t./preflight-patch-checks/attempt1/command-output-copy.txt\n+regular\t163\t./preflight-patch-checks/attempt1/patches/._precision.patch\n+regular\t432\t./preflight-patch-checks/attempt1/patches/precision.patch\n+regular\t163\t./preflight-patch-checks/attempt1/patches/._raw-paths.patch\n+regular\t461\t./preflight-patch-checks/attempt1/patches/raw-paths.patch\n+regular\t163\t./preflight-patch-checks/attempt1/patches/._brief-budget.patch\n+regular\t418\t./preflight-patch-checks/attempt1/patches/brief-budget.patch\n+regular\t163\t./preflight-patch-checks/attempt1/patches/._duplicate-key.patch\n+regular\t414\t./preflight-patch-checks/attempt1/patches/duplicate-key.patch\n+regular\t163\t./preflight-patch-checks/attempt1/patches/._set-normalization.patch\n+regular\t462\t./preflight-patch-checks/attempt1/patches/set-normalization.patch\n+regular\t163\t./preflight-patch-checks/attempt2/._reconciliation.txt\n+regular\t426\t./preflight-patch-checks/attempt2/reconciliation.txt\n+regular\t163\t./preflight-patch-checks/attempt2/._patches\n+directory\t0\t./preflight-patch-checks/attempt2/patches\n+regular\t163\t./preflight-patch-checks/attempt2/._command-output-copy.txt\n+regular\t652\t./preflight-patch-checks/attempt2/command-output-copy.txt\n+regular\t163\t./preflight-patch-checks/attempt2/patches/._precision.patch\n+regular\t652\t./preflight-patch-checks/attempt2/patches/precision.patch\n+regular\t163\t./preflight-patch-checks/attempt2/patches/._raw-paths.patch\n+regular\t676\t./preflight-patch-checks/attempt2/patches/raw-paths.patch\n+regular\t163\t./preflight-patch-checks/attempt2/patches/._brief-budget.patch\n+regular\t626\t./preflight-patch-checks/attempt2/patches/brief-budget.patch\n+regular\t163\t./preflight-patch-checks/attempt2/patches/._duplicate-key.patch\n+regular\t651\t./preflight-patch-checks/attempt2/patches/duplicate-key.patch\n+regular\t163\t./preflight-patch-checks/attempt2/patches/._set-normalization.patch\n+regular\t670\t./preflight-patch-checks/attempt2/patches/set-normalization.patch"},{"sha":"6be53541abc189dca8749b520d0b3af89c8ad03a","filename":"packages/aethyme-eval/docs/t01-t02-typescript-parity/ledger/rejected-archive-review.md","status":"added","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/schiste/Aethyme/blob/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2Fledger%2Frejected-archive-review.md","raw_url":"https://github.com/schiste/Aethyme/raw/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2Fledger%2Frejected-archive-review.md","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2Fledger%2Frejected-archive-review.md?ref=48ae7c6df372a7f71302c1febf6d8d87870c9fab","patch":"@@ -0,0 +1,10 @@\n+# Rejected archive attempt retained for provenance\n+\n+- Rejected proposal directory: `/private/tmp/aethyme-t01-doc-proposal-20261016-010500`\n+- Rejected proposal-manifest SHA-256: `e59e1bcae2036376aa3caf88082b267e1ed719600a240e07dd6e9618927a683f`\n+- Rejected archive SHA-256: `4764c824ae7f9e6817ab6a31d87d362890af64fa522bb40baab3202340b94592`\n+- Inventory: `rejected-archive-inventory.tsv` (754 tar members, 723 regular entries, 377 AppleDouble `._*` sidecars, 31 directory entries).\n+- Independent review rejected that wrapper because the macOS tar writer included AppleDouble sidecars. The 346 original package files still matched their frozen source bytes; the sidecars were archive-only metadata.\n+- The rejected proposal and archive remain unchanged at the path above and are excluded from this new archive.\n+- The new archive is written with Python `tarfile` in USTAR format and contains exactly the 346 original regular files, with no directory records, PAX records, links, duplicates, traversal paths, AppleDouble entries, or unlisted files.\n+- All original 346 file byte streams were compared against the source package during archive verification."},{"sha":"faf676f657fcdd1247954e75dbd86beaf8730a88","filename":"packages/aethyme-eval/docs/t01-t02-typescript-parity/ledger/runtime-provenance.txt","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/schiste/Aethyme/blob/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2Fledger%2Fruntime-provenance.txt","raw_url":"https://github.com/schiste/Aethyme/raw/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2Fledger%2Fruntime-provenance.txt","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2Fledger%2Fruntime-provenance.txt?ref=48ae7c6df372a7f71302c1febf6d8d87870c9fab","patch":"@@ -0,0 +1,7 @@\n+Node runtime selected by the clean PATH used for qualification:\n+Version: v26.8.2\n+Path: /opt/homebrew/bin/node\n+Heap cap for every qualification command: --max-old-space-size=256\n+Timeout utility: /usr/bin/timeout\n+Qualification deadline: 60 seconds; TERM then KILL after 5 seconds.\n+Network/provider variables are removed for each harness run with env -i."},{"sha":"dc9d5aa8156ac31a9af82e1b7312aaba5c63df10","filename":"packages/aethyme-eval/docs/t01-t02-typescript-parity/qualification.tar.gz","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/schiste/Aethyme/blob/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2Fqualification.tar.gz","raw_url":"https://github.com/schiste/Aethyme/raw/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2Fqualification.tar.gz","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Fdocs%2Ft01-t02-typescript-parity%2Fqualification.tar.gz?ref=48ae7c6df372a7f71302c1febf6d8d87870c9fab"},{"sha":"d5cc7580e5907655c841cb344691449c085bf9f3","filename":"packages/aethyme-eval/local-v3/t01-canonical-parity/README.md","status":"added","additions":39,"deletions":0,"changes":39,"blob_url":"https://github.com/schiste/Aethyme/blob/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2FREADME.md","raw_url":"https://github.com/schiste/Aethyme/raw/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2FREADME.md","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2FREADME.md?ref=48ae7c6df372a7f71302c1febf6d8d87870c9fab","patch":"@@ -0,0 +1,39 @@\n+# Local v3 frozen Rust/TypeScript parity\n+\n+This eval-side qualification package compares small TypeScript adapters with\n+the existing Rust Local v3 canonical JSON, record, source snapshot, and\n+decision brief contracts. Both implementations consume the same tracked,\n+independently authored golden JSON vectors. The TypeScript code is a bounded\n+qualification aid; it is not imported by the Rust product or presented as a\n+production TypeScript consumer.\n+\n+Run it from the repository root with a Node runtime that supports native\n+TypeScript type stripping:\n+\n+    node --experimental-strip-types packages/aethyme-eval/local-v3/t01-canonical-parity/t01-canonical-parity.mts\n+\n+The runner uses Node built-ins only. It needs no install, network access,\n+Cargo, or product build. It is read-only: it verifies SHA-256 pins for the\n+golden JSON files, their Rust test consumers, and Rust contract sources, then\n+prints one JSON report with case counts, the pinned reference commit, frozen\n+source hashes, and hashes of the TypeScript sources. A changed pinned source\n+requires a newly reviewed qualification; the runner never updates pins or\n+fixtures.\n+\n+The canonical JSON and record profile vectors cover duplicate keys (including\n+escaped aliases), safe-integer boundaries and out-of-range integers, null\n+rejection, absent and explicitly unknown state equivalence, unordered string\n+sets, equivalent encodings, exact record digests, malformed records, raw path\n+bytes, snapshot order, and critical path and mode refusals.\n+\n+The brief profile uses the frozen 30 token cases, all decision-file and record\n+vectors, and the 27 stored calibration inputs. It checks exact profile counts,\n+the 149/150/151 boundary, multilingual and escaped/order-equivalent briefs,\n+field-specific refusal codes, unknown future metadata, record digests, and\n+the oversized hidden-metadata refusal. The implementation follows the\n+repository's Apache-2.0 license and adds no third-party package, model\n+vocabulary, or tokenizer asset.\n+\n+The report is finite fixture evidence for the covered contracts. It does not\n+claim general TypeScript interoperability, model-token equivalence, or a\n+production TypeScript consumer."},{"sha":"883b14c5b5c8cadf13339c15188f823fdfc12279","filename":"packages/aethyme-eval/local-v3/t01-canonical-parity/brief-profile.mts","status":"added","additions":404,"deletions":0,"changes":404,"blob_url":"https://github.com/schiste/Aethyme/blob/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Fbrief-profile.mts","raw_url":"https://github.com/schiste/Aethyme/raw/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Fbrief-profile.mts","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Fbrief-profile.mts?ref=48ae7c6df372a7f71302c1febf6d8d87870c9fab","patch":"@@ -0,0 +1,404 @@\n+import { Buffer } from \"node:buffer\";\n+import {\n+  canonicalizeValue,\n+  parseCanonicalJson,\n+  type CanonicalValue,\n+} from \"./canonical-json.mts\";\n+import { decodeRecord, type DecodedRecord, type RecordSchema } from \"./records.mts\";\n+\n+export const BRIEF_TOKEN_PROFILE = \"aethyme-brief-tokens/v0\";\n+export const BRIEF_SCHEMA_NAME = \"aethyme.decision-brief/experimental-v0\";\n+export const BRIEF_LIMITS = {\n+  max_tokens: 150,\n+  max_prose_bytes: 2048,\n+  max_list_entries: 8,\n+  max_scope_ref_bytes: 64,\n+  max_record_bytes: 8192,\n+} as const;\n+\n+const DECISION_FIELDS = [\"scope_ref\", \"choice\", \"reason\"] as const;\n+const LIST_FIELDS = [\"preserves\", \"assumptions\", \"deferred\"] as const;\n+const DECISION_FILE_FIELDS = new Set([\n+  \"intent\",\n+  \"decisions\",\n+  ...LIST_FIELDS,\n+]);\n+const BIDI_CONTROLS = new Set([\n+  0x061c,\n+  0x200e,\n+  0x200f,\n+  0x202a,\n+  0x202b,\n+  0x202c,\n+  0x202d,\n+  0x202e,\n+  0x2066,\n+  0x2067,\n+  0x2068,\n+  0x2069,\n+]);\n+\n+export type BriefDecision = {\n+  scope_ref: string;\n+  choice: string;\n+  reason: string;\n+};\n+\n+export type Brief = {\n+  intent: string;\n+  decisions: BriefDecision[];\n+  preserves: string[];\n+  assumptions: string[];\n+  deferred: string[];\n+};\n+\n+export type BriefProblem = { path: string; code: string };\n+\n+export class BriefProfileError extends Error {\n+  readonly code: string;\n+  readonly problems: BriefProblem[];\n+\n+  constructor(problems: BriefProblem[]) {\n+    super(problems.map(({ path, code }) => `${path || \"brief\"}:${code}`).join(\", \"));\n+    this.name = \"BriefProfileError\";\n+    this.problems = problems;\n+    this.code = problems[0]?.code ?? \"invalid_brief\";\n+  }\n+}\n+\n+export const BRIEF_RECORD_SCHEMA: RecordSchema = {\n+  name: BRIEF_SCHEMA_NAME,\n+  capabilities: [],\n+  fields: [\n+    { name: \"token_profile\", required: true, kind: \"string\" },\n+    { name: \"intent\", required: true, kind: \"string\" },\n+    { name: \"decisions\", required: false, kind: \"opaque\" },\n+    { name: \"preserves\", required: false, kind: \"opaque\" },\n+    { name: \"assumptions\", required: false, kind: \"opaque\" },\n+    { name: \"deferred\", required: false, kind: \"opaque\" },\n+  ],\n+};\n+\n+function problem(path: string, code: string): BriefProblem {\n+  return { path, code };\n+}\n+\n+function isMap(value: CanonicalValue | undefined): value is Map<string, CanonicalValue> {\n+  return value instanceof Map;\n+}\n+\n+function sortedNames(object: Map<string, CanonicalValue>): string[] {\n+  return [...object.keys()].sort((left, right) =>\n+    left < right ? -1 : left > right ? 1 : 0,\n+  );\n+}\n+\n+function parseObject(input: Uint8Array): Map<string, CanonicalValue> {\n+  let value: CanonicalValue;\n+  try {\n+    value = parseCanonicalJson(input);\n+  } catch (error) {\n+    const code =\n+      typeof error === \"object\" &&\n+      error !== null &&\n+      \"code\" in error &&\n+      typeof error.code === \"string\"\n+        ? error.code\n+        : \"syntax\";\n+    throw new BriefProfileError([problem(\"\", code)]);\n+  }\n+  if (!isMap(value)) throw new BriefProfileError([problem(\"\", \"not_an_object\")]);\n+  return value;\n+}\n+\n+function readText(\n+  object: Map<string, CanonicalValue>,\n+  name: string,\n+  path: string,\n+  problems: BriefProblem[],\n+): string {\n+  const value = object.get(name);\n+  if (value === undefined) {\n+    problems.push(problem(path, \"missing_field\"));\n+    return \"\";\n+  }\n+  if (typeof value !== \"string\") {\n+    problems.push(problem(path, \"wrong_type\"));\n+    return \"\";\n+  }\n+  return value;\n+}\n+\n+function readList(\n+  object: Map<string, CanonicalValue>,\n+  name: string,\n+  inRecord: boolean,\n+  problems: BriefProblem[],\n+): CanonicalValue[] | undefined {\n+  const value = object.get(name);\n+  if (value === undefined) return undefined;\n+  if (!Array.isArray(value)) {\n+    problems.push(problem(name, \"wrong_type\"));\n+    return undefined;\n+  }\n+  if (inRecord && value.length === 0) {\n+    problems.push(problem(name, \"empty\"));\n+    return undefined;\n+  }\n+  return value;\n+}\n+\n+function readFields(\n+  object: Map<string, CanonicalValue>,\n+  inRecord: boolean,\n+  problems: BriefProblem[],\n+): Brief {\n+  const brief: Brief = {\n+    intent: readText(object, \"intent\", \"intent\", problems),\n+    decisions: [],\n+    preserves: [],\n+    assumptions: [],\n+    deferred: [],\n+  };\n+\n+  const decisionItems = readList(object, \"decisions\", inRecord, problems);\n+  if (decisionItems !== undefined) {\n+    for (const [index, item] of decisionItems.entries()) {\n+      const path = `decisions[${index}]`;\n+      if (!isMap(item)) {\n+        problems.push(problem(path, \"wrong_type\"));\n+        continue;\n+      }\n+\n+      for (const name of sortedNames(item)) {\n+        if (!(DECISION_FIELDS as readonly string[]).includes(name)) {\n+          problems.push(problem(`${path}.${name}`, \"unknown_field\"));\n+        }\n+      }\n+\n+      brief.decisions.push({\n+        scope_ref: readText(item, \"scope_ref\", `${path}.scope_ref`, problems),\n+        choice: readText(item, \"choice\", `${path}.choice`, problems),\n+        reason: readText(item, \"reason\", `${path}.reason`, problems),\n+      });\n+    }\n+  }\n+\n+  for (const name of LIST_FIELDS) {\n+    const items = readList(object, name, inRecord, problems);\n+    if (items === undefined) continue;\n+    const texts: string[] = [];\n+    for (const [index, item] of items.entries()) {\n+      if (typeof item === \"string\") {\n+        texts.push(item);\n+      } else {\n+        problems.push(problem(`${name}[${index}]`, \"wrong_type\"));\n+      }\n+    }\n+    brief[name] = texts;\n+  }\n+\n+  return brief;\n+}\n+\n+function isForbidden(codePoint: number): boolean {\n+  return (\n+    (codePoint >= 0x00 && codePoint <= 0x09) ||\n+    (codePoint >= 0x0b && codePoint <= 0x1f) ||\n+    (codePoint >= 0x7f && codePoint <= 0x9f) ||\n+    BIDI_CONTROLS.has(codePoint)\n+  );\n+}\n+\n+function checkProse(path: string, value: string, problems: BriefProblem[]): void {\n+  if ([...value].every((character) => \" \\t\\n\\r\".includes(character))) {\n+    problems.push(problem(path, \"empty\"));\n+    return;\n+  }\n+  for (const character of value) {\n+    if (isForbidden(character.codePointAt(0) ?? 0)) {\n+      problems.push(problem(path, \"forbidden_character\"));\n+      return;\n+    }\n+  }\n+}\n+\n+function isScopeRef(value: string): boolean {\n+  const bytes = Buffer.byteLength(value, \"utf8\");\n+  if (bytes === 0 || bytes > BRIEF_LIMITS.max_scope_ref_bytes) return false;\n+  if (!/^[a-z0-9]$/.test(value[0] ?? \"\")) return false;\n+  for (const character of value) {\n+    if (!/[a-z0-9._/-]/.test(character)) return false;\n+  }\n+  return true;\n+}\n+\n+export function countBriefTokens(text: string): number {\n+  type Run = \"letter\" | \"digit\" | \"two_byte\";\n+  let total = 0;\n+  let run: Run | undefined;\n+  let length = 0;\n+\n+  const flush = (): void => {\n+    if (run !== undefined) total += Math.ceil(length / (run === \"letter\" ? 4 : 2));\n+    run = undefined;\n+    length = 0;\n+  };\n+\n+  for (const character of text) {\n+    const codePoint = character.codePointAt(0) ?? 0;\n+    const next: Run | undefined =\n+      (codePoint >= 0x41 && codePoint <= 0x5a) ||\n+      (codePoint >= 0x61 && codePoint <= 0x7a)\n+        ? \"letter\"\n+        : codePoint >= 0x30 && codePoint <= 0x39\n+          ? \"digit\"\n+          : codePoint >= 0x80 && codePoint <= 0x7ff\n+            ? \"two_byte\"\n+            : undefined;\n+    if (next === undefined) {\n+      flush();\n+      if (\n+        codePoint !== 0x20 &&\n+        codePoint !== 0x09 &&\n+        codePoint !== 0x0a &&\n+        codePoint !== 0x0d\n+      ) {\n+        total += 1;\n+      }\n+    } else if (next !== run) {\n+      flush();\n+      run = next;\n+      length = 1;\n+    } else {\n+      length += 1;\n+    }\n+  }\n+  flush();\n+  return total;\n+}\n+\n+function prose(brief: Brief): string[] {\n+  return [\n+    brief.intent,\n+    ...brief.decisions.flatMap((decision) => [\n+      decision.scope_ref,\n+      decision.choice,\n+      decision.reason,\n+    ]),\n+    ...brief.preserves,\n+    ...brief.assumptions,\n+    ...brief.deferred,\n+  ];\n+}\n+\n+function validateContent(brief: Brief, problems: BriefProblem[]): void {\n+  checkProse(\"intent\", brief.intent, problems);\n+  checkEntries(\"decisions\", brief.decisions.length, problems);\n+  for (const [index, decision] of brief.decisions.entries()) {\n+    const path = `decisions[${index}]`;\n+    if (!isScopeRef(decision.scope_ref)) {\n+      problems.push(problem(`${path}.scope_ref`, \"invalid_scope_ref\"));\n+    }\n+    checkProse(`${path}.choice`, decision.choice, problems);\n+    checkProse(`${path}.reason`, decision.reason, problems);\n+  }\n+  for (const name of LIST_FIELDS) {\n+    const values = brief[name];\n+    checkEntries(name, values.length, problems);\n+    for (const [index, value] of values.entries()) {\n+      checkProse(`${name}[${index}]`, value, problems);\n+    }\n+  }\n+\n+  const values = prose(brief);\n+  const bytes = values.reduce(\n+    (total, value) => total + Buffer.byteLength(value, \"utf8\"),\n+    0,\n+  );\n+  if (bytes > BRIEF_LIMITS.max_prose_bytes) {\n+    problems.push(problem(\"\", \"over_byte_budget\"));\n+  }\n+  const tokens = values.reduce((total, value) => total + countBriefTokens(value), 0);\n+  if (tokens > BRIEF_LIMITS.max_tokens) {\n+    problems.push(problem(\"\", \"over_token_budget\"));\n+  }\n+}\n+\n+function checkEntries(path: string, count: number, problems: BriefProblem[]): void {\n+  if (count > BRIEF_LIMITS.max_list_entries) {\n+    problems.push(problem(path, \"too_many_entries\"));\n+  }\n+}\n+\n+function finish(brief: Brief, problems: BriefProblem[]): Brief {\n+  if (problems.length === 0) validateContent(brief, problems);\n+  if (problems.length > 0) throw new BriefProfileError(problems);\n+  return brief;\n+}\n+\n+export function validateBriefDecisionFile(input: Uint8Array): Brief {\n+  const object = parseObject(input);\n+  const problems: BriefProblem[] = [];\n+  for (const name of sortedNames(object)) {\n+    if (!DECISION_FILE_FIELDS.has(name)) problems.push(problem(name, \"unknown_field\"));\n+  }\n+  return finish(readFields(object, false, problems), problems);\n+}\n+\n+function decodeBriefRecord(input: Uint8Array): DecodedRecord {\n+  try {\n+    return decodeRecord(input, [BRIEF_RECORD_SCHEMA]);\n+  } catch (error) {\n+    const code =\n+      typeof error === \"object\" &&\n+      error !== null &&\n+      \"code\" in error &&\n+      typeof error.code === \"string\"\n+        ? error.code\n+        : \"invalid_record\";\n+    throw new BriefProfileError([problem(\"\", code)]);\n+  }\n+}\n+\n+export function makeBriefRecord(brief: Brief): DecodedRecord {\n+  const members = new Map<string, CanonicalValue>([\n+    [\"schema\", BRIEF_SCHEMA_NAME],\n+    [\"token_profile\", BRIEF_TOKEN_PROFILE],\n+    [\"intent\", brief.intent],\n+  ]);\n+  if (brief.decisions.length > 0) {\n+    members.set(\n+      \"decisions\",\n+      brief.decisions.map(\n+        (decision) =>\n+          new Map<string, CanonicalValue>([\n+            [\"scope_ref\", decision.scope_ref],\n+            [\"choice\", decision.choice],\n+            [\"reason\", decision.reason],\n+          ]),\n+      ),\n+    );\n+  }\n+  for (const name of LIST_FIELDS) {\n+    if (brief[name].length > 0) members.set(name, brief[name]);\n+  }\n+  return decodeBriefRecord(canonicalizeValue(members));\n+}\n+\n+export function validateBriefRecord(input: Uint8Array): {\n+  brief: Brief;\n+  record: DecodedRecord;\n+} {\n+  if (input.byteLength > BRIEF_LIMITS.max_record_bytes) {\n+    throw new BriefProfileError([problem(\"\", \"record_too_large\")]);\n+  }\n+  const record = decodeBriefRecord(input);\n+  const profile = record.object.get(\"token_profile\");\n+  if (profile !== BRIEF_TOKEN_PROFILE) {\n+    throw new BriefProfileError([problem(\"token_profile\", \"unsupported_profile\")]);\n+  }\n+  const problems: BriefProblem[] = [];\n+  const brief = finish(readFields(record.object, true, problems), problems);\n+  return { brief, record };\n+}"},{"sha":"55a88879674e7957414b41e139fc26914cb5aba8","filename":"packages/aethyme-eval/local-v3/t01-canonical-parity/canonical-json.mts","status":"added","additions":414,"deletions":0,"changes":414,"blob_url":"https://github.com/schiste/Aethyme/blob/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Fcanonical-json.mts","raw_url":"https://github.com/schiste/Aethyme/raw/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Fcanonical-json.mts","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Fcanonical-json.mts?ref=48ae7c6df372a7f71302c1febf6d8d87870c9fab","patch":"@@ -0,0 +1,414 @@\n+import { Buffer } from \"node:buffer\";\n+\n+export type CanonicalValue =\n+  | boolean\n+  | number\n+  | string\n+  | CanonicalValue[]\n+  | Map<string, CanonicalValue>;\n+\n+export type CanonicalErrorCode =\n+  | \"too_large\"\n+  | \"byte_order_mark\"\n+  | \"invalid_utf8\"\n+  | \"syntax\"\n+  | \"trailing_data\"\n+  | \"too_deep\"\n+  | \"too_many_entries\"\n+  | \"duplicate_key\"\n+  | \"null_value\"\n+  | \"non_integer_number\"\n+  | \"integer_out_of_range\"\n+  | \"negative_zero\"\n+  | \"lone_surrogate\"\n+  | \"noncharacter\"\n+  | \"string_too_long\";\n+\n+export class CanonicalProfileError extends Error {\n+  readonly code: CanonicalErrorCode;\n+\n+  constructor(code: CanonicalErrorCode) {\n+    super(code);\n+    this.name = \"CanonicalProfileError\";\n+    this.code = code;\n+  }\n+}\n+\n+export const PROFILE_LIMITS = {\n+  max_document_bytes: 1 << 20,\n+  max_depth: 32,\n+  max_string_bytes: 64 * 1024,\n+  max_container_entries: 4096,\n+  max_safe_integer: Number.MAX_SAFE_INTEGER,\n+};\n+\n+const MAX_SAFE_INTEGER_BIGINT = BigInt(Number.MAX_SAFE_INTEGER);\n+const decoder = new TextDecoder(\"utf-8\", { fatal: true });\n+\n+class Parser {\n+  private position = 0;\n+  private readonly text: string;\n+\n+  constructor(text: string) {\n+    this.text = text;\n+  }\n+\n+  parse(): CanonicalValue {\n+    this.skipWhitespace();\n+    const value = this.parseValue(0);\n+    this.skipWhitespace();\n+    if (this.position !== this.text.length) {\n+      throw new CanonicalProfileError(\"trailing_data\");\n+    }\n+    return value;\n+  }\n+\n+  private peek(): string | undefined {\n+    return this.text[this.position];\n+  }\n+\n+  private skipWhitespace(): void {\n+    while (\" \\t\\n\\r\".includes(this.peek() ?? \"\\0\")) {\n+      this.position += 1;\n+    }\n+  }\n+\n+  private parseValue(containerDepth: number): CanonicalValue {\n+    const next = this.peek();\n+    if (next === \"{\") return this.parseObject(containerDepth + 1);\n+    if (next === \"[\") return this.parseArray(containerDepth + 1);\n+    if (next === '\"') return this.parseString();\n+    if (next === \"-\" || (next !== undefined && next >= \"0\" && next <= \"9\")) {\n+      return this.parseInteger();\n+    }\n+    if (this.text.startsWith(\"true\", this.position)) {\n+      this.position += 4;\n+      return true;\n+    }\n+    if (this.text.startsWith(\"false\", this.position)) {\n+      this.position += 5;\n+      return false;\n+    }\n+    if (this.text.startsWith(\"null\", this.position)) {\n+      throw new CanonicalProfileError(\"null_value\");\n+    }\n+    throw new CanonicalProfileError(\"syntax\");\n+  }\n+\n+  private enterContainer(depth: number): void {\n+    if (depth > PROFILE_LIMITS.max_depth) {\n+      throw new CanonicalProfileError(\"too_deep\");\n+    }\n+  }\n+\n+  private parseObject(depth: number): CanonicalValue {\n+    this.enterContainer(depth);\n+    this.position += 1;\n+    this.skipWhitespace();\n+    if (this.peek() === \"}\") {\n+      this.position += 1;\n+      return new Map();\n+    }\n+\n+    const members: Array<[string, CanonicalValue]> = [];\n+    while (true) {\n+      if (this.peek() !== '\"') throw new CanonicalProfileError(\"syntax\");\n+      const key = this.parseString();\n+      this.skipWhitespace();\n+      if (this.peek() !== \":\") throw new CanonicalProfileError(\"syntax\");\n+      this.position += 1;\n+      this.skipWhitespace();\n+      const value = this.parseValue(depth);\n+      members.push([key, value]);\n+      if (members.length > PROFILE_LIMITS.max_container_entries) {\n+        throw new CanonicalProfileError(\"too_many_entries\");\n+      }\n+      this.skipWhitespace();\n+\n+      if (this.peek() === \",\") {\n+        this.position += 1;\n+        this.skipWhitespace();\n+        continue;\n+      }\n+      if (this.peek() !== \"}\") throw new CanonicalProfileError(\"syntax\");\n+      this.position += 1;\n+\n+      const object = new Map<string, CanonicalValue>();\n+      for (const [memberName, memberValue] of members) {\n+        if (object.has(memberName)) {\n+          throw new CanonicalProfileError(\"duplicate_key\");\n+        }\n+        object.set(memberName, memberValue);\n+      }\n+      return object;\n+    }\n+  }\n+\n+  private parseArray(depth: number): CanonicalValue {\n+    this.enterContainer(depth);\n+    this.position += 1;\n+    this.skipWhitespace();\n+    if (this.peek() === \"]\") {\n+      this.position += 1;\n+      return [];\n+    }\n+\n+    const items: CanonicalValue[] = [];\n+    while (true) {\n+      items.push(this.parseValue(depth));\n+      if (items.length > PROFILE_LIMITS.max_container_entries) {\n+        throw new CanonicalProfileError(\"too_many_entries\");\n+      }\n+      this.skipWhitespace();\n+\n+      if (this.peek() === \",\") {\n+        this.position += 1;\n+        this.skipWhitespace();\n+        continue;\n+      }\n+      if (this.peek() !== \"]\") throw new CanonicalProfileError(\"syntax\");\n+      this.position += 1;\n+      return items;\n+    }\n+  }\n+\n+  private parseInteger(): number {\n+    const start = this.position;\n+    const negative = this.peek() === \"-\";\n+    if (negative) this.position += 1;\n+    const digitsStart = this.position;\n+\n+    if (this.peek() === \"0\") {\n+      this.position += 1;\n+    } else {\n+      const first = this.peek();\n+      if (first === undefined || first < \"1\" || first > \"9\") {\n+        throw new CanonicalProfileError(\"syntax\");\n+      }\n+      while (this.isDigit(this.peek())) this.position += 1;\n+    }\n+\n+    if (\".eE\".includes(this.peek() ?? \"\\0\")) {\n+      throw new CanonicalProfileError(\"non_integer_number\");\n+    }\n+\n+    const digits = this.text.slice(digitsStart, this.position);\n+    const magnitude = BigInt(digits);\n+    if (magnitude > MAX_SAFE_INTEGER_BIGINT) {\n+      throw new CanonicalProfileError(\"integer_out_of_range\");\n+    }\n+    if (negative && magnitude === 0n) {\n+      throw new CanonicalProfileError(\"negative_zero\");\n+    }\n+    return Number(negative ? -magnitude : magnitude);\n+  }\n+\n+  private isDigit(value: string | undefined): boolean {\n+    return value !== undefined && value >= \"0\" && value <= \"9\";\n+  }\n+\n+  private parseString(): string {\n+    this.position += 1;\n+    const output: string[] = [];\n+    let decodedBytes = 0;\n+\n+    const append = (codePoint: number): void => {\n+      decodedBytes += this.appendScalar(output, codePoint);\n+    };\n+\n+    while (true) {\n+      const current = this.peek();\n+      if (current === undefined) throw new CanonicalProfileError(\"syntax\");\n+      if (current === '\"') {\n+        this.position += 1;\n+        return output.join(\"\");\n+      }\n+      if (current === \"\\\\\") {\n+        this.position += 1;\n+        const escape = this.peek();\n+        switch (escape) {\n+          case '\"':\n+          case \"\\\\\":\n+          case \"/\":\n+            append(escape.codePointAt(0)!);\n+            this.position += 1;\n+            break;\n+          case \"b\":\n+            append(0x08);\n+            this.position += 1;\n+            break;\n+          case \"f\":\n+            append(0x0c);\n+            this.position += 1;\n+            break;\n+          case \"n\":\n+            append(0x0a);\n+            this.position += 1;\n+            break;\n+          case \"r\":\n+            append(0x0d);\n+            this.position += 1;\n+            break;\n+          case \"t\":\n+            append(0x09);\n+            this.position += 1;\n+            break;\n+          case \"u\":\n+            this.position += 1;\n+            append(this.parseUnicodeEscape());\n+            break;\n+          default:\n+            throw new CanonicalProfileError(\"syntax\");\n+        }\n+      } else {\n+        const codeUnit = this.text.charCodeAt(this.position);\n+        if (codeUnit < 0x20) throw new CanonicalProfileError(\"syntax\");\n+        const codePoint = this.text.codePointAt(this.position);\n+        if (codePoint === undefined) throw new CanonicalProfileError(\"syntax\");\n+        append(codePoint);\n+        this.position += codePoint > 0xffff ? 2 : 1;\n+      }\n+\n+      if (decodedBytes > PROFILE_LIMITS.max_string_bytes) {\n+        throw new CanonicalProfileError(\"string_too_long\");\n+      }\n+    }\n+  }\n+\n+  private parseUnicodeEscape(): number {\n+    const first = this.parseHex4();\n+    if (first >= 0xd800 && first <= 0xdbff) {\n+      if (this.text.slice(this.position, this.position + 2) !== \"\\\\u\") {\n+        throw new CanonicalProfileError(\"lone_surrogate\");\n+      }\n+      this.position += 2;\n+      const second = this.parseHex4();\n+      if (second < 0xdc00 || second > 0xdfff) {\n+        throw new CanonicalProfileError(\"lone_surrogate\");\n+      }\n+      return 0x10000 + ((first - 0xd800) << 10) + (second - 0xdc00);\n+    }\n+    if (first >= 0xdc00 && first <= 0xdfff) {\n+      throw new CanonicalProfileError(\"lone_surrogate\");\n+    }\n+    return first;\n+  }\n+\n+  private parseHex4(): number {\n+    const digits = this.text.slice(this.position, this.position + 4);\n+    if (!/^[0-9a-fA-F]{4}$/.test(digits)) {\n+      throw new CanonicalProfileError(\"syntax\");\n+    }\n+    this.position += 4;\n+    return Number.parseInt(digits, 16);\n+  }\n+\n+  private appendScalar(output: string[], codePoint: number): number {\n+    if (\n+      (codePoint >= 0xfdd0 && codePoint <= 0xfdef) ||\n+      (codePoint & 0xfffe) === 0xfffe\n+    ) {\n+      throw new CanonicalProfileError(\"noncharacter\");\n+    }\n+    output.push(String.fromCodePoint(codePoint));\n+    if (codePoint <= 0x7f) return 1;\n+    if (codePoint <= 0x7ff) return 2;\n+    if (codePoint <= 0xffff) return 3;\n+    return 4;\n+  }\n+}\n+\n+export function parseCanonicalJson(input: Uint8Array): CanonicalValue {\n+  if (input.byteLength > PROFILE_LIMITS.max_document_bytes) {\n+    throw new CanonicalProfileError(\"too_large\");\n+  }\n+  if (\n+    input.byteLength >= 3 &&\n+    input[0] === 0xef &&\n+    input[1] === 0xbb &&\n+    input[2] === 0xbf\n+  ) {\n+    throw new CanonicalProfileError(\"byte_order_mark\");\n+  }\n+\n+  let text: string;\n+  try {\n+    text = decoder.decode(input);\n+  } catch {\n+    throw new CanonicalProfileError(\"invalid_utf8\");\n+  }\n+  return new Parser(text).parse();\n+}\n+\n+export function compareUtf16(left: string, right: string): number {\n+  return left < right ? -1 : left > right ? 1 : 0;\n+}\n+\n+function quoteCanonicalString(value: string): string {\n+  let output = '\"';\n+  for (const character of value) {\n+    const codePoint = character.codePointAt(0)!;\n+    switch (codePoint) {\n+      case 0x22:\n+        output += '\\\\\"';\n+        break;\n+      case 0x5c:\n+        output += \"\\\\\\\\\";\n+        break;\n+      case 0x08:\n+        output += \"\\\\b\";\n+        break;\n+      case 0x0c:\n+        output += \"\\\\f\";\n+        break;\n+      case 0x0a:\n+        output += \"\\\\n\";\n+        break;\n+      case 0x0d:\n+        output += \"\\\\r\";\n+        break;\n+      case 0x09:\n+        output += \"\\\\t\";\n+        break;\n+      default:\n+        output +=\n+          codePoint < 0x20\n+            ? `\\\\u${codePoint.toString(16).padStart(4, \"0\")}`\n+            : character;\n+    }\n+  }\n+  return output + '\"';\n+}\n+\n+export function canonicalStringify(value: CanonicalValue): string {\n+  if (typeof value === \"boolean\") return value ? \"true\" : \"false\";\n+  if (typeof value === \"number\") {\n+    if (!Number.isSafeInteger(value) || Object.is(value, -0)) {\n+      throw new Error(\"canonicalStringify received an out-of-profile number\");\n+    }\n+    return value.toString(10);\n+  }\n+  if (typeof value === \"string\") return quoteCanonicalString(value);\n+  if (Array.isArray(value)) {\n+    return `[${value.map(canonicalStringify).join(\",\")}]`;\n+  }\n+  if (value instanceof Map) {\n+    const members = Array.from(value.entries()).sort(([left], [right]) =>\n+      compareUtf16(left, right),\n+    );\n+    return `{${members\n+      .map(([key, memberValue]) =>\n+        `${quoteCanonicalString(key)}:${canonicalStringify(memberValue)}`,\n+      )\n+      .join(\",\")}}`;\n+  }\n+  throw new Error(\"canonicalStringify received an unsupported value\");\n+}\n+\n+export function canonicalizeValue(value: CanonicalValue): Buffer {\n+  return Buffer.from(canonicalStringify(value), \"utf8\");\n+}\n+\n+export function canonicalizeJson(input: Uint8Array): Buffer {\n+  return canonicalizeValue(parseCanonicalJson(input));\n+}"},{"sha":"b819d2fbaa8b6d3c4be5e5f1fd0c31a2278b8e16","filename":"packages/aethyme-eval/local-v3/t01-canonical-parity/records.mts","status":"added","additions":224,"deletions":0,"changes":224,"blob_url":"https://github.com/schiste/Aethyme/blob/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Frecords.mts","raw_url":"https://github.com/schiste/Aethyme/raw/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Frecords.mts","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Frecords.mts?ref=48ae7c6df372a7f71302c1febf6d8d87870c9fab","patch":"@@ -0,0 +1,224 @@\n+import { Buffer } from \"node:buffer\";\n+import { createHash } from \"node:crypto\";\n+import {\n+  canonicalizeValue,\n+  compareUtf16,\n+  parseCanonicalJson,\n+  type CanonicalValue,\n+} from \"./canonical-json.mts\";\n+\n+export type RecordField = {\n+  name: string;\n+  required: boolean;\n+  kind: string;\n+  values?: string[];\n+  capability?: string;\n+};\n+\n+export type RecordSchema = {\n+  name: string;\n+  capabilities: string[];\n+  fields: RecordField[];\n+};\n+\n+export type RecordReading =\n+  | { kind: \"known\"; value: string }\n+  | { kind: \"unknown\" }\n+  | { kind: \"unrecognized\"; value: string };\n+\n+export type DecodedRecord = {\n+  schema: RecordSchema;\n+  object: Map<string, CanonicalValue>;\n+  canonicalBytes: Buffer;\n+  id: string;\n+};\n+\n+export class RecordProfileError extends Error {\n+  readonly code: string;\n+\n+  constructor(code: string) {\n+    super(code);\n+    this.name = \"RecordProfileError\";\n+    this.code = code;\n+  }\n+}\n+\n+const RECORD_DOMAIN = Buffer.from(\"aethyme record v0\\0\", \"utf8\");\n+const MAX_DECIMAL_DIGITS = 78;\n+const UNKNOWN_STATE = \"unknown\";\n+\n+function recordError(code: string): never {\n+  throw new RecordProfileError(code);\n+}\n+\n+function isString(value: CanonicalValue | undefined): value is string {\n+  return typeof value === \"string\";\n+}\n+\n+function stringSet(field: string, value: CanonicalValue): string[] {\n+  if (!Array.isArray(value)) recordError(\"wrong_type\");\n+  if (!value.every((item) => typeof item === \"string\")) {\n+    recordError(\"wrong_type\");\n+  }\n+\n+  const sorted = [...value].sort((left, right) =>\n+    compareUtf16(left as string, right as string),\n+  ) as string[];\n+  for (let index = 1; index < sorted.length; index += 1) {\n+    if (sorted[index - 1] === sorted[index]) {\n+      recordError(\"duplicate_set_member\");\n+    }\n+  }\n+  return sorted;\n+}\n+\n+function checkField(field: RecordField, value: CanonicalValue): CanonicalValue {\n+  switch (field.kind) {\n+    case \"boolean\":\n+      if (typeof value !== \"boolean\") recordError(\"wrong_type\");\n+      return value;\n+    case \"integer\":\n+      if (typeof value !== \"number\") recordError(\"wrong_type\");\n+      return value;\n+    case \"string\":\n+    case \"state\":\n+      if (typeof value !== \"string\") recordError(\"wrong_type\");\n+      return value;\n+    case \"decimal_string\": {\n+      if (typeof value !== \"string\") recordError(\"wrong_type\");\n+      const canonical =\n+        value.length > 0 &&\n+        value.length <= MAX_DECIMAL_DIGITS &&\n+        /^[0-9]+$/.test(value) &&\n+        (value === \"0\" || !value.startsWith(\"0\"));\n+      if (!canonical) recordError(\"invalid_decimal\");\n+      return value;\n+    }\n+    case \"string_set\":\n+      return stringSet(field.name, value);\n+    case \"opaque\":\n+      return value;\n+    default:\n+      throw new Error(`unknown frozen record field kind: ${field.kind}`);\n+  }\n+}\n+\n+function sha256(bytes: Uint8Array): string {\n+  return createHash(\"sha256\").update(bytes).digest(\"hex\");\n+}\n+\n+export function isCanonicalRecordId(value: string): boolean {\n+  return /^sha256:[0-9a-f]{64}$/.test(value);\n+}\n+\n+export function decodeRecord(\n+  input: Uint8Array,\n+  schemas: RecordSchema[],\n+): DecodedRecord {\n+  const value = parseCanonicalJson(input);\n+  if (!(value instanceof Map)) recordError(\"not_an_object\");\n+\n+  const schemaValue = value.get(\"schema\");\n+  if (schemaValue === undefined) recordError(\"missing_field\");\n+  if (!isString(schemaValue)) recordError(\"wrong_type\");\n+\n+  const schema = schemas.find((candidate) => candidate.name === schemaValue);\n+  if (schema === undefined) recordError(\"unsupported_schema\");\n+\n+  const normalized = new Map<string, CanonicalValue>();\n+  for (const [name, memberValue] of value.entries()) {\n+    let kept: CanonicalValue | undefined;\n+    if (name === \"schema\") {\n+      kept = memberValue;\n+    } else if (name === \"requires\") {\n+      const requiredCapabilities = stringSet(name, memberValue);\n+      for (const capability of requiredCapabilities) {\n+        if (!schema.capabilities.includes(capability)) {\n+          recordError(\"unsupported_capability\");\n+        }\n+      }\n+      if (requiredCapabilities.length > 0) kept = requiredCapabilities;\n+    } else if (name === \"extensions\") {\n+      if (!(memberValue instanceof Map)) recordError(\"wrong_type\");\n+      kept = memberValue;\n+    } else {\n+      const field = schema.fields.find((candidate) => candidate.name === name);\n+      if (field === undefined) {\n+        kept = memberValue;\n+      } else {\n+        const checked = checkField(field, memberValue);\n+        const unknownState =\n+          field.kind === \"state\" && checked === UNKNOWN_STATE;\n+        if (!unknownState) kept = checked;\n+      }\n+    }\n+    if (kept !== undefined) normalized.set(name, kept);\n+  }\n+\n+  const missing = schema.fields.find(\n+    (field) =>\n+      field.required &&\n+      field.kind !== \"state\" &&\n+      !value.has(field.name),\n+  );\n+  if (missing !== undefined) recordError(\"missing_field\");\n+\n+  const declared = value.get(\"requires\");\n+  const declaredCapabilities = Array.isArray(declared)\n+    ? declared.filter((item): item is string => typeof item === \"string\")\n+    : [];\n+  const undeclared = schema.fields.find(\n+    (field) =>\n+      field.capability !== undefined &&\n+      !declaredCapabilities.includes(field.capability) &&\n+      value.has(field.name),\n+  );\n+  if (undeclared !== undefined) recordError(\"undeclared_capability\");\n+\n+  const canonicalBytes = canonicalizeValue(normalized);\n+  const id = `sha256:${sha256(Buffer.concat([RECORD_DOMAIN, canonicalBytes]))}`;\n+  return { schema, object: normalized, canonicalBytes, id };\n+}\n+\n+export function readState(record: DecodedRecord, fieldName: string): RecordReading {\n+  const field = record.schema.fields.find(\n+    (candidate) => candidate.name === fieldName && candidate.kind === \"state\",\n+  );\n+  if (field === undefined) {\n+    throw new Error(`${fieldName} is not a state field in ${record.schema.name}`);\n+  }\n+  const value = record.object.get(fieldName);\n+  if (value === undefined || value === UNKNOWN_STATE) return { kind: \"unknown\" };\n+  if (typeof value !== \"string\") {\n+    throw new Error(`${fieldName} was not validated as a string`);\n+  }\n+  if (field.values?.includes(value)) return { kind: \"known\", value };\n+  return { kind: \"unrecognized\", value };\n+}\n+\n+export function stateReadingText(reading: RecordReading): string {\n+  switch (reading.kind) {\n+    case \"known\":\n+      return `known:${reading.value}`;\n+    case \"unrecognized\":\n+      return `unrecognized:${reading.value}`;\n+    case \"unknown\":\n+      return \"unknown\";\n+  }\n+}\n+\n+export function stateMatches(reading: RecordReading, value: string): boolean {\n+  return reading.kind === \"known\" && reading.value === value;\n+}\n+\n+export function requiredCapabilities(\n+  schema: RecordSchema,\n+  memberNames: string[],\n+): string[] {\n+  const capabilities = new Set<string>();\n+  for (const name of memberNames) {\n+    const field = schema.fields.find((candidate) => candidate.name === name);\n+    if (field?.capability !== undefined) capabilities.add(field.capability);\n+  }\n+  return [...capabilities].sort(compareUtf16);\n+}"},{"sha":"bf40a93b10977a48f0b39dc8ee729ad5c5ed4af3","filename":"packages/aethyme-eval/local-v3/t01-canonical-parity/source-snapshot.mts","status":"added","additions":240,"deletions":0,"changes":240,"blob_url":"https://github.com/schiste/Aethyme/blob/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Fsource-snapshot.mts","raw_url":"https://github.com/schiste/Aethyme/raw/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Fsource-snapshot.mts","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Fsource-snapshot.mts?ref=48ae7c6df372a7f71302c1febf6d8d87870c9fab","patch":"@@ -0,0 +1,240 @@\n+import { Buffer } from \"node:buffer\";\n+import { createHash } from \"node:crypto\";\n+\n+export type SnapshotEntryVector = {\n+  path_hex: string;\n+  mode: string;\n+  content_hex: string;\n+};\n+\n+export type SnapshotVector = {\n+  name: string;\n+  entries: SnapshotEntryVector[];\n+  manifest_hex?: string;\n+  id?: string;\n+  error?: string;\n+};\n+\n+export type SnapshotVectors = {\n+  valid: SnapshotVector[];\n+  invalid: SnapshotVector[];\n+  unsupported_modes: string[];\n+  malformed_ids: string[];\n+};\n+\n+type EntryKind = {\n+  mode: \"100644\" | \"100755\" | \"120000\";\n+};\n+\n+type SourceEntry = {\n+  path: Buffer;\n+  kind: EntryKind;\n+  contentSha256: Buffer;\n+};\n+\n+export class SnapshotProfileError extends Error {\n+  readonly code: string;\n+\n+  constructor(code: string) {\n+    super(code);\n+    this.name = \"SnapshotProfileError\";\n+    this.code = code;\n+  }\n+}\n+\n+const MANIFEST_HEADER = Buffer.from(\"aethyme source-snapshot v0\\0\", \"utf8\");\n+const MAX_PATH_BYTES = 4096;\n+const utf8Decoder = new TextDecoder(\"utf-8\", { fatal: true });\n+\n+function snapshotError(code: string): never {\n+  throw new SnapshotProfileError(code);\n+}\n+\n+function decodeHex(encoded: string): Buffer {\n+  if (\n+    encoded.length % 2 !== 0 ||\n+    !/^[0-9a-f]*$/.test(encoded)\n+  ) {\n+    throw new Error(\"invalid frozen lowercase hex\");\n+  }\n+  return Buffer.from(encoded, \"hex\");\n+}\n+\n+function hex(bytes: Uint8Array): string {\n+  return Buffer.from(bytes).toString(\"hex\");\n+}\n+\n+function compareBytes(left: Uint8Array, right: Uint8Array): number {\n+  const limit = Math.min(left.byteLength, right.byteLength);\n+  for (let index = 0; index < limit; index += 1) {\n+    const difference = left[index] - right[index];\n+    if (difference !== 0) return difference;\n+  }\n+  return left.byteLength - right.byteLength;\n+}\n+\n+function equalAsciiCaseInsensitive(bytes: Uint8Array, expected: string): boolean {\n+  if (bytes.byteLength !== expected.length) return false;\n+  for (let index = 0; index < bytes.byteLength; index += 1) {\n+    const byte = bytes[index];\n+    const lower = byte >= 0x41 && byte <= 0x5a ? byte + 0x20 : byte;\n+    if (lower !== expected.charCodeAt(index)) return false;\n+  }\n+  return true;\n+}\n+\n+function isGitComponent(component: Uint8Array): boolean {\n+  let hfsEquivalent = Buffer.from(component);\n+  try {\n+    const decoded = utf8Decoder.decode(component);\n+    const filtered = [...decoded]\n+      .filter(\n+        (character) =>\n+          !(\n+            (character >= \"\\u200c\" && character <= \"\\u200f\") ||\n+            (character >= \"\\u202a\" && character <= \"\\u202e\") ||\n+            (character >= \"\\u206a\" && character <= \"\\u206f\") ||\n+            character === \"\\ufeff\"\n+          ),\n+      )\n+      .join(\"\");\n+    hfsEquivalent = Buffer.from(filtered, \"utf8\");\n+  } catch {\n+    // Rust keeps invalid UTF-8 path components byte-for-byte for this check.\n+  }\n+\n+  if (equalAsciiCaseInsensitive(hfsEquivalent, \".git\")) return true;\n+\n+  let colon = component.indexOf(0x3a);\n+  if (colon < 0) colon = component.byteLength;\n+  let stem = Buffer.from(component.subarray(0, colon));\n+  while (\n+    stem.byteLength > 0 &&\n+    (stem[stem.byteLength - 1] === 0x2e || stem[stem.byteLength - 1] === 0x20)\n+  ) {\n+    stem = stem.subarray(0, stem.byteLength - 1);\n+  }\n+  return (\n+    equalAsciiCaseInsensitive(stem, \".git\") ||\n+    equalAsciiCaseInsensitive(stem, \"git~1\")\n+  );\n+}\n+\n+function validatePath(path: Uint8Array): void {\n+  if (path.byteLength === 0) snapshotError(\"invalid_path:empty\");\n+  if (path.byteLength > MAX_PATH_BYTES) snapshotError(\"invalid_path:too_long\");\n+  if (path.includes(0)) snapshotError(\"invalid_path:contains_nul\");\n+  if (path[0] === 0x2f) snapshotError(\"invalid_path:absolute\");\n+  if (path[path.byteLength - 1] === 0x2f) {\n+    snapshotError(\"invalid_path:trailing_slash\");\n+  }\n+\n+  let componentStart = 0;\n+  for (let index = 0; index <= path.byteLength; index += 1) {\n+    if (index !== path.byteLength && path[index] !== 0x2f) continue;\n+    const component = path.subarray(componentStart, index);\n+    if (component.byteLength === 0) {\n+      snapshotError(\"invalid_path:empty_component\");\n+    }\n+    if (\n+      (component.byteLength === 1 && component[0] === 0x2e) ||\n+      (component.byteLength === 2 &&\n+        component[0] === 0x2e &&\n+        component[1] === 0x2e)\n+    ) {\n+      snapshotError(\"invalid_path:relative_component\");\n+    }\n+    if (isGitComponent(component)) {\n+      snapshotError(\"invalid_path:git_component\");\n+    }\n+    componentStart = index + 1;\n+  }\n+}\n+\n+function entryKind(mode: string): EntryKind {\n+  if (mode === \"100644\" || mode === \"100755\" || mode === \"120000\") {\n+    return { mode };\n+  }\n+  snapshotError(\"unsupported_mode\");\n+}\n+\n+function entries(vectors: SnapshotEntryVector[]): SourceEntry[] {\n+  return vectors.map((vector) => {\n+    const kind = entryKind(vector.mode);\n+    const path = decodeHex(vector.path_hex);\n+    const content = decodeHex(vector.content_hex);\n+    return {\n+      path,\n+      kind,\n+      contentSha256: createHash(\"sha256\").update(content).digest(),\n+    };\n+  });\n+}\n+\n+function validateAndSort(inputEntries: SourceEntry[]): SourceEntry[] {\n+  for (const entry of inputEntries) validatePath(entry.path);\n+  const sorted = [...inputEntries].sort((left, right) =>\n+    compareBytes(left.path, right.path),\n+  );\n+\n+  for (let index = 1; index < sorted.length; index += 1) {\n+    if (compareBytes(sorted[index - 1].path, sorted[index].path) === 0) {\n+      snapshotError(\"duplicate_path\");\n+    }\n+  }\n+\n+  const directories = new Set<string>();\n+  for (const entry of sorted) {\n+    for (let index = 0; index < entry.path.byteLength; index += 1) {\n+      if (entry.path[index] === 0x2f) {\n+        directories.add(hex(entry.path.subarray(0, index)));\n+      }\n+    }\n+  }\n+  if (sorted.some((entry) => directories.has(hex(entry.path)))) {\n+    snapshotError(\"file_directory_conflict\");\n+  }\n+  return sorted;\n+}\n+\n+function manifestBytes(sortedEntries: SourceEntry[]): Buffer {\n+  const parts: Buffer[] = [MANIFEST_HEADER];\n+  for (const entry of sortedEntries) {\n+    parts.push(\n+      Buffer.from(\n+        `${entry.kind.mode} ${entry.contentSha256.toString(\"hex\")} `,\n+        \"ascii\",\n+      ),\n+      entry.path,\n+      Buffer.from([0]),\n+    );\n+  }\n+  return Buffer.concat(parts);\n+}\n+\n+function snapshotId(manifest: Uint8Array): string {\n+  return `sha256:${createHash(\"sha256\").update(manifest).digest(\"hex\")}`;\n+}\n+\n+export function isCanonicalSnapshotId(value: string): boolean {\n+  return /^sha256:[0-9a-f]{64}$/.test(value);\n+}\n+\n+export function qualifyValidSnapshot(vector: SnapshotVector): {\n+  manifest: Buffer;\n+  id: string;\n+} {\n+  const sorted = validateAndSort(entries(vector.entries));\n+  const manifest = manifestBytes(sorted);\n+  return { manifest, id: snapshotId(manifest) };\n+}\n+\n+export function qualifyInvalidSnapshot(vector: SnapshotVector): never {\n+  validateAndSort(entries(vector.entries));\n+  throw new Error(`invalid snapshot was accepted: ${vector.name}`);\n+}\n+\n+export function qualifyUnsupportedMode(mode: string): never {\n+  entryKind(mode);\n+  throw new Error(`unsupported entry mode was accepted: ${mode}`);\n+}"},{"sha":"330d900b6ac01133dd52765487f18b939f8ef2cc","filename":"packages/aethyme-eval/local-v3/t01-canonical-parity/t01-canonical-parity.mts","status":"added","additions":821,"deletions":0,"changes":821,"blob_url":"https://github.com/schiste/Aethyme/blob/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Ft01-canonical-parity.mts","raw_url":"https://github.com/schiste/Aethyme/raw/48ae7c6df372a7f71302c1febf6d8d87870c9fab/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Ft01-canonical-parity.mts","contents_url":"https://api.github.com/repos/schiste/Aethyme/contents/packages%2Faethyme-eval%2Flocal-v3%2Ft01-canonical-parity%2Ft01-canonical-parity.mts?ref=48ae7c6df372a7f71302c1febf6d8d87870c9fab","patch":"@@ -0,0 +1,821 @@\n+import { Buffer } from \"node:buffer\";\n+import { createHash } from \"node:crypto\";\n+import { readFileSync } from \"node:fs\";\n+import { dirname, resolve } from \"node:path\";\n+import { fileURLToPath } from \"node:url\";\n+import {\n+  canonicalizeValue,\n+  parseCanonicalJson,\n+  PROFILE_LIMITS,\n+} from \"./canonical-json.mts\";\n+import {\n+  decodeRecord,\n+  isCanonicalRecordId,\n+  readState,\n+  requiredCapabilities,\n+  stateMatches,\n+  stateReadingText,\n+  type RecordSchema,\n+} from \"./records.mts\";\n+import {\n+  isCanonicalSnapshotId,\n+  qualifyInvalidSnapshot,\n+  qualifyUnsupportedMode,\n+  qualifyValidSnapshot,\n+  type SnapshotVectors,\n+} from \"./source-snapshot.mts\";\n+import {\n+  BRIEF_LIMITS,\n+  BRIEF_SCHEMA_NAME,\n+  BRIEF_TOKEN_PROFILE,\n+  BriefProfileError,\n+  countBriefTokens,\n+  makeBriefRecord,\n+  validateBriefDecisionFile,\n+  validateBriefRecord,\n+  type Brief,\n+} from \"./brief-profile.mts\";\n+\n+type CanonicalInput =\n+  | { hex: string }\n+  | { repeat: [string, string, number, string] };\n+\n+type CanonicalOutput =\n+  | { hex: string }\n+  | { sha256: string };\n+\n+type CanonicalCase = {\n+  name: string;\n+  input: CanonicalInput;\n+  canonical: CanonicalOutput;\n+};\n+\n+type InvalidCanonicalCase = {\n+  name: string;\n+  input: CanonicalInput;\n+  error: string;\n+};\n+\n+type CanonicalVectors = {\n+  limits: {\n+    max_document_bytes: number;\n+    max_depth: number;\n+    max_string_bytes: number;\n+    max_container_entries: number;\n+    max_safe_integer: number;\n+  };\n+  valid: CanonicalCase[];\n+  invalid: InvalidCanonicalCase[];\n+};\n+\n+type RecordValidCase = {\n+  name: string;\n+  reader: string;\n+  input: { hex: string };\n+  canonical_hex: string;\n+  id: string;\n+  states: Record<string, string>;\n+  equivalence_class: string;\n+};\n+\n+type RecordInvalidCase = {\n+  name: string;\n+  reader: string;\n+  input: { hex: string };\n+  error: string;\n+};\n+\n+type RecordVectors = {\n+  domain_hex: string;\n+  readers: Record<string, RecordSchema[]>;\n+  valid: RecordValidCase[];\n+  invalid: RecordInvalidCase[];\n+};\n+\n+type BriefTokenVectors = {\n+  profile: string;\n+  cases: Array<{ text: string; tokens: number }>;\n+};\n+\n+type BriefVectors = {\n+  profile: string;\n+  schema: string;\n+  limits: {\n+    max_tokens: number;\n+    max_prose_bytes: number;\n+    max_list_entries: number;\n+    max_scope_ref_bytes: number;\n+    max_record_bytes: number;\n+  };\n+  valid: Array<{\n+    name: string;\n+    input: { hex: string };\n+    tokens: number;\n+    record_hex: string;\n+    id: string;\n+    equivalence_class: string;\n+  }>;\n+  invalid_decision_files: Array<{\n+    name: string;\n+    input: { hex: string };\n+    errors: Array<[string, string]>;\n+  }>;\n+  valid_records: Array<{\n+    name: string;\n+    input: { hex: string };\n+    id: string;\n+  }>;\n+  invalid_records: Array<{\n+    name: string;\n+    input: { hex: string };\n+    errors: Array<[string, string]>;\n+  }>;\n+};\n+\n+type BriefCalibrationVectors = {\n+  reference: string;\n+  cases: Array<{ text: string; reference_tokens: number }>;\n+};\n+\n+const HERE = dirname(fileURLToPath(import.meta.url));\n+const REPO_ROOT = resolve(HERE, \"../../../../\");\n+const REFERENCE_COMMIT = \"025103777c16607639073cbf9024d2ad0c39f72d\";\n+const TYPESCRIPT_SOURCES = [\n+  \"canonical-json.mts\",\n+  \"records.mts\",\n+  \"source-snapshot.mts\",\n+  \"brief-profile.mts\",\n+  \"t01-canonical-parity.mts\",\n+] as const;\n+const FROZEN_SOURCES = [\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/fixtures/experimental-v0/canonical_json.json\",\n+    sha256: \"23aeb5caff95304ae2047e1b13eca3825cb8cebb46e1e56676db2b4ef7001450\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/fixtures/experimental-v0/records.json\",\n+    sha256: \"2c6e2a21c1cd7e3fad9f670152bf04ae474fbfb87e12c74901088e9f96c3176b\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/fixtures/experimental-v0/source_snapshot.json\",\n+    sha256: \"9d5f05a3525e9000875e3f0fc6c3ad41802a23c9336e6f82f6e9e781ef622840\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/tests/canonical_json_vectors.rs\",\n+    sha256: \"403d6afa08ac94b71b1386bc20a50b401e513cb9765f2d60007c3ff7e8bba96e\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/tests/record_vectors.rs\",\n+    sha256: \"563bd824740be45f994d50999da3f1a6dccb50b3f652378a9c0fd94533207c61\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/tests/source_snapshot_vectors.rs\",\n+    sha256: \"881fb26bddb06042605b922dd706430502de4e4354ab6cfa9eefe53150623a40\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/src/experimental_v0/canonical_json.rs\",\n+    sha256: \"90070c56f613bb94564072c56076daf2428f2888f0b71e34a526b718c55b52f3\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/src/experimental_v0/record.rs\",\n+    sha256: \"d4888555e1653ea8897f383dfb6f6f9c50e5e2abd19ee113eb440ee575ad4400\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/src/experimental_v0/source_snapshot.rs\",\n+    sha256: \"d36bcd57d0f2ccc47aff1a4c69d5ee974d09a22879cfc0ce938687761737ed14\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/fixtures/experimental-v0/brief_tokens.json\",\n+    sha256: \"cff420ec39830255df6b3f408eae566bbccbb7a7759cffc877c797a0cee1ffd1\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/fixtures/experimental-v0/briefs.json\",\n+    sha256: \"08aec8cb3a1722a5c41c0ff2c5efc359e8cc084130be9b521564e3edd45369fd\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/fixtures/experimental-v0/brief_calibration.json\",\n+    sha256: \"d4f62dfbe73d2906fe766d70bb240d16717d1eaf53b7bddbe6bd55de5cc7d695\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/tests/brief_vectors.rs\",\n+    sha256: \"22540d74de0440ddfc1faa6e3b7479e49c00fb8a13ff05e300667052edf803e7\",\n+  },\n+  {\n+    path: \"packages/aethyme/rust/crates/aethyme-contracts/src/experimental_v0/brief.rs\",\n+    sha256: \"3a903fbadb0775a0bc9ac669f2e8b8b37fb6c54ca4f0687571ae315474792a17\",\n+  },\n+] as const;\n+\n+const BRIEF_TOKEN_VECTORS_PATH =\n+  \"packages/aethyme/rust/crates/aethyme-contracts/fixtures/experimental-v0/brief_tokens.json\";\n+const BRIEF_VECTORS_PATH =\n+  \"packages/aethyme/rust/crates/aethyme-contracts/fixtures/experimental-v0/briefs.json\";\n+const BRIEF_CALIBRATION_PATH =\n+  \"packages/aethyme/rust/crates/aethyme-contracts/fixtures/experimental-v0/brief_calibration.json\";\n+\n+let assertionCount = 0;\n+\n+function check(condition: boolean, message: string): asserts condition {\n+  assertionCount += 1;\n+  if (!condition) throw new Error(message);\n+}\n+\n+function sha256(bytes: Uint8Array): string {\n+  return createHash(\"sha256\").update(bytes).digest(\"hex\");\n+}\n+\n+function decodeHex(encoded: string): Buffer {\n+  check(\n+    encoded.length % 2 === 0 && /^[0-9a-f]*$/.test(encoded),\n+    \"frozen fixture contains non-canonical lowercase hex\",\n+  );\n+  return Buffer.from(encoded, \"hex\");\n+}\n+\n+function bytesForInput(input: CanonicalInput): Buffer {\n+  if (\"hex\" in input) return decodeHex(input.hex);\n+\n+  const [prefixHex, unitHex, count, suffixHex] = input.repeat;\n+  check(Number.isSafeInteger(count) && count >= 0, \"invalid repeat count\");\n+  const prefix = decodeHex(prefixHex);\n+  const unit = decodeHex(unitHex);\n+  const suffix = decodeHex(suffixHex);\n+  const output = Buffer.alloc(\n+    prefix.byteLength + unit.byteLength * count + suffix.byteLength,\n+  );\n+  let offset = 0;\n+  prefix.copy(output, offset);\n+  offset += prefix.byteLength;\n+  for (let index = 0; index < count; index += 1) {\n+    unit.copy(output, offset);\n+    offset += unit.byteLength;\n+  }\n+  suffix.copy(output, offset);\n+  return output;\n+}\n+\n+function codeFrom(error: unknown): string | undefined {\n+  if (\n+    typeof error === \"object\" &&\n+    error !== null &&\n+    \"code\" in error &&\n+    typeof error.code === \"string\"\n+  ) {\n+    return error.code;\n+  }\n+  return undefined;\n+}\n+\n+function refusalCode(operation: () => unknown): string | undefined {\n+  try {\n+    operation();\n+    return undefined;\n+  } catch (error) {\n+    return codeFrom(error);\n+  }\n+}\n+\n+function readFrozenSources(): {\n+  canonical: CanonicalVectors;\n+  records: RecordVectors;\n+  snapshots: SnapshotVectors;\n+  briefTokens: BriefTokenVectors;\n+  briefs: BriefVectors;\n+  calibration: BriefCalibrationVectors;\n+  hashes: Array<{ path: string; sha256: string }>;\n+} {\n+  const hashes: Array<{ path: string; sha256: string }> = [];\n+  const contents = new Map<string, Buffer>();\n+\n+  for (const source of FROZEN_SOURCES) {\n+    const content = readFileSync(resolve(REPO_ROOT, source.path));\n+    const actual = sha256(content);\n+    check(\n+      actual === source.sha256,\n+      `frozen source drift at ${source.path}: expected ${source.sha256}, found ${actual}`,\n+    );\n+    hashes.push({ path: source.path, sha256: actual });\n+    contents.set(source.path, content);\n+  }\n+\n+  const json = (path: string): unknown => {\n+    const content = contents.get(path);\n+    if (content === undefined) throw new Error(`source not pinned: ${path}`);\n+    return JSON.parse(content.toString(\"utf8\")) as unknown;\n+  };\n+\n+  return {\n+    canonical: json(FROZEN_SOURCES[0].path) as CanonicalVectors,\n+    records: json(FROZEN_SOURCES[1].path) as RecordVectors,\n+    snapshots: json(FROZEN_SOURCES[2].path) as SnapshotVectors,\n+    briefTokens: json(BRIEF_TOKEN_VECTORS_PATH) as BriefTokenVectors,\n+    briefs: json(BRIEF_VECTORS_PATH) as BriefVectors,\n+    calibration: json(BRIEF_CALIBRATION_PATH) as BriefCalibrationVectors,\n+    hashes,\n+  };\n+}\n+\n+function qualifyCanonicalVectors(vectors: CanonicalVectors): {\n+  valid: number;\n+  invalid: number;\n+} {\n+  check(\n+    vectors.limits.max_document_bytes === PROFILE_LIMITS.max_document_bytes &&\n+      vectors.limits.max_depth === PROFILE_LIMITS.max_depth &&\n+      vectors.limits.max_string_bytes === PROFILE_LIMITS.max_string_bytes &&\n+      vectors.limits.max_container_entries === PROFILE_LIMITS.max_container_entries &&\n+      vectors.limits.max_safe_integer === PROFILE_LIMITS.max_safe_integer,\n+    \"TypeScript canonical limits differ from the frozen Rust profile\",\n+  );\n+\n+  for (const vector of vectors.valid) {\n+    const input = bytesForInput(vector.input);\n+    const canonical = canonicalizeValue(parseCanonicalJson(input));\n+    if (\"hex\" in vector.canonical) {\n+      check(\n+        canonical.toString(\"hex\") === vector.canonical.hex,\n+        `${vector.name}: canonical bytes differ`,\n+      );\n+    } else {\n+      check(\n+        sha256(canonical) === vector.canonical.sha256,\n+        `${vector.name}: canonical SHA-256 differs`,\n+      );\n+    }\n+    const fixedPoint = canonicalizeValue(parseCanonicalJson(canonical));\n+    check(\n+      fixedPoint.equals(canonical),\n+      `${vector.name}: canonical output is not a fixed point`,\n+    );\n+  }\n+\n+  for (const vector of vectors.invalid) {\n+    const actual = refusalCode(() =>\n+      parseCanonicalJson(bytesForInput(vector.input)),\n+    );\n+    check(\n+      actual === vector.error,\n+      `${vector.name}: expected ${vector.error}, received ${actual ?? \"accept\"}`,\n+    );\n+  }\n+\n+  const requiredInvalid = [\n+    \"duplicate key\",\n+    \"duplicate key after unescaping\",\n+    \"2^53\",\n+    \"-2^53\",\n+    \"beyond i64\",\n+    \"null member\",\n+  ];\n+  for (const name of requiredInvalid) {\n+    check(\n+      vectors.invalid.some((vector) => vector.name === name),\n+      `T01 critical canonical rejection vector missing: ${name}`,\n+    );\n+  }\n+  check(\n+    vectors.valid.some((vector) => vector.name === \"safe integer bounds\"),\n+    \"T01 safe integer positive boundary vector missing\",\n+  );\n+\n+  return { valid: vectors.valid.length, invalid: vectors.invalid.length };\n+}\n+\n+function qualifyRecordVectors(vectors: RecordVectors): {\n+  valid: number;\n+  invalid: number;\n+} {\n+  check(\n+    decodeHex(vectors.domain_hex).equals(Buffer.from(\"aethyme record v0\\0\")),\n+    \"record domain header differs from the frozen Rust profile\",\n+  );\n+\n+  const idForClass = new Map<string, string>();\n+  const classForId = new Map<string, string>();\n+\n+  for (const vector of vectors.valid) {\n+    const schemas = vectors.readers[vector.reader];\n+    check(schemas !== undefined, `${vector.name}: missing reader schema`);\n+    const record = decodeRecord(decodeHex(vector.input.hex), schemas);\n+    check(\n+      record.canonicalBytes.toString(\"hex\") === vector.canonical_hex,\n+      `${vector.name}: canonical record bytes differ`,\n+    );\n+    check(record.id === vector.id, `${vector.name}: record digest differs`);\n+    check(isCanonicalRecordId(vector.id), `${vector.name}: malformed frozen ID`);\n+\n+    for (const [field, expected] of Object.entries(vector.states)) {\n+      const actual = stateReadingText(readState(record, field));\n+      check(\n+        actual === expected,\n+        `${vector.name}: state ${field} expected ${expected}, received ${actual}`,\n+      );\n+    }\n+\n+    const priorId = idForClass.get(vector.equivalence_class);\n+    check(\n+      priorId === undefined || priorId === vector.id,\n+      `${vector.name}: equivalent record encodings have different IDs`,\n+    );\n+    idForClass.set(vector.equivalence_class, vector.id);\n+\n+    const priorClass = classForId.get(vector.id);\n+    check(\n+      priorClass === undefined || priorClass === vector.equivalence_class,\n+      `${vector.name}: distinct record classes share an ID`,\n+    );\n+    classForId.set(vector.id, vector.equivalence_class);\n+\n+    for (const field of Object.keys(vector.states)) {\n+      const reading = readState(record, field);\n+      if (reading.kind !== \"known\") {\n+        for (const positive of [\n+          \"accepted\",\n+          \"captured\",\n+          \"shared\",\n+          \"superseded\",\n+          \"unknown\",\n+        ]) {\n+          check(\n+            !stateMatches(reading, positive),\n+            `${vector.name}: non-known ${field} matched ${positive}`,\n+          );\n+        }\n+      }\n+    }\n+\n+    const uppercaseHex = `sha256:${vector.id.slice(7).toUpperCase()}`;\n+    check(!isCanonicalRecordId(uppercaseHex), \"uppercase record ID was accepted\");\n+  }\n+\n+  for (const vector of vectors.invalid) {\n+    const schemas = vectors.readers[vector.reader];\n+    check(schemas !== undefined, `${vector.name}: missing reader schema`);\n+    const actual = refusalCode(() =>\n+      decodeRecord(decodeHex(vector.input.hex), schemas),\n+    );\n+    check(\n+      actual === vector.error,\n+      `${vector.name}: expected ${vector.error}, received ${actual ?? \"accept\"}`,\n+    );\n+  }\n+\n+  const newReader = vectors.readers.new?.[0];\n+  check(newReader !== undefined, \"new reader schema is missing\");\n+  check(\n+    requiredCapabilities(newReader, [\"schema\", \"subject\", \"sharing\", \"note\"]).join(\n+      \",\",\n+    ) === \"retention-receipt\",\n+    \"record gated field capability calculation differs\",\n+  );\n+  check(\n+    requiredCapabilities(newReader, [\"subject\", \"note\"]).length === 0,\n+    \"ungated record fields added a required capability\",\n+  );\n+\n+  for (const vector of vectors.valid.filter((candidate) => candidate.reader === \"new\")) {\n+    const input = parseCanonicalJson(decodeHex(vector.input.hex));\n+    check(input instanceof Map, `${vector.name}: expected record object`);\n+    const declaredValue = input.get(\"requires\");\n+    const declared = Array.isArray(declaredValue)\n+      ? declaredValue.filter((value): value is string => typeof value === \"string\")\n+      : [];\n+    const present = [\"sharing\", \"note\", \"subject\"].filter((field) =>\n+      input.has(field),\n+    );\n+    for (const capability of requiredCapabilities(newReader, present)) {\n+      check(\n+        declared.includes(capability),\n+        `${vector.name}: missing required capability ${capability}`,\n+      );\n+    }\n+  }\n+\n+  for (const vector of [\n+    \"explicit unknown equals absent\",\n+    \"same record: other order, whitespace, set order, escapes\",\n+    \"set order differs only\",\n+    \"78-digit decimal\",\n+  ]) {\n+    check(\n+      vectors.valid.some((candidate) => candidate.name === vector),\n+      `T01 critical record vector missing: ${vector}`,\n+    );\n+  }\n+  for (const vector of [\n+    \"set repeats a member\",\n+    \"decimal as a JSON integer\",\n+    \"profile violation passes through\",\n+  ]) {\n+    check(\n+      vectors.invalid.some((candidate) => candidate.name === vector),\n+      `T01 critical record rejection vector missing: ${vector}`,\n+    );\n+  }\n+\n+  return { valid: vectors.valid.length, invalid: vectors.invalid.length };\n+}\n+\n+function qualifySnapshotVectors(vectors: SnapshotVectors): {\n+  valid: number;\n+  invalid: number;\n+  unsupportedModes: number;\n+} {\n+  const ids = new Set<string>();\n+\n+  for (const vector of vectors.valid) {\n+    const actual = qualifyValidSnapshot(vector);\n+    check(\n+      actual.manifest.toString(\"hex\") === vector.manifest_hex,\n+      `${vector.name}: source snapshot manifest differs`,\n+    );\n+    check(actual.id === vector.id, `${vector.name}: source snapshot ID differs`);\n+    check(isCanonicalSnapshotId(actual.id), `${vector.name}: malformed snapshot ID`);\n+\n+    const reversed = qualifyValidSnapshot({\n+      ...vector,\n+      entries: [...vector.entries].reverse(),\n+    });\n+    check(\n+      reversed.manifest.equals(actual.manifest) && reversed.id === actual.id,\n+      `${vector.name}: input order changed snapshot identity`,\n+    );\n+    ids.add(actual.id);\n+  }\n+\n+  check(\n+    ids.size === vectors.valid.length,\n+    \"distinct frozen snapshots unexpectedly share an ID\",\n+  );\n+\n+  for (const vector of vectors.invalid) {\n+    const actual = refusalCode(() => qualifyInvalidSnapshot(vector));\n+    check(\n+      actual === vector.error,\n+      `${vector.name}: expected ${vector.error}, received ${actual ?? \"accept\"}`,\n+    );\n+  }\n+\n+  for (const mode of vectors.unsupported_modes) {\n+    check(\n+      refusalCode(() => qualifyUnsupportedMode(mode)) === \"unsupported_mode\",\n+      `unsupported mode was not refused: ${mode}`,\n+    );\n+  }\n+\n+  for (const encoded of vectors.malformed_ids) {\n+    check(\n+      !isCanonicalSnapshotId(encoded),\n+      `malformed source snapshot ID was accepted: ${encoded}`,\n+    );\n+  }\n+  for (const vector of [\n+    \"non-UTF-8 path bytes\",\n+    \"NFC path\",\n+    \"NFD path\",\n+    \"raw byte order: '-' < '.' < '/'\",\n+  ]) {\n+    check(\n+      vectors.valid.some((candidate) => candidate.name === vector),\n+      `source snapshot ordering/byte vector missing: ${vector}`,\n+    );\n+  }\n+\n+  return {\n+    valid: vectors.valid.length,\n+    invalid: vectors.invalid.length,\n+    unsupportedModes: vectors.unsupported_modes.length,\n+  };\n+}\n+\n+\n+function briefProblems(operation: () => unknown): Array<{ path: string; code: string }> | undefined {\n+  try {\n+    operation();\n+    return undefined;\n+  } catch (error) {\n+    if (error instanceof BriefProfileError) return error.problems;\n+    const code = codeFrom(error);\n+    return [{ path: \"\", code: code ?? \"unclassified_exception\" }];\n+  }\n+}\n+\n+function qualifyBriefVectors(\n+  tokenVectors: BriefTokenVectors,\n+  vectors: BriefVectors,\n+  calibration: BriefCalibrationVectors,\n+): {\n+  tokenCases: number;\n+  calibrationCases: number;\n+  validDecisionFiles: number;\n+  invalidDecisionFiles: number;\n+  validRecords: number;\n+  invalidRecords: number;\n+} {\n+  check(tokenVectors.profile === BRIEF_TOKEN_PROFILE, \"token fixture profile differs\");\n+  check(vectors.profile === BRIEF_TOKEN_PROFILE, \"brief fixture profile differs\");\n+  check(vectors.schema === BRIEF_SCHEMA_NAME, \"brief fixture schema differs\");\n+  check(calibration.reference === \"o200k_base\", \"calibration reference changed\");\n+  check(\n+    vectors.limits.max_tokens === BRIEF_LIMITS.max_tokens &&\n+      vectors.limits.max_prose_bytes === BRIEF_LIMITS.max_prose_bytes &&\n+      vectors.limits.max_list_entries === BRIEF_LIMITS.max_list_entries &&\n+      vectors.limits.max_scope_ref_bytes === BRIEF_LIMITS.max_scope_ref_bytes &&\n+      vectors.limits.max_record_bytes === BRIEF_LIMITS.max_record_bytes,\n+    \"TypeScript brief limits differ from the frozen profile\",\n+  );\n+\n+  for (const vector of tokenVectors.cases) {\n+    check(\n+      countBriefTokens(vector.text) === vector.tokens,\n+      \"brief token count differs for \" + JSON.stringify(vector.text),\n+    );\n+  }\n+  for (const vector of calibration.cases) {\n+    check(\n+      countBriefTokens(vector.text) >= vector.reference_tokens,\n+      \"brief profile is below its frozen calibration count for \" +\n+        JSON.stringify(vector.text),\n+    );\n+  }\n+\n+  const idForClass = new Map<string, string>();\n+  const classForId = new Map<string, string>();\n+  for (const vector of vectors.valid) {\n+    const input = decodeHex(vector.input.hex);\n+    const brief = validateBriefDecisionFile(input);\n+    const count = briefText(brief).reduce(\n+      (total, value) => total + countBriefTokens(value),\n+      0,\n+    );\n+    check(count === vector.tokens, vector.name + \": token count differs\");\n+    const record = makeBriefRecord(brief);\n+    check(\n+      record.canonicalBytes.toString(\"hex\") === vector.record_hex,\n+      vector.name + \": canonical brief record differs\",\n+    );\n+    check(record.id === vector.id, vector.name + \": brief record ID differs\");\n+\n+    const readBack = validateBriefRecord(record.canonicalBytes);\n+    check(\n+      JSON.stringify(readBack.brief) === JSON.stringify(brief),\n+      vector.name + \": brief record round trip differs\",\n+    );\n+    check(readBack.record.id === vector.id, vector.name + \": round-trip ID differs\");\n+\n+    const priorId = idForClass.get(vector.equivalence_class);\n+    check(\n+      priorId === undefined || priorId === vector.id,\n+      vector.name + \": equivalent briefs have different IDs\",\n+    );\n+    idForClass.set(vector.equivalence_class, vector.id);\n+    const priorClass = classForId.get(vector.id);\n+    check(\n+      priorClass === undefined || priorClass === vector.equivalence_class,\n+      vector.name + \": distinct brief classes share an ID\",\n+    );\n+    classForId.set(vector.id, vector.equivalence_class);\n+  }\n+\n+  const compareProblems = (\n+    name: string,\n+    operation: () => unknown,\n+    expected: Array<[string, string]>,\n+  ): void => {\n+    const actual = briefProblems(operation);\n+    check(actual !== undefined, name + \": invalid brief was accepted\");\n+    const actualPairs = actual.map((item) => [item.path, item.code]);\n+    check(\n+      JSON.stringify(actualPairs) === JSON.stringify(expected),\n+      name + \": expected \" + JSON.stringify(expected) + \", received \" +\n+        JSON.stringify(actualPairs),\n+    );\n+  };\n+\n+  for (const vector of vectors.invalid_decision_files) {\n+    compareProblems(\n+      vector.name,\n+      () => validateBriefDecisionFile(decodeHex(vector.input.hex)),\n+      vector.errors,\n+    );\n+  }\n+\n+  for (const vector of vectors.valid_records) {\n+    const result = validateBriefRecord(decodeHex(vector.input.hex));\n+    check(result.record.id === vector.id, vector.name + \": carried record ID differs\");\n+  }\n+  for (const vector of vectors.invalid_records) {\n+    compareProblems(\n+      vector.name,\n+      () => validateBriefRecord(decodeHex(vector.input.hex)),\n+      vector.errors,\n+    );\n+  }\n+\n+  const validNames = new Set(vectors.valid.map((vector) => vector.name));\n+  const invalidDecisionNames = new Set(\n+    vectors.invalid_decision_files.map((vector) => vector.name),\n+  );\n+  const invalidRecordNames = new Set(vectors.invalid_records.map((vector) => vector.name));\n+  for (const name of [\n+    \"149 tokens\",\n+    \"150 tokens\",\n+    \"multilingual\",\n+    \"same brief, other key order and escapes\",\n+  ]) {\n+    check(validNames.has(name), \"T02 critical valid brief vector missing: \" + name);\n+  }\n+  for (const name of [\"151 tokens\", \"all shape problems reported together\"]) {\n+    check(\n+      invalidDecisionNames.has(name),\n+      \"T02 critical invalid decision-file vector missing: \" + name,\n+    );\n+  }\n+  for (const name of [\n+    \"other token profile\",\n+    \"hidden metadata makes the record too large\",\n+    \"record over the token budget\",\n+  ]) {\n+    check(\n+      invalidRecordNames.has(name),\n+      \"T02 critical invalid record vector missing: \" + name,\n+    );\n+  }\n+  check(\n+    vectors.valid_records.some((vector) =>\n+      vector.name.includes(\"newer writer carries an unknown member\"),\n+    ),\n+    \"T02 unknown future metadata vector missing\",\n+  );\n+  check(\n+    tokenVectors.cases.some((vector) => vector.text.includes(\"🚀\")) &&\n+      tokenVectors.cases.some((vector) => vector.text.includes(\"保持\")) &&\n+      tokenVectors.cases.some((vector) => vector.text.includes(\"שלום\")),\n+    \"T02 multilingual token vectors missing\",\n+  );\n+  check(\n+    tokenVectors.cases.length === 30 && calibration.cases.length === 27,\n+    \"T02 token or calibration vector count differs from the frozen corpus\",\n+  );\n+\n+  return {\n+    tokenCases: tokenVectors.cases.length,\n+    calibrationCases: calibration.cases.length,\n+    validDecisionFiles: vectors.valid.length,\n+    invalidDecisionFiles: vectors.invalid_decision_files.length,\n+    validRecords: vectors.valid_records.length,\n+    invalidRecords: vectors.invalid_records.length,\n+  };\n+}\n+\n+function briefText(brief: Brief): string[] {\n+  return [\n+    brief.intent,\n+    ...brief.decisions.flatMap((decision) => [\n+      decision.scope_ref,\n+      decision.choice,\n+      decision.reason,\n+    ]),\n+    ...brief.preserves,\n+    ...brief.assumptions,\n+    ...brief.deferred,\n+  ];\n+}\n+\n+function currentTypeScriptSources(): Array<{ path: string; sha256: string }> {\n+  return TYPESCRIPT_SOURCES.map((path) => ({\n+    path: \"packages/aethyme-eval/local-v3/t01-canonical-parity/\" + path,\n+    sha256: sha256(readFileSync(resolve(HERE, path))),\n+  }));\n+}\n+\n+function run(): void {\n+  const frozen = readFrozenSources();\n+  const canonical = qualifyCanonicalVectors(frozen.canonical);\n+  const records = qualifyRecordVectors(frozen.records);\n+  const snapshots = qualifySnapshotVectors(frozen.snapshots);\n+  const briefs = qualifyBriefVectors(\n+    frozen.briefTokens,\n+    frozen.briefs,\n+    frozen.calibration,\n+  );\n+\n+  console.log(\n+    JSON.stringify(\n+      {\n+        schema: \"aethyme.local-v3.t01-t02-typescript-parity.v1\",\n+        status: \"pass\",\n+        runtime: process.version,\n+        referenceCommit: REFERENCE_COMMIT,\n+        assertions: assertionCount,\n+        vectors: { canonicalJson: canonical, records, sourceSnapshots: snapshots, briefs },\n+        frozenSources: frozen.hashes,\n+        typescriptSources: currentTypeScriptSources(),\n+      },\n+      null,\n+      2,\n+    ),\n+  );\n+}\n+\n+run();"}]}