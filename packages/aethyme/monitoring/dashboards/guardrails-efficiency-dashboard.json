{
  "dashboard": {
    "title": "Aethyme Guardrails & Efficiency",
    "tags": ["aethyme", "guardrails", "efficiency", "ai-ops"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "graph",
        "title": "Token Usage by Model",
        "targets": [
          {
            "expr": "rate(aethyme_tokens_total[5m])",
            "legendFormat": "{{model_id}} - {{operation_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "Tokens/sec", "format": "short"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "graph",
        "title": "Cost by Tenant",
        "targets": [
          {
            "expr": "rate(aethyme_cost_total[5m])",
            "legendFormat": "{{tenant_id}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "USD/sec", "format": "currencyUSD"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
        "type": "stat",
        "title": "Violations Prevented (24h)",
        "targets": [
          {
            "expr": "sum(increase(aethyme_violations_prevented[24h]))",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
        "type": "stat",
        "title": "Model Escalations (24h)",
        "targets": [
          {
            "expr": "sum(increase(aethyme_model_escalations[24h]))",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
        "type": "stat",
        "title": "Total Cost (24h)",
        "targets": [
          {
            "expr": "sum(increase(aethyme_cost_total[24h]))",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
          "colorMode": "value",
          "unit": "currencyUSD"
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "type": "heatmap",
        "title": "Context Size Distribution",
        "targets": [
          {
            "expr": "rate(aethyme_context_size_bytes_bucket[5m])",
            "format": "heatmap",
            "refId": "A"
          }
        ],
        "yAxis": {"format": "bytes"}
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "type": "graph",
        "title": "Compaction Ratio",
        "targets": [
          {
            "expr": "histogram_quantile(0.5, rate(aethyme_context_compaction_ratio_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(aethyme_context_compaction_ratio_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"label": "Ratio", "format": "percentunit", "max": 1},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "type": "graph",
        "title": "Model Requests by Tier",
        "targets": [
          {
            "expr": "rate(aethyme_model_requests[5m])",
            "legendFormat": "{{tier}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "Requests/sec", "format": "short"},
          {"format": "short"}
        ]
      },
      {
        "id": 9,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "type": "graph",
        "title": "Preflight Check Results",
        "targets": [
          {
            "expr": "rate(aethyme_preflight_checks{result=\"passed\"}[5m])",
            "legendFormat": "Passed",
            "refId": "A"
          },
          {
            "expr": "rate(aethyme_preflight_checks{result=\"failed\"}[5m])",
            "legendFormat": "Failed",
            "refId": "B"
          },
          {
            "expr": "rate(aethyme_preflight_checks{result=\"blocked\"}[5m])",
            "legendFormat": "Blocked",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"label": "Checks/sec", "format": "short"},
          {"format": "short"}
        ]
      },
      {
        "id": 10,
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 32},
        "type": "gauge",
        "title": "Budget Utilization",
        "targets": [
          {
            "expr": "aethyme_budget_utilization",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.8, "color": "yellow"},
                {"value": 0.95, "color": "red"}
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 11,
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 32},
        "type": "gauge",
        "title": "Working Memory Utilization",
        "targets": [
          {
            "expr": "avg(aethyme_working_memory_utilization)",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {"values": false, "calcs": ["lastNotNull"]}
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.7, "color": "yellow"},
                {"value": 0.9, "color": "red"}
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 12,
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 32},
        "type": "graph",
        "title": "Operation Duration (p95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(aethyme_operation_duration_seconds_bucket[5m]))",
            "legendFormat": "{{operation_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "Duration", "format": "s"},
          {"format": "short"}
        ]
      },
      {
        "id": 13,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
        "type": "table",
        "title": "Violations by Rule",
        "targets": [
          {
            "expr": "topk(10, sum by (rule_id, risk_level) (increase(aethyme_violations_prevented[24h])))",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true},
              "indexByName": {},
              "renameByName": {
                "rule_id": "Rule",
                "risk_level": "Risk Level",
                "Value": "Count"
              }
            }
          }
        ]
      },
      {
        "id": 14,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
        "type": "table",
        "title": "Cost by Model (24h)",
        "targets": [
          {
            "expr": "topk(10, sum by (model_id, tenant_id) (increase(aethyme_cost_total[24h])))",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true},
              "renameByName": {
                "model_id": "Model",
                "tenant_id": "Tenant",
                "Value": "Cost (USD)"
              }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "displayMode": "color-background"
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Cost (USD)"},
              "properties": [
                {"id": "unit", "value": "currencyUSD"}
              ]
            }
          ]
        }
      },
      {
        "id": 15,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
        "type": "graph",
        "title": "Guardrail Check Duration",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(aethyme_guardrail_check_duration_seconds_bucket[5m]))",
            "legendFormat": "{{check_type}} p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(aethyme_guardrail_check_duration_seconds_bucket[5m]))",
            "legendFormat": "{{check_type}} p50",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"label": "Duration", "format": "s", "max": 1},
          {"format": "short"}
        ],
        "alert": {
          "name": "Slow Guardrail Checks",
          "message": "Guardrail checks are taking longer than expected",
          "conditions": [
            {
              "evaluator": {"params": [0.05], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ]
        }
      },
      {
        "id": 16,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48},
        "type": "graph",
        "title": "Model Failures",
        "targets": [
          {
            "expr": "rate(aethyme_model_failures[5m])",
            "legendFormat": "{{model_id}} - {{error_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "Failures/sec", "format": "short"},
          {"format": "short"}
        ],
        "alert": {
          "name": "High Model Failure Rate",
          "message": "Model failure rate is elevated",
          "conditions": [
            {
              "evaluator": {"params": [0.1], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ]
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "tenant_id",
          "type": "query",
          "label": "Tenant",
          "query": "label_values(aethyme_tokens_total, tenant_id)",
          "refresh": 1,
          "multi": true,
          "includeAll": true
        },
        {
          "name": "model_id",
          "type": "query",
          "label": "Model",
          "query": "label_values(aethyme_tokens_total, model_id)",
          "refresh": 1,
          "multi": true,
          "includeAll": true
        },
        {
          "name": "operation_type",
          "type": "query",
          "label": "Operation Type",
          "query": "label_values(aethyme_tokens_total, operation_type)",
          "refresh": 1,
          "multi": true,
          "includeAll": true
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Budget Exceeded",
          "datasource": "Prometheus",
          "expr": "ALERTS{alertname=\"BudgetExceeded\"}",
          "step": "60s",
          "tagKeys": "tenant_id,budget_id",
          "titleFormat": "Budget Exceeded",
          "textFormat": "{{tenant_id}} exceeded {{budget_id}}"
        }
      ]
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    }
  }
}
