{
  "schema": "aethyme.composition-requirements/provisional-v0",
  "case": "FX02",
  "scenarios": {
    "move-and-edit": [
      { "check": "inside", "file": "app.html", "selector": "#card-news", "ancestor": "#pinned" },
      { "check": "not_inside", "file": "app.html", "selector": "#card-news", "ancestor": "#content" },
      { "check": "attr", "file": "app.html", "selector": "#card-news button", "name": "onkeydown", "equals": "openOnEnter(event)" },
      { "check": "attr", "file": "app.html", "selector": "#card-news button", "name": "aria-label", "equals": "More news" },
      { "check": "inside", "file": "app.html", "selector": "#card-events", "ancestor": "#content" },
      { "check": "attr_absent", "file": "app.html", "selector": "#card-events button", "name": "onkeydown" },
      { "check": "attr_absent", "file": "app.html", "selector": "#card-events button", "name": "aria-label" },
      { "check": "count", "file": "app.html", "selector": "article.card", "equals": 2 }
    ],
    "identical-twins": [
      { "check": "count", "file": "app.html", "selector": "#pinned article.card", "equals": 1 },
      { "check": "count", "file": "app.html", "selector": "#content article.card", "equals": 1 },
      { "check": "attr", "file": "app.html", "selector": "#pinned button", "name": "onkeydown", "equals": "openOnEnter(event)" },
      { "check": "attr_absent", "file": "app.html", "selector": "#content button", "name": "onkeydown" }
    ]
  }
}
