# syntax=docker/dockerfile:1.19
FROM node:24-slim

# OCI Image Labels
LABEL org.opencontainers.image.title="Aethyme Cloud Web (Development)"
LABEL org.opencontainers.image.description="Next.js web application for Aethyme Cloud - Development environment with hot reload"
LABEL org.opencontainers.image.vendor="Aethyme contributors"
LABEL org.opencontainers.image.version="1.0.0"

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy package files
COPY --link package.json pnpm-lock.yaml* ./

# Install dependencies with cache mount
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copy application code
COPY --link . .

# Change ownership to node user
RUN chown -R node:node /app

# Switch to non-root user
USER node

# Expose port
EXPOSE 3000

# Development server
CMD ["pnpm", "dev"]
