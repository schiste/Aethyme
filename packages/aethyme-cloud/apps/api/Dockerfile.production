# syntax=docker/dockerfile:1.19
# ==============================================================================
# Aethyme Cloud API - Production Dockerfile
# Multi-stage build for optimized image size
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Builder - Install dependencies
# ------------------------------------------------------------------------------
FROM python:3.12-slim as builder

# Set build arguments
ARG BUILDPLATFORM
ARG TARGETPLATFORM

# Install build dependencies
RUN <<'EOF'
# Structured logging helper
log_json() {
  local stage=$1
  local step=$2
  local status=$3
  echo "{\"timestamp\":$(date +%s),\"stage\":\"$stage\",\"step\":\"$step\",\"status\":\"$status\"}"
}

log_json "builder" "install-build-deps" "started"
apt-get update
apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    git
rm -rf /var/lib/apt/lists/*
log_json "builder" "install-build-deps" "completed"
EOF

# Set working directory
WORKDIR /build

# Copy requirements
COPY --link requirements.production.txt .

# Install Python dependencies to /install directory with cache mount
RUN --mount=type=cache,target=/root/.cache/pip <<'EOF'
# Structured logging helper
log_json() {
  local stage=$1
  local step=$2
  local status=$3
  echo "{\"timestamp\":$(date +%s),\"stage\":\"$stage\",\"step\":\"$step\",\"status\":\"$status\"}"
}

log_json "builder" "install-python-deps" "started"
pip install --upgrade pip==25.3 setuptools==80.9.0 wheel==0.45.1
pip install --prefix=/install -r requirements.production.txt
log_json "builder" "install-python-deps" "completed"
EOF

# ------------------------------------------------------------------------------
# Stage 2: Runtime - Minimal production image
# ------------------------------------------------------------------------------
FROM python:3.12-slim

# Build metadata arguments
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
ARG CI_COMMIT_SHA
ARG CI_PIPELINE_ID

# Set labels
LABEL maintainer="Aethyme Team <engineering@aethyme.com>" \
      description="Aethyme Cloud API - Enterprise Code Intelligence Platform" \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.revision=$VCS_REF \
      org.opencontainers.image.version=$VERSION \
      build.ci.commit=$CI_COMMIT_SHA \
      build.ci.pipeline=$CI_PIPELINE_ID

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ENVIRONMENT=production \
    LOG_LEVEL=INFO

# Install runtime dependencies only
RUN <<'EOF'
# Structured logging helper
log_json() {
  local stage=$1
  local step=$2
  local status=$3
  echo "{\"timestamp\":$(date +%s),\"stage\":\"$stage\",\"step\":\"$step\",\"status\":\"$status\"}"
}

log_json "runtime" "install-runtime-deps" "started"
apt-get update
apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ca-certificates
rm -rf /var/lib/apt/lists/*
log_json "runtime" "install-runtime-deps" "completed"
EOF

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser -s /usr/sbin/nologin appuser

# Set working directory
WORKDIR /app

# Copy installed packages from builder
COPY --link --from=builder /install /usr/local

# Copy application code
COPY --link --chown=appuser:appuser app/ /app/app/
COPY --link --chown=appuser:appuser alembic/ /app/alembic/
COPY --link --chown=appuser:appuser alembic.ini /app/

# Create directories for logs and temp files
# Create only the writable directories with correct ownership (avoid recursive chown)
RUN install -d -o appuser -g appuser /app/logs /app/tmp

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start application with production settings
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--loop", "uvloop", \
     "--http", "httptools", \
     "--timeout-keep-alive", "5", \
     "--limit-concurrency", "1000", \
     "--no-access-log"]
