{
  "name": "@aethyme-cloud/api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Aethyme Cloud API - FastAPI Backend",
  "scripts": {
    "dev": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test": "pytest tests/ -v --cov=app --cov-report=html",
    "lint": "ruff check app/",
    "format": "black app/ tests/",
    "typecheck": "pyright app/",
    "db:migrate": "alembic upgrade head",
    "db:rollback": "alembic downgrade -1",
    "db:reset": "alembic downgrade base && alembic upgrade head",
    "db:seed": "python -m app.scripts.seed"
  }
}
