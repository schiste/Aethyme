# syntax=docker/dockerfile:1.19
# ==============================================================================
# Aethyme Cloud API - Distroless Production Dockerfile
# Minimal attack surface with Google's Distroless base image
# ==============================================================================
#
# BENEFITS:
# - No shell → Prevents shell-based attacks and remote code execution via shell
# - No package manager → Cannot install malicious packages at runtime
# - Minimal dependencies → ~80% smaller than slim images, faster pulls/deployments
# - Runs as nonroot user by default (UID 65532) → Enhanced security
# - Only contains Python runtime and app dependencies → Minimal attack surface
#
# LIMITATIONS:
# - No shell access → Cannot kubectl/docker exec for debugging
# - Cannot install packages at runtime → All dependencies must be at build time
# - Limited debugging → Use logs, metrics, and external debugging tools
# - See /docs/docker/DISTROLESS.md for debugging strategies
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Builder - Install dependencies (same as regular production)
# ------------------------------------------------------------------------------
FROM python:3.12-slim as builder

# Set build arguments
ARG BUILDPLATFORM
ARG TARGETPLATFORM

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy requirements
COPY --link requirements.production.txt .

# Install Python dependencies to /install directory with cache mount
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip==25.3 setuptools==80.9.0 wheel==0.45.1 && \
    pip install --prefix=/install -r requirements.production.txt

# Copy application code for any build-time processing
COPY --link app/ /app/app/
COPY --link alembic/ /app/alembic/
COPY --link alembic.ini /app/

# ------------------------------------------------------------------------------
# Stage 2: Distroless Runtime - Minimal production image
# ------------------------------------------------------------------------------
FROM gcr.io/distroless/python3-debian12:nonroot

# Set labels
LABEL maintainer="Aethyme Team <engineering@aethyme.com>"
LABEL version="1.0.0-distroless"
LABEL description="Aethyme Cloud API - Distroless (Minimal Attack Surface)"
LABEL org.opencontainers.image.title="Aethyme Cloud API (Distroless)"
LABEL org.opencontainers.image.description="Enterprise Code Intelligence Platform - Hardened Distroless Image"
LABEL org.opencontainers.image.vendor="Aethyme"
LABEL org.opencontainers.image.source="https://github.com/aethyme/cloud"

# Set environment variables
# Note: Distroless images use env vars for Python configuration
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ENVIRONMENT=production \
    LOG_LEVEL=INFO

# Set working directory
WORKDIR /app

# Copy installed packages from builder
# Distroless Python expects packages in /usr/local
COPY --link --from=builder /install /usr/local

# Copy application code
# Distroless nonroot user has UID 65532, files owned by this user
COPY --link --from=builder /app /app

# Already runs as nonroot user (UID 65532, GID 65532)
# No need to create user or switch - distroless:nonroot handles this

# Expose port
EXPOSE 8000

# Note: No HEALTHCHECK - distroless has no shell, no curl
# Use Kubernetes livenessProbe with httpGet instead:
#   livenessProbe:
#     httpGet:
#       path: /health
#       port: 8000

# Start application with production settings
# Distroless sets ENTRYPOINT to ["/usr/bin/python3"] so we use CMD
# Cannot use shell form due to no shell - must use exec form
CMD ["python3", "-m", "uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--loop", "uvloop", \
     "--http", "httptools", \
     "--timeout-keep-alive", "5", \
     "--limit-concurrency", "1000", \
     "--no-access-log"]

# ==============================================================================
# BUILD INSTRUCTIONS:
# docker build -f Dockerfile.distroless -t aethyme-cloud-api:distroless .
#
# RUN INSTRUCTIONS:
# docker run -p 8000:8000 aethyme-cloud-api:distroless
#
# SIZE COMPARISON:
# Regular (python:3.12-slim): ~150-200MB
# Distroless: ~50-80MB (60-80% reduction)
# ==============================================================================
