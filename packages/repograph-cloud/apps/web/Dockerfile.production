# syntax=docker/dockerfile:1.19

# ==========================================
# Base Stage - Common dependencies
# ==========================================
FROM node:24-slim AS base

# Install pnpm globally
RUN echo "===> [$(date +%s)] Installing pnpm globally" && \
    npm install -g pnpm && \
    echo "===> [$(date +%s)] Finished pnpm installation"

WORKDIR /app

# ==========================================
# Dependencies Stage - Install all dependencies
# ==========================================
FROM base AS deps

# Copy package files
COPY --link package.json pnpm-lock.yaml* ./

# Install dependencies with cache mount
RUN echo "===> [$(date +%s)] Installing dependencies" && \
    --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile && \
    echo "===> [$(date +%s)] Finished dependencies installation"

# ==========================================
# Builder Stage - Build the application
# ==========================================
FROM base AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --link --from=deps /app/node_modules ./node_modules

# Copy application source
COPY --link . .

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Build Next.js application with standalone output
RUN echo "===> [$(date +%s)] Building Next.js application" && \
    pnpm build && \
    echo "===> [$(date +%s)] Finished Next.js build"

# ==========================================
# Production Stage - Run the application
# ==========================================
FROM node:24-slim AS production

# Build metadata arguments
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0
ARG CI_COMMIT_SHA
ARG CI_PIPELINE_ID

# OCI Image Labels
LABEL org.opencontainers.image.title="RepoGraph Cloud Web" \
      org.opencontainers.image.description="Next.js web application for RepoGraph Cloud - Production-optimized with standalone output" \
      org.opencontainers.image.vendor="Aeptus" \
      org.opencontainers.image.source="https://github.com/Aeptus/mockup" \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.revision=$VCS_REF \
      org.opencontainers.image.version=$VERSION \
      build.ci.commit=$CI_COMMIT_SHA \
      build.ci.pipeline=$CI_PIPELINE_ID

WORKDIR /app

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create node user directory structure
RUN mkdir -p /app/.next && \
    chown -R node:node /app

# Copy necessary files from builder
COPY --link --from=builder --chown=node:node /app/public ./public
COPY --link --from=builder --chown=node:node /app/.next/standalone ./
COPY --link --from=builder --chown=node:node /app/.next/static ./.next/static

# Switch to non-root user
USER node

# Expose application port
EXPOSE 3000

# Set hostname to listen on all interfaces
ENV HOSTNAME="0.0.0.0"
ENV PORT=3000

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})" || exit 1

# Start the application
CMD ["node", "server.js"]
